import { NextResponse } from "next/server";
import { prisma } from "../../../../../../lib/prisma";
import { getAuthPayload } from "../../../../../../lib/auth";
import { createReviewSchema } from "../../../../../../lib/validation/review";

type Context = { params: Promise<{ id: string }> };

function parseId(raw: string): number | null {
  const id = Number(raw);
  return Number.isInteger(id) && id > 0 ? id : null;
}

// Lấy customerId từ token; null nếu chưa đăng nhập hoặc không phải Customer
async function getCustomerId(): Promise<number | null> {
  const payload = await getAuthPayload();
  if (!payload || payload.role !== "customer") return null;
  return Number(payload.id); // <-- xem ghi chú bên dưới
}

// Khách có đơn completed chứa sản phẩm này không?
async function hasPurchased(customerId: number, productId: number) {
  const item = await prisma.orderItem.findFirst({
    where: {
      productId,
      order: { customerId, status: "completed" },
    },
    select: { id: true },
  });
  return item !== null;
}

// GET: tình trạng review của khách hiện tại với sản phẩm này
export async function GET(_request: Request, { params }: Context) {
  try {
    const productId = parseId((await params).id);
    if (!productId) {
      return NextResponse.json(
        { success: false, message: "Mã sản phẩm không hợp lệ" },
        { status: 400 },
      );
    }

    const customerId = await getCustomerId();
    if (!customerId) {
      return NextResponse.json({
        success: true,
        data: { loggedIn: false, canReview: false, hasReviewed: false },
      });
    }

    const [purchased, existing] = await Promise.all([
      hasPurchased(customerId, productId),
      prisma.review.findUnique({
        where: { productId_customerId: { productId, customerId } },
        select: { id: true, status: true },
      }),
    ]);

    return NextResponse.json({
      success: true,
      data: {
        loggedIn: true,
        canReview: purchased && !existing,
        hasReviewed: existing !== null,
        reviewStatus: existing?.status ?? null,
      },
    });
  } catch (error) {
    console.error("GET /api/products/[id]/reviews lỗi:", error);
    return NextResponse.json(
      { success: false, message: "Không thể kiểm tra quyền đánh giá" },
      { status: 500 },
    );
  }
}

// POST: viết review
export async function POST(request: Request, { params }: Context) {
  try {
    const customerId = await getCustomerId();
    if (!customerId) {
      return NextResponse.json(
        { success: false, message: "Bạn cần đăng nhập để đánh giá" },
        { status: 401 },
      );
    }

    const productId = parseId((await params).id);
    if (!productId) {
      return NextResponse.json(
        { success: false, message: "Mã sản phẩm không hợp lệ" },
        { status: 400 },
      );
    }

    let body: unknown;
    try {
      body = await request.json();
    } catch {
      return NextResponse.json(
        { success: false, message: "Dữ liệu gửi lên không hợp lệ" },
        { status: 400 },
      );
    }

    const parsed = createReviewSchema.safeParse(body);
    if (!parsed.success) {
      return NextResponse.json(
        { success: false, message: parsed.error.issues[0].message },
        { status: 400 },
      );
    }

    const product = await prisma.product.findFirst({
      where: { id: productId, isActive: true },
      select: { id: true },
    });
    if (!product) {
      return NextResponse.json(
        { success: false, message: "Không tìm thấy sản phẩm" },
        { status: 404 },
      );
    }

    if (!(await hasPurchased(customerId, productId))) {
      return NextResponse.json(
        {
          success: false,
          message:
            "Bạn chỉ có thể đánh giá sản phẩm đã mua và đơn hàng đã hoàn thành",
        },
        { status: 403 },
      );
    }

    try {
      const review = await prisma.review.create({
        data: {
          productId,
          customerId,
          rating: parsed.data.rating,
          comment: parsed.data.comment ?? null,
          status: "pending",
        },
      });
      return NextResponse.json(
        { success: true, data: review },
        { status: 201 },
      );
    } catch (e) {
      // P2002 = vi phạm UNIQUE(productId, customerId): đã đánh giá rồi
      if (
        typeof e === "object" &&
        e !== null &&
        "code" in e &&
        (e as { code?: string }).code === "P2002"
      ) {
        return NextResponse.json(
          { success: false, message: "Bạn đã đánh giá sản phẩm này rồi" },
          { status: 409 },
        );
      }
      throw e;
    }
  } catch (error) {
    console.error("POST /api/products/[id]/reviews lỗi:", error);
    return NextResponse.json(
      { success: false, message: "Không thể gửi đánh giá" },
      { status: 500 },
    );
  }
}
</file>

<file path="src/app/api/admin/orders/[id]/payment/route.ts">
import { NextRequest, NextResponse } from "next/server";
import { prisma } from "../../../../../../../lib/prisma";
import { getAuthPayload } from "../../../../../../../lib/auth";
import { cancelExpiredBankOrders } from "../../../../../../../lib/expire-orders"; // MỚI
import { logAudit } from "../../../../../../../lib/audit";

class PaymentError extends Error {
  status: number;
  constructor(message: string, status = 400) {
    super(message);
    this.status = status;
  }
}

// Admin xác nhận đã nhận được tiền chuyển khoản của một đơn
export async function PATCH(
  _request: NextRequest,
  { params }: { params: Promise<{ id: string }> },
) {
  try {
    // 1. Chỉ Admin được xác nhận thanh toán
    const payload = await getAuthPayload();
    if (!payload || payload.role !== "admin") {
      return NextResponse.json(
        { success: false, message: "Bạn không có quyền truy cập" },
        { status: 401 },
      );
    }
    // Lấy username Admin để ghi nhật ký (giống file orders/[id]/route.ts)
    const admin = await prisma.admin.findUnique({
      where: { id: payload.id },
      select: { username: true },
    });
    if (!admin) {
      return NextResponse.json(
        { success: false, message: "Bạn không có quyền truy cập" },
        { status: 401 },
      );
    }
    // 2. Kiểm tra id trên URL
    const { id } = await params;
    const orderId = Number(id);
    if (!Number.isInteger(orderId) || orderId <= 0) {
      return NextResponse.json(
        { success: false, message: "Mã đơn hàng không hợp lệ" },
        { status: 400 },
      );
    }

    // MỚI: hủy các đơn chuyển khoản quá hạn trước, để một đơn đã quá hạn
    // rơi vào nhánh "đã bị hủy" bên dưới thay vì được xác nhận nhầm
    await cancelExpiredBankOrders().catch((e) =>
      console.error("cancelExpiredBankOrders (PATCH payment):", e),
    );

    // 3. Kiểm tra điều kiện và ghi nhận trong cùng một transaction
    const updated = await prisma.$transaction(async (tx) => {
      const order = await tx.order.findUnique({ where: { id: orderId } });
      if (!order) {
        throw new PaymentError("Không tìm thấy đơn hàng", 404);
      }
      if (order.paymentMethod !== "bank_transfer") {
        throw new PaymentError("Đơn này không thanh toán bằng chuyển khoản");
      }
      if (order.status === "cancelled") {
        throw new PaymentError(
          "Đơn hàng đã bị hủy (hoặc quá hạn chuyển khoản), không thể xác nhận thanh toán",
        );
      }
      if (order.isPaid) {
        throw new PaymentError("Đơn này đã được xác nhận thanh toán rồi", 409);
      }

      // Điều kiện isPaid = false ngay trong câu update: nếu có Admin khác vừa
      // xác nhận trước thì count = 0, tránh ghi đè giờ nhận tiền
      const result = await tx.order.updateMany({
        where: { id: orderId, isPaid: false },
        data: { isPaid: true, paidAt: new Date() },
      });
      if (result.count === 0) {
        throw new PaymentError(
          "Đơn hàng vừa được cập nhật bởi người khác, vui lòng tải lại",
          409,
        );
      }

      await logAudit(
        tx,
        { id: payload.id, username: admin.username },
        {
          action: "order.payment",
          entityType: "order",
          entityId: orderId,
          summary: `Xác nhận đã nhận tiền chuyển khoản đơn #${orderId}`,
        },
      );

      return tx.order.findUnique({
        where: { id: orderId },
        include: { orderItems: { include: { product: true } } },
      });
    });

    return NextResponse.json({ success: true, data: updated });
  } catch (error) {
    if (error instanceof PaymentError) {
      return NextResponse.json(
        { success: false, message: error.message },
        { status: error.status },
      );
    }
    console.error("PATCH /api/admin/orders/[id]/payment error:", error);
    return NextResponse.json(
      { success: false, message: "Có lỗi xảy ra, vui lòng thử lại" },
      { status: 500 },
    );
  }
}
