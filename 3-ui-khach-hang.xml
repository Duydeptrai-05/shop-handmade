// VOUCHER KHÁCH: danh sách vé voucher, bấm một vé để điền mã vào đúng ô, bấm lần nữa để bỏ
function VoucherTickets({
  list,
  subtotal,
  discountCode,
  shippingCode,
  onPick,
}: {
  list: VoucherItem[];
  subtotal: number;
  discountCode: string;
  shippingCode: string;
  onPick: (v: VoucherItem) => void;
}) {
  if (list.length === 0) return null;

  return (
    <div className="mb-6 space-y-5">
      <p className="text-xs font-semibold uppercase tracking-wider text-moss-dark">
        Voucher đang có cho bạn
      </p>

      {(["discount", "shipping"] as const).map((slot) => {
        const group = list.filter((v) => v.type === slot);
        if (group.length === 0) return null;
        const current = (slot === "discount" ? discountCode : shippingCode)
          .trim()
          .toUpperCase();

        return (
          <div key={slot}>
            <p className="mb-2 text-sm font-medium text-ink/70">
              {slot === "discount" ? "Giảm tiền hàng" : "Giảm phí ship"}
            </p>
            <div className="space-y-2.5">
              {group.map((v) => {
                const reason = v.usedByMe
                  ? "Bạn đã dùng mã này"
                  : v.soldOut
                    ? "Đã hết lượt sử dụng"
                    : subtotal < v.minOrderValue
                      ? `Mua thêm ${formatVND(v.minOrderValue - subtotal)} để dùng`
                      : null;
                const selected = current === v.code;
                const notes = voucherNotes(v);

                return (
                  <button
                    key={v.id}
                    type="button"
                    disabled={!!reason}
                    onClick={() => onPick(v)}
                    aria-pressed={selected}
                    className={`flex w-full overflow-hidden rounded-xl border-2 bg-white text-left transition ${
                      selected
                        ? "border-moss"
                        : "border-ink/10 hover:border-peach"
                    } ${reason ? "cursor-not-allowed opacity-55" : ""}`}
                  >
                    <span
                      className={`flex w-24 shrink-0 flex-col items-center justify-center border-r-2 border-dashed border-paper px-2 py-3 text-center text-white ${
                        reason ? "bg-ink/30" : "bg-moss"
                      }`}
                    >
                      <span className="font-heading text-xl font-semibold leading-tight">
                        {voucherBadge(v)}
                      </span>
                      <span className="mt-0.5 text-[10px] uppercase tracking-wider opacity-80">
                        {slot === "shipping" ? "phí ship" : "tiền hàng"}
                      </span>
                    </span>

                    <span className="min-w-0 flex-1 px-4 py-3">
                      <span className="flex items-center justify-between gap-2">
                        <span className="font-mono text-sm font-semibold tracking-wider">
                          {v.code}
                        </span>
                        {selected && (
                          <span className="rounded-full bg-moss px-2 py-0.5 text-[10px] font-semibold text-white">
                            Đã chọn
                          </span>
                        )}
                      </span>
                      {v.description && (
                        <span className="mt-0.5 block text-sm text-ink/70">
                          {v.description}
                        </span>
                      )}
                      {notes && (
                        <span className="mt-1 block text-xs text-ink/50">
                          {notes}
                        </span>
                      )}
                      {reason && (
                        <span className="mt-1 block text-xs font-medium text-red-700">
                          {reason}
                        </span>
                      )}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  );
}

export default function CheckoutPage() {
  const { items, clearCart, totalItems, totalPrice } = useCart();

  const [mounted, setMounted] = useState(false);
  const [customerName, setCustomerName] = useState("");
  const [phone, setPhone] = useState("");
  const [address, setAddress] = useState("");
  const [paymentMethod, setPaymentMethod] = useState<PaymentMethodValue>("cod");
  const [discountCode, setDiscountCode] = useState(""); // VOUCHER
  const [shippingCode, setShippingCode] = useState(""); // VOUCHER
  const [preview, setPreview] = useState<Preview | null>(null); // VOUCHER
  const [savedAddresses, setSavedAddresses] = useState<SavedAddress[]>([]);
  const [vouchers, setVouchers] = useState<VoucherItem[]>([]); // VOUCHER KHÁCH
  const [fieldErrors, setFieldErrors] = useState<FieldErrors>({});
  const [formError, setFormError] = useState<string | null>(null);
  const [needLogin, setNeedLogin] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [orderId, setOrderId] = useState<number | null>(null);
  // Số tiền khách phải trả của đơn vừa đặt (lấy từ server), vì giỏ đã bị xóa sau khi đặt
  const [orderTotal, setOrderTotal] = useState(0);

  useEffect(() => {
    setMounted(true);
  }, []);

  // Tải sổ địa chỉ; có địa chỉ mặc định thì điền sẵn vào form (chỉ điền ô còn trống)
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const res = await fetch("/api/account/addresses");
        if (!res.ok) return; // chưa đăng nhập: bỏ qua, khách tự nhập
        const json = await res.json();
        if (cancelled || !json.success) return;

        const list = json.data as SavedAddress[];
        setSavedAddresses(list);

        const def = list.find((a) => a.isDefault) ?? list[0];
        if (def) {
          setCustomerName((prev) => prev || def.recipientName);
          setPhone((prev) => prev || def.phone);
          setAddress((prev) => prev || def.address);
        }
      } catch {
        // Lỗi mạng: bỏ qua, form vẫn nhập tay được
      }
    })();
    return () => {
      cancelled = true;
    };
  }, []);

  // VOUCHER KHÁCH: tải danh sách voucher; tải lại khi khách quay lại tab,
  // nên Admin vừa tạo voucher mới thì khách chỉ cần quay lại trang là thấy
  useEffect(() => {
    let cancelled = false;

    async function load() {
      try {
        const res = await fetch("/api/vouchers");
        if (!res.ok) return; // chưa đăng nhập: bỏ qua
        const json = await res.json();
        if (!cancelled && json.success) {
          setVouchers(json.data as VoucherItem[]);
        }
      } catch {
        // Lỗi mạng: bỏ qua, khách vẫn nhập mã tay được
      }
    }

    load();
    window.addEventListener("focus", load);
    return () => {
      cancelled = true;
      window.removeEventListener("focus", load);
    };
  }, []);

  function pickAddress(a: SavedAddress) {
    setCustomerName(a.recipientName);
    setPhone(a.phone);
    setAddress(a.address);
    setFieldErrors((prev) => ({
      ...prev,
      customerName: undefined,
      phone: undefined,
      address: undefined,
    }));
  }

  // Thẻ nào đang khớp đúng với nội dung trong form thì được tô viền
  const selectedAddressId = savedAddresses.find(
    (a) =>
      a.recipientName === customerName &&
      a.phone === phone &&
      a.address === address,
  )?.id;

  // VOUCHER: xem trước tiền mỗi khi giỏ hoặc mã thay đổi (chờ 0,4 giây sau khi ngừng gõ)
  const itemsKey = items.map((i) => `${i.id}:${i.quantity}`).join(",");
  useEffect(() => {
    if (!mounted || items.length === 0 || orderId !== null) return;

    const controller = new AbortController();
    const timer = setTimeout(async () => {
      try {
        const res = await fetch("/api/orders/preview", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            items: items.map((i) => ({
              productId: i.id,
              quantity: i.quantity,
            })),
            discountCode: discountCode.trim() || null,
            shippingCode: shippingCode.trim() || null,
          }),
          signal: controller.signal,
        });
        const json = await res.json();
        if (res.ok && json.success) {
          setPreview(json.data as Preview);
        } else {
          setPreview(null); // chưa đăng nhập hoặc lỗi: dùng số tạm tính ở client
        }
      } catch {
        // Bị hủy do gõ tiếp hoặc mất kết nối: bỏ qua
      }
    }, 400);

    return () => {
      clearTimeout(timer);
      controller.abort();
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [mounted, itemsKey, discountCode, shippingCode, orderId]);

  // VOUCHER: số tiền hiển thị (ưu tiên số server tính, chưa có thì tạm tính)
  const subtotal = preview?.subtotal ?? totalPrice;
  const shippingFee = preview?.shippingFee ?? SHIPPING_FEE;
  const discountAmount = preview?.discountAmount ?? 0;
  const shippingDiscount = preview?.shippingDiscount ?? 0;
  const payable =
    preview?.total ??
    totalPrice - discountAmount + shippingFee - shippingDiscount;

  const discountError = discountCode.trim()
    ? (preview?.errors?.discountCode ?? fieldErrors.discountCode?.[0])
    : undefined;
  const shippingError = shippingCode.trim()
    ? (preview?.errors?.shippingCode ?? fieldErrors.shippingCode?.[0])
    : undefined;

  function changeDiscountCode(v: string) {
    setDiscountCode(v);
    setFieldErrors((prev) => ({ ...prev, discountCode: undefined }));
  }

  function changeShippingCode(v: string) {
    setShippingCode(v);
    setFieldErrors((prev) => ({ ...prev, shippingCode: undefined }));
  }

  // VOUCHER KHÁCH: bấm vé thì điền mã vào đúng ô, bấm lần nữa thì bỏ mã
  function pickVoucher(v: VoucherItem) {
    const current = v.type === "discount" ? discountCode : shippingCode;
    const next = current.trim().toUpperCase() === v.code ? "" : v.code;
    if (v.type === "discount") changeDiscountCode(next);
    else changeShippingCode(next);
  }

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    if (submitting) return;

    setFormError(null);
    setNeedLogin(false);

    // Chỉ gửi productId + quantity + mã, KHÔNG gửi giá/tên (server tự tính lại từ DB)
    const payload = {
      customerName,
      phone,
      address,
      paymentMethod,
      discountCode: discountCode.trim() || null, // VOUCHER
      shippingCode: shippingCode.trim() || null, // VOUCHER
      items: items.map((i) => ({ productId: i.id, quantity: i.quantity })),
    };

    // Validate phía client bằng đúng schema mà API dùng
    const parsed = createOrderSchema.safeParse(payload);
    if (!parsed.success) {
      setFieldErrors(parsed.error.flatten().fieldErrors as FieldErrors);
      return;
    }
    setFieldErrors({});

    setSubmitting(true);
    try {
      const res = await fetch("/api/orders", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(parsed.data),
      });
      const json = await res.json();

      if (res.ok && json.success) {
        // Số tiền phải trả tính từ các khoản đã đóng băng trong đơn, không dùng giá ở client
        const orderItems = (json.data.orderItems ?? []) as {
          priceAtOrder: string | number;
          quantity: number;
        }[];
        const itemsTotal = orderItems.reduce(
          (sum, it) => sum + Number(it.priceAtOrder) * it.quantity,
          0,
        );
        setOrderTotal(
          itemsTotal -
            Number(json.data.discountAmount ?? 0) +
            Number(json.data.shippingFee ?? 0) -
            Number(json.data.shippingDiscount ?? 0),
        );
        setOrderId(json.data.id);
        clearCart();
        return;
      }

      if (res.status === 401) {
        setNeedLogin(true);
      }
      // VOUCHER: lỗi mã gắn đúng ô, các lỗi khác như cũ
      if (json.field) {
        setFieldErrors({ [json.field]: [json.message] } as FieldErrors);
      } else if (json.errors) {
        setFieldErrors(json.errors as FieldErrors);
      }
      setFormError(json.message ?? "Có lỗi xảy ra, vui lòng thử lại");
    } catch {
      setFormError("Không kết nối được máy chủ, vui lòng thử lại");
    } finally {
      setSubmitting(false);
    }
  }

  if (!mounted) {
    return <main className="mx-auto max-w-2xl px-4 py-12" />;
  }

  // Phải kiểm tra thành công TRƯỚC khi kiểm tra giỏ trống,
  // vì sau khi đặt hàng xong giỏ đã bị xóa.
  if (orderId !== null) {
    const steps = ["Đã nhận đơn", "Xác nhận", "Đang giao", "Hoàn tất"];
    const isTransfer = paymentMethod === "bank_transfer";

    return (
      <main className="mx-auto max-w-3xl px-4 pb-24 pt-12">
        {/* Đầu trang: dấu tick + tiêu đề bên trái, mã đơn cỡ lớn bên phải */}
        <div className="flex flex-wrap items-end justify-between gap-6">
          <div>
            <span className="flex h-14 w-14 items-center justify-center rounded-full bg-moss text-white">
              <svg
                viewBox="0 0 24 24"
                className="h-7 w-7"
                fill="none"
                stroke="currentColor"
                strokeWidth="2.4"
                strokeLinecap="round"
                strokeLinejoin="round"
                aria-hidden
              >
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
            </span>
            <h1 className="mt-5 text-4xl font-semibold leading-tight sm:text-5xl">
              Đặt hàng thành công!
            </h1>
            <p className="mt-2 text-ink/65">
              Cỏ May đã nhận được đơn hàng của bạn.
            </p>
          </div>
          <div className="text-right">
            <p className="text-sm text-ink/55">Mã đơn hàng</p>
            <p className="font-heading text-7xl font-semibold leading-none text-moss-dark sm:text-8xl">
              #{orderId}
            </p>
          </div>
        </div>

        <div className="mt-10 grid gap-5 sm:grid-cols-[1.4fr_1fr]">
          {/* Thông tin nhận hàng */}
          <dl className="space-y-5 rounded-2xl bg-white p-6">
            <div>
              <dt className="text-xs font-semibold uppercase tracking-wider text-ink/45">
                Người nhận
              </dt>
              <dd className="mt-1 font-medium">{customerName}</dd>
            </div>
            <div>
              <dt className="text-xs font-semibold uppercase tracking-wider text-ink/45">
                Điện thoại
              </dt>
              <dd className="mt-1 font-medium tabular-nums">{phone}</dd>
            </div>
            <div>
              <dt className="text-xs font-semibold uppercase tracking-wider text-ink/45">
                Giao tới
              </dt>
              <dd className="mt-1 break-words font-medium">{address}</dd>
            </div>
            <div>
              <dt className="text-xs font-semibold uppercase tracking-wider text-ink/45">
                Thanh toán
              </dt>
              <dd className="mt-1 font-medium">
                {isTransfer
                  ? "Chuyển khoản ngân hàng (chờ thanh toán)"
                  : "Khi nhận hàng (COD)"}
              </dd>
            </div>
          </dl>

          {/* Các chặng của đơn: đường dọc */}
          <div className="rounded-2xl bg-blush p-6">
            <p className="text-xs font-semibold uppercase tracking-wider text-moss-dark">
              Đơn của bạn sẽ đi qua
            </p>
            <ol className="relative mt-5 space-y-5">
              <span
                aria-hidden
                className="absolute bottom-2 left-[7px] top-2 w-px bg-peach"
              />
              {steps.map((label, i) => (
                <li key={label} className="relative flex items-center gap-4">
                  <span
                    className={`relative z-10 h-4 w-4 rounded-full border-2 ${
                      i === 0 ? "border-moss bg-moss" : "border-peach bg-blush"
                    }`}
                  />
                  <span
                    className={`text-sm ${
                      i === 0 ? "font-semibold text-ink" : "text-ink/50"
                    }`}
                  >
                    {label}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>

        {isTransfer && <TransferPanel orderId={orderId} amount={orderTotal} />}

        <p className="mt-6 leading-relaxed text-ink/65">
          {isTransfer
            ? "Sau khi nhận được tiền, shop sẽ xác nhận đơn và liên hệ qua số điện thoại trên. Bạn có thể theo dõi trạng thái trong mục đơn hàng."
            : "Shop sẽ liên hệ qua số điện thoại trên để xác nhận đơn. Bạn có thể theo dõi trạng thái trong mục đơn hàng."}
        </p>

        <div className="mt-8 flex flex-col gap-3 sm:flex-row">
          <Link
            href="/orders"
            className="rounded-xl bg-moss px-7 py-3.5 text-center font-semibold text-white transition hover:bg-moss-dark"
          >
            Xem đơn hàng của tôi
          </Link>
          <Link
            href="/products"
            className="rounded-xl border border-ink/20 px-7 py-3.5 text-center font-medium transition hover:border-moss hover:text-moss-dark"
          >
            Tiếp tục mua sắm
          </Link>
        </div>
      </main>
    );
  }

  if (items.length === 0) {
    return (
      <main className="mx-auto max-w-2xl px-4 pb-24 pt-16 text-center">
        <h1 className="text-4xl font-semibold sm:text-5xl">
          Chưa có gì để đặt
        </h1>
        <p className="mt-4 text-ink/65">
          Hãy thêm sản phẩm vào giỏ trước khi đặt hàng.
        </p>
        <Link
          href="/products"
          className="mt-8 inline-block rounded-xl bg-moss px-8 py-4 font-semibold text-white transition hover:bg-moss-dark"
        >
          Xem sản phẩm
        </Link>
      </main>
    );
  }

  return (
    <main className="mx-auto max-w-2xl px-4 pb-24 pt-8">
      {/* Các bước mua hàng */}
      <ol className="flex items-center gap-3 text-sm">
        <li>
          <Link
            href="/cart"
            className="flex items-center gap-2 text-ink/55 transition-colors hover:text-moss-dark"
          >
            <span className="flex h-6 w-6 items-center justify-center rounded-full bg-moss text-white">
              <svg
                viewBox="0 0 24 24"
                className="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                strokeWidth="3"
                strokeLinecap="round"
                strokeLinejoin="round"
                aria-hidden
              >
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
            </span>
            Giỏ hàng
          </Link>
        </li>
        <li aria-hidden className="h-px w-8 bg-ink/25" />
        <li className="flex items-center gap-2 font-semibold">
          <span className="flex h-6 w-6 items-center justify-center rounded-full bg-ink text-xs text-paper">
            2
          </span>
          Đặt hàng
        </li>
        <li aria-hidden className="h-px w-8 bg-ink/25" />
        <li className="flex items-center gap-2 text-ink/40">
          <span className="flex h-6 w-6 items-center justify-center rounded-full border border-ink/25 text-xs">
            3
          </span>
          Hoàn tất
        </li>
      </ol>

      <h1 className="mt-8 text-4xl font-semibold leading-tight sm:text-5xl">
        Đặt hàng
      </h1>
      <p className="mt-2 text-ink/65">
        Điền thông tin giao hàng, shop sẽ liên hệ xác nhận đơn.
      </p>

      {/* Tóm tắt đơn: bấm để xổ ra / thu lại */}
      <details className="group mt-8 overflow-hidden rounded-2xl bg-blush">
        <summary className="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 [&::-webkit-details-marker]:hidden">
          <span className="flex items-center gap-2 text-sm font-medium text-moss-dark">
            Xem đơn hàng ({totalItems} món)
            <svg
              aria-hidden
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth={2}
              strokeLinecap="round"
              strokeLinejoin="round"
              className="h-4 w-4 transition-transform duration-200 group-open:rotate-180"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
          <span className="font-heading text-2xl font-semibold">
            {formatVND(totalPrice)}
          </span>
        </summary>

        <ul className="space-y-4 border-t border-peach/60 px-5 py-5">
          {items.map((item) => (
            <li key={item.id} className="flex items-center gap-3">
              <span className="relative h-14 w-14 shrink-0 overflow-hidden rounded-lg bg-white">
                {item.imageUrl && (
                  // eslint-disable-next-line @next/next/no-img-element
                  <img
                    src={item.imageUrl}
                    alt={item.name}
                    className="h-full w-full object-cover"
                  />
                )}
                <span className="absolute right-0 top-0 flex h-5 min-w-5 items-center justify-center rounded-bl-lg bg-ink px-1 text-[11px] font-semibold text-paper">
                  {item.quantity}
                </span>
              </span>
              <span className="min-w-0 flex-1 text-sm font-medium leading-snug">
                {item.name}
              </span>
              <span className="shrink-0 text-sm tabular-nums">
                {formatVND(item.price * item.quantity)}
              </span>
            </li>
          ))}
          <li>
            <Link
              href="/cart"
              className="text-sm text-ink/60 underline underline-offset-4 transition-colors hover:text-moss-dark"
            >
              ← Sửa giỏ hàng
            </Link>
          </li>
        </ul>
      </details>

      <form onSubmit={handleSubmit} noValidate>
        <AddressPicker
          list={savedAddresses}
          selectedId={selectedAddressId}
          onPick={pickAddress}
        />

        <div className="mt-10" />

        <Step no={1} title="Người nhận">
          <div className="grid gap-4 sm:grid-cols-2">
            <div>
              <label htmlFor="customerName" className={labelClass}>
                Tên người nhận
              </label>
              <input
                id="customerName"
                type="text"
                value={customerName}
                onChange={(e) => setCustomerName(e.target.value)}
                placeholder="Nguyễn Văn A"
                className={fieldClass(!!fieldErrors.customerName)}
              />
              {fieldErrors.customerName && (
                <p className="mt-1.5 text-xs text-red-700">
                  {fieldErrors.customerName[0]}
                </p>
              )}
            </div>

            <div>
              <label htmlFor="phone" className={labelClass}>
                Số điện thoại
              </label>
              <input
                id="phone"
                type="tel"
                value={phone}
                onChange={(e) => setPhone(e.target.value)}
                placeholder="0901 234 567"
                className={fieldClass(!!fieldErrors.phone)}
              />
              {fieldErrors.phone && (
                <p className="mt-1.5 text-xs text-red-700">
                  {fieldErrors.phone[0]}
                </p>
              )}
            </div>
          </div>
        </Step>

        <Step no={2} title="Giao hàng tới">
          <label htmlFor="address" className={labelClass}>
            Địa chỉ giao hàng
          </label>
          <textarea
            id="address"
            rows={3}
            value={address}
            onChange={(e) => setAddress(e.target.value)}
            placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"
            className={`${fieldClass(!!fieldErrors.address)} resize-none`}
          />
          {fieldErrors.address && (
            <p className="mt-1.5 text-xs text-red-700">
              {fieldErrors.address[0]}
            </p>
          )}
        </Step>

        {/* VOUCHER: bước nhập mã giảm giá */}
        <Step no={3} title="Mã giảm giá">
          <p className="mb-4 text-sm text-ink/60">
            Mỗi đơn dùng được 1 mã giảm tiền hàng và 1 mã giảm phí ship cùng
            lúc.
          </p>
          <VoucherTickets
            list={vouchers}
            subtotal={subtotal}
            discountCode={discountCode}
            shippingCode={shippingCode}
            onPick={pickVoucher}
          />
          <div className="space-y-3">
            <VoucherField
              id="discountCode"
              label="Mã giảm tiền hàng"
              hint="Trừ vào tiền hàng"
              value={discountCode}
              onChange={changeDiscountCode}
              error={discountError}
              appliedCode={
                discountCode.trim() && !discountError
                  ? preview?.discountVoucher?.code
                  : undefined
              }
              amount={discountAmount}
            />
            <VoucherField
              id="shippingCode"
              label="Mã giảm phí ship"
              hint="Trừ vào phí vận chuyển"
              value={shippingCode}
              onChange={changeShippingCode}
              error={shippingError}
              appliedCode={
                shippingCode.trim() && !shippingError
                  ? preview?.shippingVoucher?.code
                  : undefined
              }
              amount={shippingDiscount}
            />
          </div>
        </Step>

        <Step no={4} title="Thanh toán" last>
          <div
            role="radiogroup"
            aria-label="Phương thức thanh toán"
            className="space-y-3"
          >
            <PaymentOption
              selected={paymentMethod === "cod"}
              title="Thanh toán khi nhận hàng (COD)"
              desc="Bạn trả tiền mặt cho người giao hàng."
              onSelect={() => setPaymentMethod("cod")}
            />
            <PaymentOption
              selected={paymentMethod === "bank_transfer"}
              title="Chuyển khoản ngân hàng"
              desc="Quét mã QR để thanh toán ngay sau khi đặt hàng."
              onSelect={() => setPaymentMethod("bank_transfer")}
            />
          </div>
          {paymentMethod === "bank_transfer" && (
            <p className="mt-3 rounded-xl bg-blush px-4 py-3 text-sm text-moss-dark">
              Sau khi bấm đặt hàng, bạn sẽ nhận mã QR cùng nội dung chuyển khoản
              có mã đơn.
            </p>
          )}
        </Step>

        {/* VOUCHER: khối tổng tiền */}
        <dl className="mt-8 space-y-2.5 rounded-2xl bg-blush px-5 py-5 text-sm">
          <SummaryRow label="Tiền hàng" value={formatVND(subtotal)} />
          {discountAmount > 0 && (
            <SummaryRow
              label={`Giảm giá${preview?.discountVoucher ? ` (${preview.discountVoucher.code})` : ""}`}
              value={`- ${formatVND(discountAmount)}`}
              accent
            />
          )}
          <SummaryRow label="Phí vận chuyển" value={formatVND(shippingFee)} />
          {shippingDiscount > 0 && (
            <SummaryRow
              label={`Giảm phí ship${preview?.shippingVoucher ? ` (${preview.shippingVoucher.code})` : ""}`}
              value={`- ${formatVND(shippingDiscount)}`}
              accent
            />
          )}
          <div className="flex items-baseline justify-between gap-4 border-t border-peach/60 pt-3">
            <dt className="font-semibold">Tổng cộng</dt>
            <dd className="font-heading text-2xl font-semibold tabular-nums">
              {formatVND(payable)}
            </dd>
          </div>
        </dl>

        {formError && (
          <div
            role="alert"
            className="mt-8 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800"
          >
            {formError}
            {needLogin && (
              <>
                {" "}
                <Link
                  href="/login?next=/checkout"
                  className="font-semibold underline underline-offset-2"
                >
                  Đăng nhập
                </Link>
              </>
            )}
          </div>
        )}

        <button
          type="submit"
          disabled={submitting}
          className="mt-8 w-full rounded-xl bg-moss py-4 text-base font-semibold text-white transition hover:bg-moss-dark disabled:cursor-not-allowed disabled:opacity-60"
        >
          {submitting
            ? "Đang xử lý..."
            : `Xác nhận đặt hàng · ${formatVND(payable)}`}
        </button>
        <p className="mt-3 text-center text-sm text-ink/55">
          Shop sẽ gọi điện xác nhận trước khi giao hàng.
        </p>
      </form>
    </main>
  );
}
</file>

<file path="src/app/products/[id]/page.tsx">
import { prisma } from "../../../../lib/prisma";
import { formatVND } from "../../../../lib/format";
import { getCurrentCustomer } from "../../../../lib/auth";
import Image from "next/image";
import Link from "next/link";
import { notFound } from "next/navigation";
import AddToCartButton from "../../../components/AddToCartButton";
import ReviewForm from "../../../components/ReviewForm";
import { getAlsoBought } from "../../../../lib/recommendations";
import RecentlyViewed from "../../../components/RecentlyViewed";
import WishlistButton from "../../../components/WishlistButton";

// Từ ngưỡng này trở xuống thì báo "Chỉ còn ..." để khách biết món sắp hết
const LOW_STOCK = 5;

export default async function ProductDetailPage({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const { id } = await params;

  const [product, customer] = await Promise.all([
    prisma.product.findFirst({
      where: { id: Number(id), isActive: true },
      include: {
        category: true,
        reviews: {
          where: { status: "approved" },
          include: {
            customer: { select: { name: true } },
          },
          orderBy: { createdAt: "desc" },
        },
      },
    }),
    getCurrentCustomer(),
  ]);

  if (!product) notFound();
  const alsoBought = await getAlsoBought(product.id, 4);

  const reviewCount = product.reviews.length;
  const averageRating =
    reviewCount === 0
      ? 0
      : product.reviews.reduce((sum, r) => sum + r.rating, 0) / reviewCount;

  const outOfStock = product.stock <= 0;
  const lowStock = !outOfStock && product.stock <= LOW_STOCK;

  return (
    <main className="mx-auto max-w-5xl px-4 pb-20 pt-8">
      {/* Đường dẫn quay lại */}
      <nav
        aria-label="Đường dẫn"
        className="flex flex-wrap items-center gap-2 text-sm text-ink/55"
      >
        <Link href="/" className="transition-colors hover:text-moss-dark">
          Trang chủ
        </Link>
        <span aria-hidden>/</span>
        <Link
          href="/products"
          className="transition-colors hover:text-moss-dark"
        >
          Sản phẩm
        </Link>
        <span aria-hidden>/</span>
        <Link
          href={`/products?category=${product.categoryId}`}
          className="transition-colors hover:text-moss-dark"
        >
          {product.category.name}
        </Link>
      </nav>

      <div className="mt-6 grid gap-10 md:grid-cols-2 md:gap-12">
        {/* Ảnh: khung kiểu ảnh dán */}
        <div className="h-fit rounded-lg border border-peach/50 bg-white p-3 shadow-warm-lg md:sticky md:top-24">
          <div className="relative aspect-square overflow-hidden bg-blush/40">
            <Image
              src={product.imageUrl ?? "/images/products/placeholder.jpg"}
              alt={product.name}
              fill
              sizes="(min-width: 768px) 50vw, 100vw"
              priority
              className={`object-cover ${
                outOfStock ? "opacity-60 grayscale" : ""
              }`}
            />
            {outOfStock && (
              <span className="absolute left-0 top-4 bg-ink px-4 py-1.5 text-xs font-medium uppercase tracking-wider text-paper">
                Hết hàng
              </span>
            )}
          </div>
        </div>

        {/* Thông tin */}
        <div>
          <p className="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-moss-dark">
            <span className="h-px w-8 bg-moss-dark" />
            {product.category.name}
          </p>
          <h1 className="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">
            {product.name}
          </h1>

          <div className="mt-3 flex items-center gap-2">
            <StarRating value={averageRating} />
            <span className="text-sm text-ink/60">
              {reviewCount > 0
                ? `${averageRating.toFixed(1)} (${reviewCount} đánh giá)`
                : "Chưa có đánh giá"}
            </span>
          </div>

          <p className="mt-5 font-heading text-4xl font-semibold text-moss-dark">
            {formatVND(Number(product.price))}
          </p>

          {/* Tình trạng kho */}
          <p className="mt-4">
            {outOfStock ? (
              <span className="inline-block rounded-md bg-ink px-3 py-1 text-sm font-medium text-paper">
                Hết hàng
              </span>
            ) : lowStock ? (
              <span className="inline-block rounded-md bg-ochre px-3 py-1 text-sm font-semibold text-ink">
                Chỉ còn {product.stock} món
              </span>
            ) : (
              <span className="inline-block rounded-md border border-peach bg-blush/60 px-3 py-1 text-sm font-medium text-moss-dark">
                Còn hàng ({product.stock})
              </span>
            )}
          </p>

          <div className="mt-6 border-t border-ink/15 pt-6">
            <p className="whitespace-pre-line leading-relaxed text-ink/80">
              {product.description}
            </p>
          </div>

          <AddToCartButton
            productId={product.id}
            name={product.name}
            price={Number(product.price)}
            imageUrl={product.imageUrl}
            stock={product.stock}
            isLoggedIn={customer !== null}
          />

          <div className="mt-3">
            <WishlistButton productId={product.id} variant="full" />
          </div>
        </div>
      </div>

      {/* Đánh giá */}
      <section className="mt-20">
        <div className="flex flex-wrap items-end justify-between gap-3 border-b border-ink/15 pb-4">
          <div>
            <p className="text-xs font-semibold uppercase tracking-[0.22em] text-moss-dark">
              Khách nói gì
            </p>
            <h2 className="mt-1 text-2xl font-semibold sm:text-3xl">
              Đánh giá sản phẩm
            </h2>
          </div>
          {reviewCount > 0 && (
            <div className="flex items-center gap-3">
              <span className="font-heading text-4xl font-semibold text-moss-dark">
                {averageRating.toFixed(1)}
              </span>
              <div>
                <StarRating value={averageRating} />
                <p className="mt-0.5 text-xs text-ink/55">
                  {reviewCount} đánh giá
                </p>
              </div>
            </div>
          )}
        </div>

        {product.reviews.length === 0 ? (
          <p className="mt-6 rounded-lg border-2 border-dashed border-peach bg-white px-6 py-8 text-center text-ink/60">
            Chưa có đánh giá nào cho sản phẩm này.
          </p>
        ) : (
          <ul className="mt-6 grid gap-4 sm:grid-cols-2">
            {product.reviews.map((review) => (
              <li
                key={review.id}
                className="rounded-lg border border-peach/50 bg-white p-5 shadow-warm"
              >
                <div className="flex items-center justify-between gap-3">
                  <div className="flex items-center gap-3">
                    <span
                      aria-hidden
                      className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blush font-heading text-base font-semibold text-moss-dark"
                    >
                      {review.customer.name.trim().charAt(0).toUpperCase()}
                    </span>
                    <span className="font-medium">{review.customer.name}</span>
                  </div>
                  <StarRating value={review.rating} />
                </div>
                {review.comment && (
                  <p className="mt-3 leading-relaxed text-ink/80">
                    {review.comment}
                  </p>
                )}
              </li>
            ))}
          </ul>
        )}

        <ReviewForm productId={product.id} />
      </section>
      {/* Gợi ý đi kèm: dải cuộn ngang */}
      {alsoBought.length > 0 && (
        <section className="mt-20">
          <div className="border-b border-ink/15 pb-4">
            <p className="text-xs font-semibold uppercase tracking-[0.22em] text-moss-dark">
              Gợi ý đi kèm
            </p>
            <h2 className="mt-1 text-2xl font-semibold sm:text-3xl">
              Khách mua món này cũng mua
            </h2>
          </div>

          <ul className="mt-6 flex snap-x gap-4 overflow-x-auto pb-3">
            {alsoBought.map((p) => (
              <li key={p.id} className="w-72 shrink-0 snap-start">
                <Link
                  href={`/products/${p.id}`}
                  className="flex items-center gap-4 rounded-lg border border-peach/50 bg-white p-3 shadow-warm transition-colors hover:border-moss-dark"
                >
                  <div className="relative h-24 w-24 shrink-0 overflow-hidden rounded-md bg-blush/40">
                    <Image
                      src={p.imageUrl ?? "/images/products/placeholder.jpg"}
                      alt={p.name}
                      fill
                      sizes="96px"
                      className="object-cover"
                    />
                  </div>
                  <div className="min-w-0">
                    <p className="line-clamp-2 font-medium leading-snug">
                      {p.name}
                    </p>
                    <p className="mt-2 font-heading text-lg font-semibold text-moss-dark">
                      {formatVND(Number(p.price))}
                    </p>
                  </div>
                </Link>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Bạn vừa xem: ghi lại món này và hiện các món đã xem trước đó */}
      <RecentlyViewed
        current={{
          id: product.id,
          name: product.name,
          price: Number(product.price),
          imageUrl: product.imageUrl,
        }}
      />
    </main>
  );
}

function StarRating({ value }: { value: number }) {
  const rounded = Math.round(value);
  return (
    <div className="flex gap-0.5" aria-label={`${value.toFixed(1)} trên 5 sao`}>
      {[1, 2, 3, 4, 5].map((star) => (
        <span
          key={star}
          className={star <= rounded ? "text-ochre" : "text-ink/20"}
        >
          ★
        </span>
      ))}
    </div>
  );
}
</file>

<file path="src/app/layout.tsx">
import type { Metadata } from "next";
import { Fraunces, Be_Vietnam_Pro } from "next/font/google";
import "./globals.css";
import { CartProvider } from "../../lib/cart-context";
import Header from "../components/Header";
import Footer from "../components/Footer";
import { WishlistProvider } from "../../lib/wishlist-context";
import SocialFloat from "../components/SocialFloat";

const fraunces = Fraunces({
  subsets: ["latin", "vietnamese"],
  variable: "--font-heading",
  weight: ["500", "600", "700"],
});

const beVietnamPro = Be_Vietnam_Pro({
  subsets: ["latin", "vietnamese"],
  variable: "--font-body",
  weight: ["400", "500", "700"],
});

export const metadata: Metadata = {
  title: "Cỏ May Handmade",
