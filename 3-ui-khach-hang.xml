<file path="src/components/ReviewForm.tsx">
"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { createReviewSchema } from "../../lib/validation/review";

type Status = {
  loggedIn: boolean;
  canReview: boolean;
  hasReviewed: boolean;
  reviewStatus?: "pending" | "approved" | "hidden" | null;
};

// Chữ hiện bên dưới hàng sao, theo số sao đang chọn hoặc đang rê chuột
const RATING_LABELS = [
  "Chạm vào sao để chấm điểm",
  "Chưa hài lòng",
  "Tạm được",
  "Ổn",
  "Hài lòng",
  "Tuyệt vời",
];

// Thanh thông báo một dòng, dùng cho các trường hợp không có form
function Notice({
  icon,
  children,
}: {
  icon: React.ReactNode;
  children: React.ReactNode;
}) {
  return (
    <div className="mt-8 flex items-center gap-4 rounded-2xl bg-blush px-5 py-4 text-ink">
      <span
        aria-hidden
        className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-moss-dark"
      >
        {icon}
      </span>
      <p className="text-sm leading-relaxed sm:text-base">{children}</p>
    </div>
  );
}

const iconProps = {
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  strokeWidth: 1.9,
  strokeLinecap: "round" as const,
  strokeLinejoin: "round" as const,
  className: "h-5 w-5",
};

export default function ReviewForm({ productId }: { productId: number }) {
  const router = useRouter();
  const [status, setStatus] = useState<Status | null>(null);
  const [rating, setRating] = useState(0);
  const [hover, setHover] = useState(0);
  const [comment, setComment] = useState("");
  const [error, setError] = useState("");
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    fetch(`/api/products/${productId}/reviews`)
      .then((r) => r.json())
      .then((json) => {
        if (json.success) setStatus(json.data);
      })
      .catch(() => {});
  }, [productId]);

  async function handleSubmit(e: React.SyntheticEvent) {
    e.preventDefault();
    setError("");

    const parsed = createReviewSchema.safeParse({ rating, comment });
    if (!parsed.success) {
      setError(
        rating === 0 ? "Vui lòng chọn số sao" : parsed.error.issues[0].message,
      );
      return;
    }

    setSaving(true);
    try {
      const res = await fetch(`/api/products/${productId}/reviews`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(parsed.data),
      });
      const json = await res.json();
      if (!json.success) {
        setError(json.message);
        return;
      }
      setStatus({
        loggedIn: true,
        canReview: false,
        hasReviewed: true,
        reviewStatus: "pending",
      });
      router.refresh(); // tải lại danh sách review và sao trung bình
    } catch {
      setError("Không thể kết nối máy chủ");
    } finally {
      setSaving(false);
    }
  }

  // Đang kiểm tra: chưa hiện gì để tránh nhấp nháy
  if (!status) return null;

  if (!status.loggedIn) {
    return (
      <Notice
        icon={
          <svg {...iconProps}>
            <rect x="5" y="11" width="14" height="9" rx="2" />
            <path d="M8 11V8a4 4 0 0 1 8 0v3" />
          </svg>
        }
      >
        <Link
          href={`/login?next=/products/${productId}`}
          className="font-semibold text-moss-dark underline decoration-2 underline-offset-4 hover:text-moss"
        >
          Đăng nhập
        </Link>{" "}
        để đánh giá sản phẩm đã mua.
      </Notice>
    );
  }

  if (status.hasReviewed) {
    // Đánh giá đang chờ Admin duyệt: báo rõ để khách không tưởng gửi lỗi
    if (status.reviewStatus === "pending") {
      return (
        <Notice
          icon={
            <svg {...iconProps}>
              <circle cx="12" cy="12" r="8.5" />
              <path d="M12 7.5V12l3 2" />
            </svg>
          }
        >
          <span className="font-semibold">Cảm ơn bạn!</span> Đánh giá của bạn
          đang chờ cửa hàng duyệt, duyệt xong sẽ hiện ở trang này.
        </Notice>
      );
    }

    // Admin đã ẩn đánh giá này
    if (status.reviewStatus === "hidden") {
      return (
        <Notice
          icon={
            <svg {...iconProps}>
              <circle cx="12" cy="12" r="8.5" />
              <path d="M12 7.5V12l3 2" />
            </svg>
          }
        >
          Đánh giá của bạn hiện không được hiển thị công khai.
        </Notice>
      );
    }

    return (
      <Notice
        icon={
          <svg {...iconProps} strokeWidth={2.4}>
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        }
      >
        <span className="font-semibold">Cảm ơn bạn!</span> Bạn đã đánh giá sản
        phẩm này.
      </Notice>
    );
  }

  if (!status.canReview) {
    return (
      <Notice
        icon={
          <svg {...iconProps}>
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
          </svg>
        }
      >
        Bạn chỉ có thể đánh giá sản phẩm sau khi đơn hàng chứa sản phẩm này đã
        hoàn thành.
      </Notice>
    );
  }

  const shown = hover || rating;

  return (
    <form
      onSubmit={handleSubmit}
      noValidate
      className="mt-8 grid overflow-hidden rounded-2xl bg-white md:grid-cols-[2fr_3fr]"
    >
      {/* Trái: chấm sao */}
      <div className="bg-moss p-7 text-white sm:p-8">
        <h3 className="font-heading text-2xl font-semibold leading-snug">
          Bạn thấy món này thế nào?
        </h3>

        <div
          className="mt-6 flex gap-1"
          onMouseLeave={() => setHover(0)}
          role="radiogroup"
          aria-label="Chấm điểm sản phẩm"
        >
          {[1, 2, 3, 4, 5].map((n) => (
            <button
              key={n}
              type="button"
              role="radio"
              aria-checked={rating === n}
              aria-label={`${n} sao`}
              onClick={() => setRating(n)}
              onMouseEnter={() => setHover(n)}
              onFocus={() => setHover(n)}
              onBlur={() => setHover(0)}
              className={`text-5xl leading-none transition duration-150 hover:scale-110 focus:outline-none focus-visible:scale-110 ${
                n <= shown ? "text-white" : "text-white/30"
              }`}
            >
              ★
            </button>
          ))}
        </div>

        <p
          aria-live="polite"
          className={`mt-4 min-h-7 text-lg font-semibold ${
            shown ? "text-white" : "text-white/70"
          }`}
        >
          {RATING_LABELS[shown]}
        </p>
      </div>

      {/* Phải: viết cảm nhận */}
      <div className="flex flex-col p-7 sm:p-8">
        <label
          htmlFor="review-comment"
          className="text-sm font-medium text-ink/75"
        >
          Chia sẻ cảm nhận của bạn{" "}
          <span className="font-normal text-ink/45">(không bắt buộc)</span>
        </label>
        <textarea
          id="review-comment"
          rows={4}
          value={comment}
          onChange={(e) => setComment(e.target.value)}
          placeholder="Chất lượng, đóng gói, mùi hương, độ tinh xảo..."
          className="mt-2 w-full flex-1 resize-none rounded-xl border border-ink/15 bg-paper px-4 py-3 text-ink outline-none transition placeholder:text-ink/35 focus:border-moss focus:ring-2 focus:ring-moss/20"
        />

        {error && (
          <p
            role="alert"
            className="mt-3 rounded-lg border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800"
          >
            {error}
          </p>
        )}

        <button
          disabled={saving}
          className="mt-4 self-end rounded-xl bg-ink px-7 py-3 font-semibold text-paper transition hover:bg-moss-dark disabled:cursor-not-allowed disabled:opacity-50"
        >
          {saving ? "Đang gửi..." : "Gửi đánh giá"}
        </button>
      </div>
    </form>
  );
}
</file>

<file path="src/app/login/page.tsx">
"use client";

import { useState, Suspense } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import Link from "next/link";

const inputClass =
  "mt-1.5 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-ink outline-none transition placeholder:text-ink/35 focus:border-moss focus:ring-2 focus:ring-moss/20 [&:-webkit-autofill]:[box-shadow:0_0_0_1000px_white_inset] [&:-webkit-autofill]:[-webkit-text-fill-color:var(--color-ink)]";

const labelClass = "text-sm font-medium text-ink/75";

function LoginForm() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const rawNext = searchParams.get("next");
  // Chỉ chấp nhận đường dẫn nội bộ; chặn "//..." và "/\..." (trình duyệt hiểu là link ngoài)
  const next =
    rawNext &&
    rawNext.startsWith("/") &&
    !rawNext.startsWith("//") &&
    !rawNext.startsWith("/\\")
      ? rawNext
      : "/";

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setError("");
    setLoading(true);

    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });
      const data = await res.json();

      if (!data.success) {
        setError(data.message);
        return;
      }

      router.push(next);
      router.refresh();
    } catch {
      setError("Không thể kết nối tới server, vui lòng thử lại");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="mx-auto max-w-5xl px-4 pb-20 pt-10 sm:pt-14">
      <div className="grid overflow-hidden rounded-3xl bg-white md:grid-cols-[5fr_6fr]">
        {/* Trái: lời chào */}
        <aside className="flex flex-col justify-between gap-10 bg-blush p-8 sm:p-10">
          <Link href="/" className="flex w-fit items-center gap-2.5">
            <span
              aria-hidden
              className="flex h-9 w-9 items-center justify-center rounded-full bg-moss font-heading text-lg font-semibold text-white"
            >
              C
            </span>
            <span className="font-heading text-xl font-semibold text-ink">
              Cỏ May Handmade
            </span>
          </Link>

          <div>
            <h1 className="text-4xl font-semibold leading-[1.1] sm:text-5xl">
              Chào mừng
              <br />
              <span className="text-moss-dark">bạn quay lại.</span>
            </h1>
            <p className="mt-4 max-w-xs leading-relaxed text-ink/70">
              Đăng nhập để tiếp tục chọn những món handmade làm từng chiếc một.
            </p>
          </div>

          <ul className="hidden space-y-3 text-sm text-ink/80 md:block">
            {[
              "Đặt hàng và theo dõi đơn của bạn",
              "Đánh giá những món đã mua",
            ].map((text) => (
              <li key={text} className="flex items-center gap-3">
                <span
                  aria-hidden
                  className="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-moss text-white"
                >
                  <svg
                    viewBox="0 0 24 24"
                    className="h-3.5 w-3.5"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="3"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                  >
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                </span>
                {text}
              </li>
            ))}
          </ul>
        </aside>

        {/* Phải: form */}
        <section className="p-8 sm:p-12">
          <h2 className="text-3xl font-semibold">Đăng nhập</h2>
          {next !== "/" ? (
            <p className="mt-2 text-ink/65">Bạn cần đăng nhập để tiếp tục.</p>
          ) : (
            <p className="mt-2 text-ink/65">Nhập email và mật khẩu của bạn.</p>
          )}

          <form onSubmit={handleSubmit} className="mt-8 space-y-5">
            <div>
              <label htmlFor="email" className={labelClass}>
                Email
              </label>
              <input
                id="email"
                type="email"
                autoComplete="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                required
                placeholder="ban@example.com"
                className={inputClass}
              />
            </div>

            <div>
              <label htmlFor="password" className={labelClass}>
                Mật khẩu
              </label>
              <div className="relative">
                <input
                  id="password"
                  type={showPassword ? "text" : "password"}
                  autoComplete="current-password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  required
                  placeholder="Nhập mật khẩu"
                  className={`${inputClass} pr-16`}
                />
                <button
                  type="button"
                  onClick={() => setShowPassword((v) => !v)}
                  aria-label={showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu"}
                  className="absolute right-3 top-1/2 mt-[3px] -translate-y-1/2 rounded-md px-2 py-1 text-xs font-semibold text-moss-dark transition-colors hover:bg-blush"
                >
                  {showPassword ? "Ẩn" : "Hiện"}
                </button>
              </div>
              <div className="mt-2 text-right">
                <Link
                  href="/forgot-password"
                  className="text-sm font-medium text-moss-dark underline decoration-moss/40 underline-offset-4 transition-colors hover:text-ink"
                >
                  Quên mật khẩu?
                </Link>
              </div>
            </div>

            {error && (
              <p
                role="alert"
                className="rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800"
              >
                {error}
              </p>
            )}

            <button
              type="submit"
              disabled={loading}
              className="w-full rounded-xl bg-moss py-3.5 font-semibold text-white transition hover:bg-moss-dark disabled:cursor-not-allowed disabled:opacity-60"
            >
              {loading ? "Đang xử lý..." : "Đăng nhập"}
            </button>
          </form>

          <p className="mt-8 border-t border-ink/10 pt-6 text-sm text-ink/65">
            Chưa có tài khoản?{" "}
            <Link
              href="/register"
              className="font-semibold text-ink underline decoration-moss decoration-2 underline-offset-4 transition-colors hover:text-moss-dark"
            >
              Đăng ký ngay
            </Link>
          </p>
        </section>
      </div>
    </main>
  );
}

export default function LoginPage() {
  return (
    <Suspense
      fallback={
        <main className="mx-auto max-w-5xl px-4 pt-14">
          <div className="h-[460px] animate-pulse rounded-3xl bg-ink/10" />
        </main>
      }
    >
      <LoginForm />
    </Suspense>
  );
}
</file>

<file path="src/app/orders/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import Image from "next/image";
import Link from "next/link";
import { formatVND } from "../../../lib/format";

type OrderItem = {
  id: number;
  quantity: number;
  priceAtOrder: string; // Prisma Decimal -> chuỗi
  product: {
    id: number;
    name: string;
    imageUrl: string | null;
  };
};

type Order = {
  id: number;
  customerName: string;
  phone: string;
  address: string;
  status: string;
  paymentMethod: string; // "cod" | "bank_transfer"
  isPaid: boolean;
  paidAt: string | null;
  shippingFee?: string; // Prisma Decimal -> chuỗi
  discountAmount?: string;
  shippingDiscount?: string;
  createdAt: string;
  orderItems: OrderItem[];
};

// Thông tin tài khoản nhận tiền, đọc từ .env (giống trang checkout)
const BANK = {
  name: process.env.NEXT_PUBLIC_BANK_NAME ?? "",
  account: process.env.NEXT_PUBLIC_BANK_ACCOUNT ?? "",
  holder: process.env.NEXT_PUBLIC_BANK_HOLDER ?? "",
};

// Nếu enum status trong schema của bạn dùng giá trị khác thì sửa/thêm ở đây.
// Giá trị lạ sẽ hiện nguyên chữ gốc, không bị lỗi.
const statusLabels: Record<string, string> = {
  pending: "Chờ xác nhận",
  confirmed: "Đã xác nhận",
  shipped: "Đang giao",
  completed: "Hoàn thành",
  cancelled: "Đã hủy",
};

const paymentLabels: Record<string, string> = {
  cod: "Thanh toán khi nhận hàng (COD)",
  bank_transfer: "Chuyển khoản ngân hàng",
};

// Thứ tự các chặng của một đơn bình thường
const FLOW = ["pending", "confirmed", "shipped", "completed"];

// Màu chấm trạng thái
const statusDot: Record<string, string> = {
  pending: "bg-ochre",
  confirmed: "bg-moss",
  shipped: "bg-ink",
  completed: "bg-emerald-600",
  cancelled: "bg-ink/30",
};

// Tiền hàng (chưa tính ship và giảm giá)
function itemsSubtotal(order: Order) {
  return order.orderItems.reduce(
    (sum, item) => sum + Number(item.priceAtOrder) * item.quantity,
    0,
  );
}

// Số khách phải trả = tiền hàng + phí ship - giảm giá hàng - giảm ship
function orderTotal(order: Order) {
  const total =
    itemsSubtotal(order) +
    Number(order.shippingFee ?? 0) -
    Number(order.discountAmount ?? 0) -
    Number(order.shippingDiscount ?? 0);
  return Math.max(0, total);
}

function shortDate(iso: string) {
  return new Date(iso).toLocaleDateString("vi-VN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
}

// Đơn chuyển khoản còn chờ khách chuyển tiền
function needsPayment(order: Order) {
  return (
    order.paymentMethod === "bank_transfer" &&
    !order.isPaid &&
    order.status !== "cancelled"
  );
}

function StatusBadge({ status }: { status: string }) {
  return (
    <span className="inline-flex items-center gap-1.5 text-xs font-semibold">
      <span
        aria-hidden
        className={`h-2 w-2 rounded-full ${statusDot[status] ?? "bg-ink/30"}`}
      />
      {statusLabels[status] ?? status}
    </span>
  );
}

// Nhãn thanh toán: chỉ hiện khi đã trả tiền hoặc đang chờ chuyển khoản
function PaymentBadge({ order }: { order: Order }) {
  if (order.isPaid) {
    return (
      <span className="inline-block rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">
        Đã thanh toán
      </span>
    );
  }
  if (needsPayment(order)) {
    return (
      <span className="inline-block rounded-full bg-ochre/40 px-2.5 py-0.5 text-xs font-semibold text-ink">
        Chờ thanh toán
      </span>
    );
  }
  return null;
}

// Một dòng "nhãn: giá trị" trong khối hướng dẫn chuyển khoản
function PayRow({ label, value }: { label: string; value: string }) {
  return (
    <div className="flex items-baseline justify-between gap-4 py-1.5 text-sm">
      <dt className="shrink-0 text-ink/55">{label}</dt>
      <dd className="break-words text-right font-semibold tabular-nums">
        {value}
      </dd>
    </div>
  );
}

type ChangeKind = "cancel" | "update_address";

// Khu vực khách tự hủy đơn / đổi thông tin nhận hàng
function OrderActions({
  order,
  onChanged,
}: {
  order: Order;
  onChanged: (kind: ChangeKind) => void;
}) {
  const [mode, setMode] = useState<"idle" | "confirmCancel" | "editAddress">(
    "idle",
  );
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [notice, setNotice] = useState<string | null>(null);
  const [form, setForm] = useState({
    customerName: order.customerName,
    phone: order.phone,
    address: order.address,
  });

  // Đơn đã hủy / hoàn thành: không cần khu vực này
  if (order.status === "cancelled" || order.status === "completed") {
    return null;
  }

  // Chỉ tự sửa/hủy khi đơn còn chờ xác nhận và chưa trả tiền
  const canSelfService = order.status === "pending" && !order.isPaid;

  if (!canSelfService) {
    let message =
      "Đơn đã được shop xử lý nên không thể tự hủy hay đổi địa chỉ. Cần hỗ trợ thì bạn liên hệ shop nhé.";
    if (order.status === "pending" && order.isPaid) {
      message =
        "Đơn này đã thanh toán nên bạn không tự hủy hoặc đổi địa chỉ được. Vui lòng liên hệ shop để được hỗ trợ.";
    }
    return (
      <p className="mt-6 rounded-xl bg-paper px-4 py-3 text-sm text-ink/65">
        {message}
      </p>
    );
  }

  async function send(body: Record<string, unknown>) {
    setBusy(true);
    setError(null);
    try {
      const res = await fetch(`/api/orders/${order.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const json = await res.json().catch(() => null);
      if (res.ok && json?.success) {
        return true;
      }
      setError(json?.message ?? "Có lỗi xảy ra, vui lòng thử lại");
      return false;
    } catch {
      setError("Không kết nối được máy chủ, vui lòng thử lại");
      return false;
    } finally {
      setBusy(false);
    }
  }

  async function handleCancel() {
    const ok = await send({ action: "cancel" });
    if (ok) {
      onChanged("cancel");
    }
  }

  async function handleSaveAddress(e: React.FormEvent) {
    e.preventDefault();
    const name = form.customerName.trim();
    const phone = form.phone.trim();
    const address = form.address.trim();
    if (!name || !phone || !address) {
      setError("Vui lòng điền đầy đủ họ tên, số điện thoại và địa chỉ");
      return;
    }
    const ok = await send({
      action: "update_address",
      customerName: name,
      phone,
      address,
    });
    if (ok) {
      setMode("idle");
      setNotice("Đã cập nhật thông tin nhận hàng.");
      onChanged("update_address");
    }
  }

  const inputClass =
    "w-full border-0 border-b border-ink/25 bg-transparent px-0 py-2 text-sm outline-none transition-colors focus:border-moss-dark";

  return (
    <div className="mt-6 border-t border-ink/10 pt-6">
      {notice && mode === "idle" && (
        <p className="mb-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          {notice}
        </p>
      )}

      {mode === "idle" && (
        <div className="flex flex-wrap items-center gap-3">
          <button
            type="button"
            onClick={() => {
              setForm({
                customerName: order.customerName,
                phone: order.phone,
                address: order.address,
              });
              setNotice(null);
              setError(null);
              setMode("editAddress");
            }}
            className="rounded-full border border-ink/25 px-5 py-2 text-sm font-semibold transition hover:border-ink hover:bg-paper"
          >
            Đổi thông tin nhận hàng
          </button>
          <button
            type="button"
            onClick={() => {
              setNotice(null);
              setError(null);
              setMode("confirmCancel");
            }}
            className="rounded-full px-5 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-50"
          >
            Hủy đơn
          </button>
          <p className="w-full text-xs text-ink/50 sm:w-auto">
            Chỉ làm được khi shop chưa xác nhận đơn.
          </p>
        </div>
      )}

      {mode === "confirmCancel" && (
        <div className="rounded-xl bg-red-50 p-4">
          <p className="text-sm font-semibold text-red-800">
            Bạn chắc chắn muốn hủy đơn #{order.id}?
          </p>
          <p className="mt-1 text-sm text-red-800/80">
            Đơn đã hủy không thể khôi phục. Các sản phẩm sẽ được trả lại kho,
            nếu vẫn muốn mua bạn cần đặt đơn mới.
          </p>
          {error && <p className="mt-2 text-sm text-red-700">{error}</p>}
          <div className="mt-4 flex flex-wrap gap-3">
            <button
              type="button"
              disabled={busy}
              onClick={handleCancel}
              className="rounded-full bg-red-700 px-5 py-2 text-sm font-semibold text-white transition hover:bg-red-800 disabled:opacity-60"
            >
              {busy ? "Đang hủy..." : "Xác nhận hủy"}
            </button>
            <button
              type="button"
              disabled={busy}
              onClick={() => {
                setMode("idle");
                setError(null);
              }}
              className="rounded-full border border-ink/25 bg-white px-5 py-2 text-sm font-semibold transition hover:bg-paper disabled:opacity-60"
            >
              Giữ đơn
            </button>
          </div>
        </div>
      )}

      {mode === "editAddress" && (
        <form onSubmit={handleSaveAddress} className="rounded-xl bg-paper p-4">
          <p className="text-xs font-semibold uppercase tracking-wider text-ink/45">
            Đổi thông tin nhận hàng
          </p>
          <div className="mt-3 grid gap-4 sm:grid-cols-2">
            <label className="block text-xs text-ink/55">
              Họ tên người nhận
              <input
                value={form.customerName}
                onChange={(e) =>
                  setForm((f) => ({ ...f, customerName: e.target.value }))
                }
                className={inputClass}
                autoComplete="name"
              />
            </label>
            <label className="block text-xs text-ink/55">
              Số điện thoại
              <input
                value={form.phone}
                onChange={(e) =>
                  setForm((f) => ({ ...f, phone: e.target.value }))
                }
                className={inputClass}
                inputMode="tel"
                autoComplete="tel"
              />
            </label>
          </div>
          <label className="mt-4 block text-xs text-ink/55">
            Địa chỉ giao hàng
            <textarea
              value={form.address}
              onChange={(e) =>
                setForm((f) => ({ ...f, address: e.target.value }))
              }
              rows={2}
              className={`${inputClass} resize-none`}
              autoComplete="street-address"
            />
          </label>
          {error && <p className="mt-3 text-sm text-red-700">{error}</p>}
          <div className="mt-4 flex flex-wrap gap-3">
            <button
              type="submit"
              disabled={busy}
              className="rounded-full bg-moss px-5 py-2 text-sm font-semibold text-white transition hover:bg-moss-dark disabled:opacity-60"
            >
              {busy ? "Đang lưu..." : "Lưu thay đổi"}
            </button>
            <button
              type="button"
              disabled={busy}
              onClick={() => {
                setMode("idle");
                setError(null);
              }}
              className="rounded-full border border-ink/25 bg-white px-5 py-2 text-sm font-semibold transition hover:bg-paper disabled:opacity-60"
            >
              Bỏ qua
            </button>
          </div>
        </form>
      )}
    </div>
  );
}

// Khung báo đơn đang trên đường giao
