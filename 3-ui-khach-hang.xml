<file path="src/components/AddToCartButton.tsx">
"use client";

import Link from "next/link";
import { useRouter } from "next/navigation";
import { useState } from "react";
import { useCart } from "../../lib/cart-context";

interface AddToCartButtonProps {
  productId: number;
  name: string;
  price: number;
  imageUrl: string | null;
  stock: number;
  isLoggedIn: boolean;
}

export default function AddToCartButton({
  productId,
  name,
  price,
  imageUrl,
  stock,
  isLoggedIn,
}: AddToCartButtonProps) {
  const router = useRouter();
  const { items, addItem } = useCart();
  const [quantity, setQuantity] = useState(1);
  const [draft, setDraft] = useState<string | null>(null); // đang gõ tay
  const [message, setMessage] = useState("");
  const [isWarning, setIsWarning] = useState(false);

  // Số lượng sản phẩm này đang có trong giỏ
  const inCart = items.find((i) => i.id === productId)?.quantity ?? 0;
  // Số còn có thể thêm được nữa
  const remaining = Math.max(stock - inCart, 0);
  const reachedMax = stock > 0 && remaining === 0;

  // Số lượng đang chọn, luôn nằm trong khoảng 1..remaining
  const qty = remaining > 0 ? Math.min(Math.max(quantity, 1), remaining) : 0;

  function commitDraft() {
    if (draft === null) return;
    const n = parseInt(draft, 10);
    if (!Number.isNaN(n) && n >= 1) {
      setQuantity(Math.min(n, Math.max(remaining, 1)));
    }
    setDraft(null);
  }

  function requireLogin() {
    if (!isLoggedIn) {
      router.push(`/login?next=/products/${productId}`);
      return true;
    }
    return false;
  }

  function handleAdd() {
    if (requireLogin()) return;

    const { added, limited } = addItem(
      { id: productId, name, price, imageUrl, stock },
      qty,
    );

    if (added === 0) {
      setIsWarning(true);
      setMessage(`Trong giỏ đã có tối đa ${stock} sản phẩm (hết tồn kho)`);
    } else if (limited) {
      setIsWarning(true);
      setMessage(`Chỉ còn ${stock} sản phẩm, đã thêm tối đa vào giỏ`);
    } else {
      setIsWarning(false);
      setMessage(`Đã thêm ${added} sản phẩm vào giỏ hàng`);
    }
    setQuantity(1);
  }

  function handleBuyNow() {
    if (requireLogin()) return;

    // Giỏ đã đầy sản phẩm này thì không thêm nữa, đi thẳng sang đặt hàng
    if (qty > 0) {
      addItem({ id: productId, name, price, imageUrl, stock }, qty);
    }
    router.push("/checkout");
  }

  const addLabel =
    stock === 0 ? "Hết hàng" : reachedMax ? "Đã thêm tối đa" : "Thêm vào giỏ";

  return (
    <div className="mt-8">
      {/* Chọn số lượng */}
      {stock > 0 && (
        <div className="mb-4 flex flex-wrap items-center gap-x-5 gap-y-2">
          <span className="text-sm font-semibold text-ink">Số lượng</span>

          <div className="inline-flex items-center overflow-hidden rounded-lg border border-ink/15 bg-white">
            <button
              type="button"
              aria-label="Giảm số lượng"
              onClick={() => setQuantity(Math.max(qty - 1, 1))}
              disabled={qty <= 1}
              className="h-11 w-11 text-lg text-ink transition hover:bg-blush disabled:cursor-not-allowed disabled:text-ink/30 disabled:hover:bg-transparent"
            >
              −
            </button>
            <input
              type="text"
              inputMode="numeric"
              aria-label="Số lượng"
              value={draft ?? String(qty)}
              disabled={remaining === 0}
              onChange={(e) => setDraft(e.target.value.replace(/\D/g, ""))}
              onBlur={commitDraft}
              onKeyDown={(e) => {
                if (e.key === "Enter") {
                  e.preventDefault();
                  commitDraft();
                }
              }}
              className="h-11 w-14 border-x border-ink/15 bg-transparent text-center text-base font-semibold text-ink outline-none focus:bg-blush/50 disabled:text-ink/30"
            />
            <button
              type="button"
              aria-label="Tăng số lượng"
              onClick={() => setQuantity(Math.min(qty + 1, remaining))}
              disabled={qty >= remaining}
              className="h-11 w-11 text-lg text-ink transition hover:bg-blush disabled:cursor-not-allowed disabled:text-ink/30 disabled:hover:bg-transparent"
            >
              +
            </button>
          </div>

          <span className="text-sm text-ink/55">
            {reachedMax
              ? `Giỏ của bạn đã có đủ ${stock} sản phẩm`
              : inCart > 0
                ? `Còn thêm được ${remaining} (đã có ${inCart} trong giỏ)`
                : `Còn ${stock} sản phẩm`}
          </span>
        </div>
      )}

      {/* Hai nút hành động */}
      <div className="grid gap-3 sm:grid-cols-2">
        <button
          type="button"
          onClick={handleAdd}
          disabled={stock === 0 || reachedMax}
          className="flex items-center justify-center gap-2.5 rounded-lg border-2 border-moss bg-white py-3.5 text-base font-semibold text-moss-dark transition hover:-translate-y-0.5 hover:bg-blush active:translate-y-0 disabled:translate-y-0 disabled:cursor-not-allowed disabled:border-ink/15 disabled:bg-ink/10 disabled:text-ink/45 disabled:hover:bg-ink/10"
        >
          {/* Biểu tượng giỏ hàng */}
          <svg
            aria-hidden
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth={1.9}
            strokeLinecap="round"
            strokeLinejoin="round"
            className="h-5 w-5"
          >
            <path d="M3 4h2l2.2 10.2a1.5 1.5 0 0 0 1.5 1.2h8.1a1.5 1.5 0 0 0 1.5-1.1L20 8H6.2" />
            <circle cx="9.5" cy="19.5" r="1.2" />
            <circle cx="17" cy="19.5" r="1.2" />
          </svg>
          {addLabel}
        </button>

        <button
          type="button"
          onClick={handleBuyNow}
          disabled={stock === 0}
          className="flex items-center justify-center gap-2.5 rounded-lg bg-moss py-3.5 text-base font-semibold text-white shadow-warm transition hover:-translate-y-0.5 hover:bg-moss-dark hover:shadow-warm-lg active:translate-y-0 disabled:translate-y-0 disabled:cursor-not-allowed disabled:bg-ink/15 disabled:text-ink/45 disabled:shadow-none"
        >
          Đặt hàng ngay
          <span aria-hidden>→</span>
        </button>
      </div>

      {/* Thông báo sau khi thêm vào giỏ */}
      <div role="status" aria-live="polite">
        {message && (
          <p
            className={`mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg px-4 py-2.5 text-sm ${
              isWarning
                ? "border border-ochre bg-ochre/20 text-ink"
                : "border border-peach bg-blush/60 text-moss-dark"
            }`}
          >
            <span className="font-medium">
              {isWarning ? "⚠ " : "✓ "}
              {message}
            </span>
            {isLoggedIn && (
              <Link
                href="/cart"
                className="font-semibold underline decoration-2 underline-offset-4 hover:text-moss"
              >
                Xem giỏ hàng →
              </Link>
            )}
          </p>
        )}
      </div>

      {/* Nhắc khách chưa đăng nhập */}
      {!isLoggedIn && stock > 0 && (
        <p className="mt-3 text-center text-sm text-ink/55">
          Bạn cần đăng nhập để đặt hàng hoặc thêm vào giỏ.
        </p>
      )}
    </div>
  );
}
</file>

<file path="src/components/ProductCard.tsx">
import Link from "next/link";
import Reveal from "./Reveal";
import WishlistButton from "./WishlistButton";

type ProductCardProps = {
  id: number;
  name: string;
  price: number;
  imageUrl: string | null;
  stock: number;
  index?: number; // Thứ tự thẻ trong danh sách, dùng để hiện lần lượt
};

// Từ ngưỡng này trở xuống thì báo "Chỉ còn ..." để khách biết món sắp hết
const LOW_STOCK = 5;

export default function ProductCard({
  id,
  name,
  price,
  imageUrl,
  stock,
  index = 0,
}: ProductCardProps) {
  const outOfStock = stock <= 0;
  const lowStock = !outOfStock && stock <= LOW_STOCK;

  const formattedPrice = new Intl.NumberFormat("vi-VN", {
    style: "currency",
    currency: "VND",
  }).format(price);

  return (
    // Trễ theo cột (tối đa 4 cột) để cả hàng hiện lần lượt, không bị chờ lâu ở các hàng dưới
    <Reveal delay={(index % 4) * 0.08}>
      {/* Thẻ bọc ngoài: giữ hiệu ứng nổi lên và làm mốc cho nút trái tim */}
      <div className="group relative transition duration-300 hover:-translate-y-1">
        <Link
          href={`/products/${id}`}
          className="block rounded-lg border border-peach/50 bg-white p-2 shadow-warm transition duration-300 group-hover:border-moss group-hover:shadow-warm-lg"
        >
          <div className="relative aspect-square w-full overflow-hidden bg-blush/40">
            {imageUrl ? (
              // eslint-disable-next-line @next/next/no-img-element
              <img
                src={imageUrl}
                alt={name}
                className={`h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 ${
                  outOfStock ? "opacity-60 grayscale" : ""
                }`}
              />
            ) : (
              <div className="flex h-full w-full items-center justify-center text-sm text-ink/40">
                Không có ảnh
              </div>
            )}

            {/* Nhãn trạng thái: hết hàng hoặc sắp hết */}
            {outOfStock && (
              <span className="absolute left-0 top-3 bg-ink px-3 py-1 text-xs font-medium uppercase tracking-wider text-paper">
                Hết hàng
              </span>
            )}
            {lowStock && (
              <span className="absolute left-0 top-3 bg-ochre px-3 py-1 text-xs font-semibold uppercase tracking-wider text-ink">
                Chỉ còn {stock}
              </span>
            )}

            {/* Dải trượt lên khi rê chuột */}
            <span className="absolute inset-x-0 bottom-0 translate-y-full bg-moss py-2.5 text-center text-sm font-medium text-white transition duration-300 group-hover:translate-y-0">
              Xem chi tiết →
            </span>
          </div>

          <div className="px-1.5 pb-1.5 pt-3">
            <h3 className="line-clamp-2 min-h-10 text-sm font-medium leading-5 text-ink transition-colors group-hover:text-moss-dark">
              {name}
            </h3>
            <p className="mt-1.5 text-base font-semibold text-moss-dark">
              {formattedPrice}
            </p>
          </div>
        </Link>

        {/* Nút trái tim nằm NGOÀI Link để bấm không bị chuyển trang */}
        <div className="absolute right-4 top-4 z-10">
          <WishlistButton productId={id} variant="icon" />
        </div>
      </div>
    </Reveal>
  );
}
