<file path="src/components/WishlistButton.tsx">
"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { useWishlist } from "../../lib/wishlist-context";

const HEART =
  "M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z";

export default function WishlistButton({
  productId,
  variant = "icon",
}: {
  productId: number;
  variant?: "icon" | "full";
}) {
  const router = useRouter();
  const { isLiked, toggle } = useWishlist();
  const [busy, setBusy] = useState(false);
  const liked = isLiked(productId);

  async function handleClick(e: React.MouseEvent) {
    // Nút nằm trong thẻ có link: bấm tim thì không được chuyển sang trang chi tiết
    e.preventDefault();
    e.stopPropagation();
    if (busy) return;

    setBusy(true);
    const result = await toggle(productId);
    setBusy(false);

    if (result === "login") {
      const here = window.location.pathname + window.location.search;
      router.push(`/login?next=${encodeURIComponent(here)}`);
    }
  }

  const heart = (
    <svg
      aria-hidden
      viewBox="0 0 24 24"
      strokeWidth={1.8}
      strokeLinecap="round"
      strokeLinejoin="round"
      className={`h-5 w-5 shrink-0 transition-transform duration-200 ${
        liked
          ? "scale-110 fill-moss stroke-moss-dark"
          : "fill-none stroke-current"
      }`}
    >
      <path d={HEART} />
    </svg>
  );

  if (variant === "full") {
    return (
      <button
        type="button"
        onClick={handleClick}
        aria-pressed={liked}
        disabled={busy}
        className={`inline-flex items-center justify-center gap-2 rounded-lg border px-5 py-3 text-sm font-medium transition-colors disabled:opacity-60 ${
          liked
            ? "border-moss bg-blush text-moss-dark"
            : "border-peach bg-white text-ink/75 hover:border-moss hover:text-moss-dark"
        }`}
      >
        {heart}
        {liked ? "Đã yêu thích" : "Yêu thích"}
      </button>
    );
  }

  return (
    <button
      type="button"
      onClick={handleClick}
      aria-pressed={liked}
      aria-label={liked ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích"}
      disabled={busy}
      className={`flex h-9 w-9 items-center justify-center rounded-full bg-white/90 shadow-warm transition active:scale-90 disabled:opacity-60 ${
        liked ? "text-moss-dark" : "text-ink/60 hover:text-moss-dark"
      }`}
    >
      {heart}
    </button>
  );
}
</file>

<file path="src/app/products/page.tsx">
import ProductSearch from "../../components/ProductSearch";
import { prisma } from "../../../lib/prisma";
import ProductCard from "../../components/ProductCard";
import Reveal from "../../components/Reveal";
import Link from "next/link";

const PAGE_SIZE = 12;

const SORT_OPTIONS: Record<string, string> = {
  "": "Mặc định",
  newest: "Mới nhất",
  price_asc: "Giá tăng dần",
  price_desc: "Giá giảm dần",
  popular: "Bán chạy nhất",
};

// Đọc giá từ URL: chỉ nhận số nguyên không âm
function parsePrice(v?: string): number | null {
  if (!v) return null;
  const n = Number(v);
  return Number.isFinite(n) && n >= 0 ? Math.floor(n) : null;
}

export default async function ProductsPage({
  searchParams,
}: {
  searchParams: Promise<{
    category?: string;
    q?: string;
    sort?: string;
    min?: string;
    max?: string;
    page?: string;
  }>;
}) {
  const sp = await searchParams;

  // Bỏ qua giá trị category không hợp lệ (vd: ?category=abc)
  const categoryId = Number(sp.category);
  const validCategoryId =
    Number.isInteger(categoryId) && categoryId > 0 ? categoryId : null;

  const keyword = sp.q?.trim() ?? "";
  const sort = sp.sort && sp.sort in SORT_OPTIONS ? sp.sort : "";

  let minPrice = parsePrice(sp.min);
  let maxPrice = parsePrice(sp.max);
  // Nhập ngược (min > max) thì tự đổi chỗ
  if (minPrice !== null && maxPrice !== null && minPrice > maxPrice) {
    [minPrice, maxPrice] = [maxPrice, minPrice];
  }

  const [categories, allProducts] = await Promise.all([
    prisma.category.findMany({ orderBy: { name: "asc" } }),
    prisma.product.findMany({
      where: {
        isActive: true,
        ...(validCategoryId ? { categoryId: validCategoryId } : {}),
      },
      orderBy: { id: "asc" },
    }),
  ]);

  // Lọc theo tên ở đây thay vì trong SQL: collation của MariaDB bỏ qua dấu
  // nên "thỏ" sẽ khớp cả "thơm". So sánh bằng JS thì phân biệt dấu,
  // chỉ bỏ qua hoa/thường.
  const normalize = (s: string) => s.normalize("NFC").toLowerCase();
  let products = allProducts.filter((p) => {
    if (keyword && !normalize(p.name).includes(normalize(keyword)))
      return false;
    const price = Number(p.price);
    if (minPrice !== null && price < minPrice) return false;
    if (maxPrice !== null && price > maxPrice) return false;
    return true;
  });

  // Sắp xếp
  if (sort === "newest") {
    products = [...products].sort((a, b) => b.id - a.id);
  } else if (sort === "price_asc") {
    products = [...products].sort((a, b) => Number(a.price) - Number(b.price));
  } else if (sort === "price_desc") {
    products = [...products].sort((a, b) => Number(b.price) - Number(a.price));
  } else if (sort === "popular") {
    // Tổng số lượng bán ra của các đơn chưa hủy
    const sold = await prisma.orderItem.groupBy({
      by: ["productId"],
      where: { order: { status: { not: "cancelled" } } },
      _sum: { quantity: true },
    });
    const soldMap = new Map(
      sold.map((s) => [s.productId, s._sum.quantity ?? 0]),
    );
    products = [...products].sort(
      (a, b) =>
        (soldMap.get(b.id) ?? 0) - (soldMap.get(a.id) ?? 0) || a.id - b.id,
    );
  }

  // Phân trang (cắt sau khi đã lọc và sắp xếp)
  const total = products.length;
  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
  const rawPage = Number(sp.page);
  const page =
    Number.isInteger(rawPage) && rawPage >= 1
      ? Math.min(rawPage, totalPages)
      : 1;
  const start = (page - 1) * PAGE_SIZE;
  const pageProducts = products.slice(start, start + PAGE_SIZE);

  // Tạo link trong trang /products, giữ lại mọi bộ lọc hiện tại,
  // chỉ ghi đè những giá trị truyền vào
  const current = {
    category: validCategoryId,
    q: keyword,
    sort,
    min: minPrice,
    max: maxPrice,
    page,
  };
  function buildHref(override: Partial<typeof current> = {}) {
    const m = { ...current, ...override };
    const params = new URLSearchParams();
    if (m.category) params.set("category", String(m.category));
    if (m.q) params.set("q", m.q);
    if (m.sort) params.set("sort", m.sort);
    if (m.min !== null) params.set("min", String(m.min));
    if (m.max !== null) params.set("max", String(m.max));
    if (m.page > 1) params.set("page", String(m.page));
    const qs = params.toString();
    return qs ? `/products?${qs}` : "/products";
  }

  const hasFilter = !!(
    keyword ||
    sort ||
    minPrice !== null ||
    maxPrice !== null
  );

  // Kiểu chung cho mục danh mục: đang chọn thì nền nâu mận, chưa chọn thì viền mảnh
  const tabClass = (active: boolean) =>
    `rounded-lg border px-4 py-2 text-sm font-medium transition-colors ${
      active
        ? "border-ink bg-ink text-paper"
        : "border-peach bg-white text-ink/70 hover:border-moss hover:text-moss-dark"
    }`;

  const inputClass =
    "rounded-lg border border-peach bg-white px-3 py-2 text-sm text-ink outline-none focus:border-moss";

  // Dãy số trang: luôn có trang đầu, cuối và 1 trang mỗi bên trang hiện tại
  const pageNumbers: (number | "...")[] = [];
  for (let i = 1; i <= totalPages; i++) {
    if (i === 1 || i === totalPages || Math.abs(i - page) <= 1) {
      pageNumbers.push(i);
    } else if (pageNumbers[pageNumbers.length - 1] !== "...") {
      pageNumbers.push("...");
    }
  }

  return (
    <main className="mx-auto max-w-6xl px-4 pb-20 pt-10">
      {/* Đầu trang: nền hồng nhạt, tiêu đề + mô tả + số món */}
      <Reveal>
        <header className="relative overflow-hidden rounded-2xl bg-blush px-6 py-10 sm:px-10">
          <span
            aria-hidden
            className="pointer-events-none absolute -right-2 -top-6 select-none font-heading text-[9rem] font-semibold leading-none text-white/50 sm:text-[12rem]"
          >
            {total}
          </span>
          <div className="relative max-w-lg">
            <p className="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-moss-dark">
              <span className="h-px w-8 bg-moss-dark" />
              Cửa hàng
            </p>
            <h1 className="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">
              Sản phẩm
            </h1>
            <p className="mt-3 text-sm leading-relaxed text-ink/70">
              Mỗi món đều làm bằng tay, mẻ nhỏ nên số lượng có hạn. Hết là hết,
              mẻ sau có thể sẽ hơi khác một chút.
            </p>
          </div>
        </header>
      </Reveal>

      <div className="mt-8 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
        {/* Danh mục: đổi danh mục thì về trang 1 */}
        <nav className="flex flex-wrap gap-2">
          <Link
            href={buildHref({ category: null, page: 1 })}
            className={tabClass(!validCategoryId)}
          >
            Tất cả
          </Link>
          {categories.map((c) => (
            <Link
              key={c.id}
              href={buildHref({ category: c.id, page: 1 })}
              className={tabClass(validCategoryId === c.id)}
            >
              {c.name}
            </Link>
          ))}
        </nav>

        {/* Ô tìm kiếm: giữ lại danh mục đang chọn */}
        <ProductSearch initialKeyword={keyword} categoryId={validCategoryId} />
      </div>

      {/* Sắp xếp + lọc giá: form GET, gửi lại cả danh mục và từ khóa */}
      <form
        method="GET"
        action="/products"
        className="mt-5 flex flex-wrap items-end gap-3 rounded-xl bg-white p-4 shadow-warm"
      >
        {validCategoryId && (
          <input type="hidden" name="category" value={validCategoryId} />
        )}
        {keyword && <input type="hidden" name="q" value={keyword} />}

        <label className="flex flex-col gap-1 text-xs font-semibold uppercase tracking-wider text-ink/55">
          Sắp xếp
          <select name="sort" defaultValue={sort} className={inputClass}>
            {Object.entries(SORT_OPTIONS).map(([value, label]) => (
              <option key={value} value={value}>
                {label}
              </option>
            ))}
          </select>
        </label>

        <label className="flex flex-col gap-1 text-xs font-semibold uppercase tracking-wider text-ink/55">
          Giá từ (đ)
          <input
            type="number"
            name="min"
            min={0}
            step={1000}
            defaultValue={minPrice ?? ""}
            placeholder="0"
            className={`${inputClass} w-32`}
          />
        </label>

        <label className="flex flex-col gap-1 text-xs font-semibold uppercase tracking-wider text-ink/55">
          Đến (đ)
          <input
            type="number"
            name="max"
            min={0}
            step={1000}
            defaultValue={maxPrice ?? ""}
            placeholder="500000"
            className={`${inputClass} w-32`}
          />
        </label>

        <button
          type="submit"
          className="rounded-lg bg-ink px-5 py-2 text-sm font-medium text-paper transition hover:bg-moss-dark"
        >
          Áp dụng
        </button>

        {hasFilter && (
          <Link
            href={buildHref({ q: "", sort: "", min: null, max: null, page: 1 })}
            className="px-1 py-2 text-sm font-medium text-moss-dark underline underline-offset-4 hover:text-moss"
          >
            Xóa bộ lọc
          </Link>
        )}
      </form>

      {keyword && (
        <p className="mt-6 text-sm text-ink/65">
          Kết quả cho &ldquo;
          <span className="font-semibold text-ink">{keyword}</span>&rdquo;:{" "}
          {total} sản phẩm ·{" "}
          <Link
            href={buildHref({ q: "", page: 1 })}
            className="font-medium text-moss-dark underline underline-offset-4 hover:text-moss"
          >
            Xóa tìm kiếm
          </Link>
        </p>
      )}

      <p className="mt-8 text-sm text-ink/55">
        {total === 0 ? (
          "Không có món nào"
        ) : (
          <>
            Đang hiển thị{" "}
            <span className="font-semibold text-ink">
              {start + 1}–{start + pageProducts.length}
            </span>{" "}
            trên <span className="font-semibold text-ink">{total}</span> món
          </>
        )}
      </p>

      <section className="mt-4 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
        {pageProducts.map((p, i) => (
          <ProductCard
            key={p.id}
            index={i}
            id={p.id}
            name={p.name}
            price={Number(p.price)}
            imageUrl={p.imageUrl}
            stock={p.stock}
          />
        ))}
      </section>

      {total === 0 && (
        <div className="mt-10 rounded-2xl border-2 border-dashed border-peach bg-white px-6 py-14 text-center">
          <p className="font-heading text-xl font-semibold">
            Chưa thấy món nào
          </p>
          <p className="mt-2 text-sm text-ink/65">
            {hasFilter
              ? "Không có món nào khớp với bộ lọc này."
              : "Danh mục này chưa có món nào."}
          </p>
          <Link
            href="/products"
            className="mt-5 inline-block rounded-lg bg-ink px-6 py-3 text-sm font-medium text-paper transition hover:bg-moss-dark"
          >
            Xem tất cả sản phẩm
          </Link>
        </div>
      )}

      {/* Phân trang */}
      {totalPages > 1 && (
        <nav
          aria-label="Phân trang"
          className="mt-12 flex flex-wrap items-center justify-center gap-2"
        >
          {page > 1 && (
            <Link
              href={buildHref({ page: page - 1 })}
              className={tabClass(false)}
            >
              ← Trước
            </Link>
          )}
          {pageNumbers.map((n, idx) =>
            n === "..." ? (
              <span key={`dots-${idx}`} className="px-1 text-ink/40">
                …
              </span>
            ) : (
              <Link
                key={n}
                href={buildHref({ page: n })}
                aria-current={n === page ? "page" : undefined}
                className={tabClass(n === page)}
              >
                {n}
              </Link>
            ),
          )}
          {page < totalPages && (
            <Link
              href={buildHref({ page: page + 1 })}
              className={tabClass(false)}
            >
              Sau →
            </Link>
          )}
        </nav>
      )}
    </main>
  );
}
</file>

<file path="src/app/register/page.tsx">
"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";

// Nền trắng cố định, kể cả khi trình duyệt tự điền (autofill hay tô xanh nhạt)
const inputClass =
  "mt-1.5 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-ink outline-none transition placeholder:text-ink/35 focus:border-moss focus:ring-2 focus:ring-moss/20 [&:-webkit-autofill]:[box-shadow:0_0_0_1000px_white_inset] [&:-webkit-autofill]:[-webkit-text-fill-color:var(--color-ink)]";

const labelClass = "text-sm font-medium text-ink/75";

const MIN_LENGTH = 6;

// Chấm độ mạnh mật khẩu để gợi ý cho khách (không thay đổi quy tắc hợp lệ)
function strengthOf(password: string) {
  if (password.length === 0) return { score: 0, label: "" };
  if (password.length < MIN_LENGTH) {
    return { score: 0, label: `Cần tối thiểu ${MIN_LENGTH} ký tự` };
  }
  let score = 1;
  if (password.length >= 8) score++;
  if (/[a-zA-Z]/.test(password) && /\d/.test(password)) score++;
  if (
    /[^a-zA-Z0-9]/.test(password) ||
    (/[A-Z]/.test(password) && /[a-z]/.test(password))
  ) {
    score++;
  }
  return { score, label: ["", "Yếu", "Tạm được", "Khá", "Mạnh"][score] };
}

const barColor = [
  "bg-ink/10",
  "bg-ochre",
  "bg-ochre",
  "bg-emerald-500",
  "bg-emerald-600",
];

const iconProps = {
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  strokeWidth: 1.8,
  strokeLinecap: "round" as const,
  strokeLinejoin: "round" as const,
  className: "h-5 w-5",
};

const PERKS = [
  {
    title: "Đặt hàng nhanh",
    icon: (
      <svg {...iconProps}>
        <path d="M3 4h2l2.2 10.2a1.5 1.5 0 0 0 1.5 1.2h8.1a1.5 1.5 0 0 0 1.5-1.1L20 8H6.2" />
        <circle cx="9.5" cy="19.5" r="1.2" />
        <circle cx="17" cy="19.5" r="1.2" />
      </svg>
    ),
  },
  {
    title: "Theo dõi đơn hàng",
    icon: (
      <svg {...iconProps}>
        <path d="M3 8l9-5 9 5v8l-9 5-9-5z" />
        <path d="M3 8l9 5 9-5M12 13v8" />
      </svg>
    ),
  },
  {
    title: "Đánh giá sản phẩm",
    icon: (
      <svg {...iconProps}>
        <path d="M12 3.5l2.7 5.5 6 .9-4.4 4.2 1 6-5.3-2.8-5.3 2.8 1-6L3.3 9.9l6-.9z" />
      </svg>
    ),
  },
];

export default function RegisterPage() {
  const router = useRouter();
  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  const strength = strengthOf(password);

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setError("");
    setLoading(true);

    try {
      const res = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, password }),
      });
      const data = await res.json();

      if (!data.success) {
        setError(data.message);
        return;
      }

      router.push("/");
      router.refresh();
    } catch {
      setError("Không thể kết nối tới server, vui lòng thử lại");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="mx-auto max-w-lg px-4 pb-24 pt-12 sm:pt-16">
      {/* Đầu trang */}
      <div className="text-center">
        <span
          aria-hidden
          className="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-moss font-heading text-xl font-semibold text-white"
        >
          C
        </span>
        <h1 className="mt-5 text-4xl font-semibold leading-tight sm:text-5xl">
          Tạo tài khoản
        </h1>
        <p className="mt-3 text-ink/65">
          Chỉ cần vài thông tin để bắt đầu mua sắm tại Cỏ May.
        </p>
      </div>

      {/* Form */}
      <form
        onSubmit={handleSubmit}
        className="mt-10 space-y-5 rounded-3xl bg-white p-7 sm:p-9"
      >
        <div>
          <label htmlFor="name" className={labelClass}>
            Họ tên
          </label>
          <input
            id="name"
            type="text"
            autoComplete="name"
            value={name}
            onChange={(e) => setName(e.target.value)}
            required
            placeholder="Nguyễn Văn A"
            className={inputClass}
          />
        </div>

        <div>
          <label htmlFor="email" className={labelClass}>
            Email
          </label>
          <input
            id="email"
            type="email"
            autoComplete="email"
            value={email}
            onChange={(e) => setEmail(e.target.value)}
            required
            placeholder="ban@example.com"
            className={inputClass}
          />
        </div>

        <div>
          <label htmlFor="password" className={labelClass}>
            Mật khẩu
          </label>
          <div className="relative">
            <input
              id="password"
              type={showPassword ? "text" : "password"}
              autoComplete="new-password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              required
              minLength={MIN_LENGTH}
              placeholder={`Tối thiểu ${MIN_LENGTH} ký tự`}
              className={`${inputClass} pr-16`}
            />
            <button
              type="button"
              onClick={() => setShowPassword((v) => !v)}
              aria-label={showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu"}
              className="absolute right-3 top-1/2 mt-[3px] -translate-y-1/2 rounded-md px-2 py-1 text-xs font-semibold text-moss-dark transition-colors hover:bg-blush"
            >
              {showPassword ? "Ẩn" : "Hiện"}
            </button>
          </div>

          {/* Thanh độ mạnh mật khẩu */}
          <div aria-live="polite" className="mt-3 min-h-9">
            {password && (
              <>
                <div className="flex gap-1.5">
                  {[1, 2, 3, 4].map((n) => (
                    <span
                      key={n}
                      className={`h-1.5 flex-1 rounded-full transition-colors duration-300 ${
                        n <= strength.score
                          ? barColor[strength.score]
                          : "bg-ink/10"
                      }`}
                    />
                  ))}
                </div>
                <p className="mt-1.5 text-xs text-ink/60">{strength.label}</p>
              </>
            )}
          </div>
        </div>

        {error && (
          <p
            role="alert"
            className="rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800"
          >
            {error}
          </p>
        )}

        <button
          type="submit"
          disabled={loading}
          className="w-full rounded-xl bg-moss py-3.5 font-semibold text-white transition hover:bg-moss-dark disabled:cursor-not-allowed disabled:opacity-60"
        >
          {loading ? "Đang xử lý..." : "Tạo tài khoản"}
        </button>

        <p className="pt-1 text-center text-sm text-ink/65">
          Đã có tài khoản?{" "}
          <Link
            href="/login"
            className="font-semibold text-ink underline decoration-moss decoration-2 underline-offset-4 transition-colors hover:text-moss-dark"
          >
            Đăng nhập
          </Link>
        </p>
      </form>

      {/* Lợi ích khi có tài khoản */}
      <ul className="mt-10 grid grid-cols-3 gap-3 text-center">
        {PERKS.map((perk) => (
          <li key={perk.title} className="flex flex-col items-center gap-2.5">
            <span
              aria-hidden
              className="flex h-11 w-11 items-center justify-center rounded-full bg-blush text-moss-dark"
            >
              {perk.icon}
            </span>
            <span className="text-xs font-medium leading-snug text-ink/70 sm:text-sm">
              {perk.title}
            </span>
          </li>
        ))}
      </ul>
    </main>
  );
}
</file>

<file path="src/components/ProductSearch.tsx">
"use client";

import { useEffect, useRef, useState } from "react";
import { useRouter, useSearchParams } from "next/navigation";

type ProductSearchProps = {
  initialKeyword: string;
  categoryId: number | null;
};

const DEBOUNCE_MS = 300;

export default function ProductSearch({ initialKeyword }: ProductSearchProps) {
  const router = useRouter();
  const searchParams = useSearchParams();
  const [value, setValue] = useState(initialKeyword);

  // Từ khóa gần nhất đã đẩy lên URL (hoặc đến từ URL). Dùng để tránh
  // đẩy trùng và để không ghi đè chữ đang gõ dở khi trang tải lại.
  const lastPushed = useRef(initialKeyword);

  // Từ khóa trên URL đổi do nguyên nhân bên ngoài (ví dụ bấm "Xóa tìm kiếm")
  // thì cập nhật lại ô nhập.
  useEffect(() => {
    if (initialKeyword !== lastPushed.current) {
      lastPushed.current = initialKeyword;
      setValue(initialKeyword);
    }
  }, [initialKeyword]);

  // Gõ xong khoảng 0,3 giây thì tự cập nhật URL: giữ nguyên category, sort,
  // min, max đang có; chỉ thay q và đưa về trang 1.
  useEffect(() => {
    const trimmed = value.trim();
    if (trimmed === lastPushed.current) return;

    const timer = setTimeout(() => {
      lastPushed.current = trimmed;
      const params = new URLSearchParams(searchParams.toString());
      if (trimmed) params.set("q", trimmed);
      else params.delete("q");
      params.delete("page");
      const qs = params.toString();
      router.replace(qs ? `/products?${qs}` : "/products", { scroll: false });
    }, DEBOUNCE_MS);

    return () => clearTimeout(timer);
  }, [value, searchParams, router]);

  return (
    <form
      onSubmit={(e) => e.preventDefault()}
      role="search"
      className="flex w-full items-center gap-2.5 rounded-lg border border-peach bg-white px-3.5 transition-colors focus-within:border-moss focus-within:ring-2 focus-within:ring-moss/20 md:max-w-xs"
    >
      {/* Biểu tượng kính lúp */}
      <svg
        aria-hidden
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        strokeWidth={1.8}
        strokeLinecap="round"
