  comment: z
    .string()
    .trim()
    .max(1000, "Nhận xét tối đa 1000 ký tự")
    .transform((v) => (v === "" ? null : v))
    .nullable()
    .optional(),
});

export type CreateReviewInput = z.infer<typeof createReviewSchema>;

