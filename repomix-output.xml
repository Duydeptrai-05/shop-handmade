"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useCart } from "../../../lib/cart-context";
import { formatVND } from "../../../lib/format";
import { SHIPPING_FEE } from "../../../lib/shipping"; // VOUCHER
import {
  createOrderSchema,
  type PaymentMethodValue,
} from "../../../lib/validation/order";

type FieldName =
  | "customerName"
  | "phone"
  | "address"
  | "paymentMethod"
  | "items"
  | "discountCode" // VOUCHER
  | "shippingCode"; // VOUCHER
type FieldErrors = Partial<Record<FieldName, string[]>>;

// VOUCHER: kết quả xem trước tiền từ /api/orders/preview
type Preview = {
  subtotal: number;
  shippingFee: number;
  discountAmount: number;
  shippingDiscount: number;
  total: number;
  discountVoucher: { code: string; description: string | null } | null;
  shippingVoucher: { code: string; description: string | null } | null;
  errors: { discountCode?: string; shippingCode?: string };
};

// Địa chỉ đã lưu trong sổ địa chỉ (từ /api/account/addresses)
type SavedAddress = {
  id: number;
  recipientName: string;
  phone: string;
  address: string;
  isDefault: boolean;
};

// VOUCHER KHÁCH: voucher đang dùng được, lấy từ /api/vouchers
type VoucherItem = {
  id: number;
  code: string;
  description: string | null;
  type: "discount" | "shipping";
  discountKind: "percent" | "fixed";
  value: number;
  maxDiscount: number | null;
  minOrderValue: number;
  expiresAt: string | null;
  remaining: number | null;
  soldOut: boolean;
  usedByMe: boolean;
};

// Chữ lớn trên "cuống vé"
function voucherBadge(v: VoucherItem) {
  if (v.discountKind === "percent") {
    return v.type === "shipping" && v.value >= 100 ? "FREESHIP" : `${v.value}%`;
  }
  return v.value % 1000 === 0 ? `${v.value / 1000}K` : formatVND(v.value);
}

// Dòng điều kiện nhỏ phía dưới
function voucherNotes(v: VoucherItem) {
  const parts: string[] = [];
  if (v.minOrderValue > 0) parts.push(`Đơn từ ${formatVND(v.minOrderValue)}`);
  if (v.discountKind === "percent" && v.maxDiscount !== null) {
    parts.push(`Giảm tối đa ${formatVND(v.maxDiscount)}`);
  }
  if (v.expiresAt) {
    parts.push(`HSD ${new Date(v.expiresAt).toLocaleDateString("vi-VN")}`);
  }
  if (v.remaining !== null && v.remaining <= 10 && !v.soldOut) {
    parts.push(`Còn ${v.remaining} lượt`);
  }
  return parts.join(" · ");
}

// Thông tin tài khoản nhận tiền, đọc từ .env (NEXT_PUBLIC_ để dùng được ở client)
const BANK = {
  id: process.env.NEXT_PUBLIC_BANK_ID ?? "",
  name: process.env.NEXT_PUBLIC_BANK_NAME ?? "",
  account: process.env.NEXT_PUBLIC_BANK_ACCOUNT ?? "",
  holder: process.env.NEXT_PUBLIC_BANK_HOLDER ?? "",
};

// Ô nhập nền trắng bo nhẹ; có lỗi thì viền đỏ
function fieldClass(hasError: boolean) {
  return `mt-1.5 w-full rounded-xl border bg-white px-4 py-3 text-ink outline-none transition placeholder:text-ink/35 ${
    hasError
      ? "border-red-600 ring-2 ring-red-600/15"
      : "border-ink/15 focus:border-moss focus:ring-2 focus:ring-moss/20"
