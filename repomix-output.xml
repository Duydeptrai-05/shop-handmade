                        <Link
                          href={`/admin/orders/${order.id}/invoice`}
                          target="_blank"
                          className="rounded-full border border-ink/20 px-5 py-2 text-sm font-medium transition hover:bg-ink hover:text-paper"
                        >
                          🖨 In hóa đơn
                        </Link>

                        {unpaid && (
                          <motion.button
                            type="button"
                            whileHover={{ y: -2 }}
                            whileTap={{ scale: 0.95 }}
                            disabled={busyId === order.id}
                            onClick={() => confirmPayment(order)}
                            className="rounded-full bg-ochre px-5 py-2 text-sm font-semibold text-ink shadow transition hover:shadow-md disabled:opacity-50"
                          >
                            {busyId === order.id
                              ? "Đang xử lý..."
                              : "Xác nhận đã nhận tiền"}
                          </motion.button>
                        )}

                        {orderActions.map((a) => (
                          <motion.button
                            key={a.to}
                            type="button"
                            whileHover={{ y: -2 }}
                            whileTap={{ scale: 0.95 }}
                            disabled={busyId === order.id}
                            onClick={() => changeStatus(order, a.to)}
                            className={`rounded-full px-5 py-2 text-sm font-medium transition disabled:opacity-50 ${
                              a.danger
                                ? "border border-red-700 text-red-700 hover:bg-red-700 hover:text-white"
                                : "bg-ink text-paper shadow hover:shadow-md"
                            }`}
                          >
                            {busyId === order.id ? "Đang xử lý..." : a.label}
                          </motion.button>
                        ))}
                      </div>
                    </div>
                  </div>
                </motion.li>
              );
            })}
          </AnimatePresence>
        </ul>
      )}
    </main>
  );
}
