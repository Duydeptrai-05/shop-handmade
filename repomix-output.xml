          </p>
        )}
      </div>
    </div>
  );
}

// Chi tiết một đơn: dùng cho khung bên phải (máy tính) và phần mở rộng (điện thoại)
function OrderDetail({
  order,
  onChanged,
}: {
  order: Order;
  onChanged: (kind: ChangeKind) => void;
}) {
  const stepIndex = FLOW.indexOf(order.status);
  const cancelled = order.status === "cancelled";
  const total = orderTotal(order);
  const itemsTotal = itemsSubtotal(order);
  const shippingFee = Number(order.shippingFee ?? 0);
  const discountAmount = Number(order.discountAmount ?? 0);
  const shippingDiscount = Number(order.shippingDiscount ?? 0);

  return (
    <div>
      <div className="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p className="text-xs font-semibold uppercase tracking-wider text-ink/45">
            Đơn hàng
          </p>
          <p className="font-heading text-5xl font-semibold leading-none text-moss-dark">
            #{order.id}
          </p>
          <p className="mt-2 text-sm text-ink/55">
            {new Date(order.createdAt).toLocaleString("vi-VN")}
          </p>
        </div>
        <div className="rounded-full bg-paper px-3.5 py-1.5">
          <StatusBadge status={order.status} />
        </div>
      </div>

      {/* Các chặng của đơn */}
      {stepIndex >= 0 && (
        <ol className="mt-8 grid grid-cols-4">
          {FLOW.map((step, i) => (
            <li key={step} className="relative flex flex-col items-center">
              {i < FLOW.length - 1 && (
                <span
                  aria-hidden
                  className={`absolute left-1/2 top-[7px] h-0.5 w-full ${
                    i < stepIndex ? "bg-moss" : "bg-peach/70"
                  }`}
                />
              )}
              <span
                className={`relative z-10 h-4 w-4 rounded-full border-2 ${
                  i <= stepIndex
                    ? "border-moss bg-moss"
                    : "border-peach bg-white"
                }`}
              />
              <span
                className={`mt-2 text-center text-xs ${
                  i === stepIndex ? "font-semibold text-ink" : "text-ink/45"
                }`}
              >
                {statusLabels[step]}
              </span>
            </li>
          ))}
        </ol>
      )}
      {cancelled && (
        <p className="mt-6 rounded-xl bg-paper px-4 py-3 text-sm text-ink/70">
          Đơn hàng này đã bị hủy.
        </p>
      )}

      {order.status === "shipped" && (
        <ShippingNotice order={order} total={total} />
      )}

      {/* Thanh toán */}
      <div className="mt-8 rounded-xl bg-paper p-4">
        <div className="flex flex-wrap items-center justify-between gap-2">
          <div>
            <p className="text-xs font-semibold uppercase tracking-wider text-ink/45">
              Thanh toán
            </p>
            <p className="mt-1 text-sm font-medium">
              {paymentLabels[order.paymentMethod] ?? order.paymentMethod}
            </p>
          </div>
          <PaymentBadge order={order} />
        </div>

        {order.isPaid && order.paidAt && (
          <p className="mt-2 text-xs text-ink/55">
            Shop đã nhận tiền lúc{" "}
            {new Date(order.paidAt).toLocaleString("vi-VN")}
          </p>
        )}

        {needsPayment(order) && (
          <div className="mt-3 border-t border-ink/10 pt-3">
            {BANK.account ? (
              <>
                <p className="text-sm text-ink/65">
                  Bạn chuyển khoản theo thông tin dưới đây, nhớ ghi đúng nội
                  dung để shop đối soát được đơn.
                </p>
                <dl className="mt-2">
                  <PayRow label="Ngân hàng" value={BANK.name} />
                  <PayRow label="Số tài khoản" value={BANK.account} />
                  <PayRow label="Chủ tài khoản" value={BANK.holder} />
                  <PayRow label="Số tiền" value={formatVND(total)} />
                  <PayRow label="Nội dung" value={`COMAY ${order.id}`} />
                </dl>
              </>
            ) : (
              <p className="text-sm text-ink/65">
                Vui lòng liên hệ shop để được hướng dẫn chuyển khoản cho đơn
                này.
              </p>
            )}
          </div>
        )}
      </div>

      {/* Sản phẩm */}
      <ul className="mt-8 divide-y divide-ink/10 border-y border-ink/10">
        {order.orderItems.map((item) => (
          <li key={item.id} className="flex items-center gap-4 py-4">
            <Link
              href={`/products/${item.product.id}`}
              className="relative h-16 w-16 shrink-0 overflow-hidden rounded-lg bg-blush"
            >
              {item.product.imageUrl && (
                <Image
                  src={item.product.imageUrl}
                  alt={item.product.name}
                  fill
                  sizes="64px"
                  className="object-cover"
                />
              )}
            </Link>
            <div className="min-w-0 flex-1">
              <Link
                href={`/products/${item.product.id}`}
                className="line-clamp-2 text-sm font-semibold leading-snug transition-colors hover:text-moss-dark"
              >
                {item.product.name}
              </Link>
              <p className="mt-0.5 text-sm text-ink/55">
                {formatVND(Number(item.priceAtOrder))} × {item.quantity}
              </p>
            </div>
            <p className="shrink-0 text-sm font-semibold tabular-nums">
              {formatVND(Number(item.priceAtOrder) * item.quantity)}
            </p>
          </li>
        ))}
      </ul>

      {/* Nơi nhận + tính tiền */}
      <div className="mt-6 grid gap-6 sm:grid-cols-[1fr_minmax(0,18rem)] sm:items-end">
        <div className="text-sm">
          <p className="text-xs font-semibold uppercase tracking-wider text-ink/45">
            Giao tới
          </p>
          <p className="mt-1 font-medium">
            {order.customerName} · {order.phone}
          </p>
          <p className="whitespace-pre-line text-ink/65">{order.address}</p>
        </div>

        <div>
          <dl className="space-y-1.5 px-1 pb-3 text-sm">
            <div className="flex justify-between gap-4">
              <dt className="text-ink/55">Tiền hàng</dt>
              <dd className="tabular-nums">{formatVND(itemsTotal)}</dd>
            </div>
            <div className="flex justify-between gap-4">
              <dt className="text-ink/55">Phí vận chuyển</dt>
              <dd className="tabular-nums">{formatVND(shippingFee)}</dd>
            </div>
            {discountAmount > 0 && (
              <div className="flex justify-between gap-4 text-emerald-800">
                <dt>Giảm giá đơn hàng</dt>
                <dd className="tabular-nums">-{formatVND(discountAmount)}</dd>
              </div>
            )}
            {shippingDiscount > 0 && (
              <div className="flex justify-between gap-4 text-emerald-800">
                <dt>Giảm phí vận chuyển</dt>
                <dd className="tabular-nums">-{formatVND(shippingDiscount)}</dd>
              </div>
            )}
          </dl>
          <div className="rounded-2xl bg-ink px-6 py-4 text-paper sm:text-right">
            <p className="text-xs text-paper/65">Tổng cộng</p>
            <p className="font-heading text-3xl font-semibold leading-tight text-white">
              {formatVND(total)}
            </p>
          </div>
        </div>
      </div>

      {/* Khách tự hủy đơn / đổi địa chỉ */}
      <OrderActions order={order} onChanged={onChanged} />
    </div>
  );
}

export default function OrdersPage() {
  const [orders, setOrders] = useState<Order[] | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [needLogin, setNeedLogin] = useState(false);
  const [filter, setFilter] = useState<string>("all");
  const [selectedId, setSelectedId] = useState<number | null>(null);
  const [isLg, setIsLg] = useState(false);

  // Màn hình rộng: hiện 2 khung. Màn hình hẹp: mở rộng ngay trong danh sách.
  useEffect(() => {
    const mq = window.matchMedia("(min-width: 1024px)");
    const update = () => setIsLg(mq.matches);
    update();
    mq.addEventListener("change", update);
    return () => mq.removeEventListener("change", update);
  }, []);

  useEffect(() => {
    async function load() {
      try {
        const res = await fetch("/api/orders");
        const json = await res.json();

        if (res.ok && json.success) {
          setOrders(json.data);
          return;
        }
        if (res.status === 401) {
          setNeedLogin(true);
        }
        setError(json.message ?? "Có lỗi xảy ra, vui lòng thử lại");
      } catch {
        setError("Không kết nối được máy chủ, vui lòng thử lại");
      }
    }
    load();
  }, []);

  // Tải lại danh sách ngầm sau khi khách hủy / đổi địa chỉ (không hiện khung xương)
  const reloadOrders = useCallback(async () => {
    try {
      const res = await fetch("/api/orders");
      const json = await res.json();
      if (res.ok && json.success) {
        setOrders(json.data);
      }
    } catch {
      // bỏ qua, giữ dữ liệu cũ
    }
  }, []);

  function handleChanged(kind: ChangeKind) {
    // Đơn vừa hủy không còn ở tab "Chờ xác nhận" nên quay về "Tất cả"
    if (kind === "cancel") {
      setFilter("all");
    }
    reloadOrders();
  }

  if (needLogin) {
    return (
      <main className="mx-auto max-w-2xl px-4 pb-24 pt-16 text-center">
        <h1 className="text-4xl font-semibold">Đơn hàng của tôi</h1>
        <p className="mt-4 text-ink/65">{error}</p>
        <Link
          href="/login?next=/orders"
          className="mt-8 inline-block rounded-xl bg-moss px-8 py-4 font-semibold text-white transition hover:bg-moss-dark"
        >
          Đăng nhập
        </Link>
      </main>
    );
  }

  if (error) {
    return (
      <main className="mx-auto max-w-2xl px-4 pb-24 pt-16 text-center">
        <p className="text-red-700">{error}</p>
      </main>
    );
  }

  // Đang tải: khung xương thay cho dòng chữ
  if (orders === null) {
    return (
      <main
        className="mx-auto max-w-6xl px-4 pb-24 pt-10"
        aria-busy="true"
        aria-label="Đang tải đơn hàng"
      >
        <div className="h-10 w-72 animate-pulse rounded-lg bg-ink/10" />
        <div className="mt-10 grid gap-8 lg:grid-cols-[340px_1fr]">
          <div className="space-y-3">
            {[0, 1, 2].map((i) => (
              <div
                key={i}
                className="h-24 animate-pulse rounded-xl bg-ink/10"
              />
            ))}
          </div>
          <div className="hidden h-96 animate-pulse rounded-2xl bg-ink/10 lg:block" />
        </div>
      </main>
    );
  }

  if (orders.length === 0) {
    return (
      <main className="mx-auto max-w-2xl px-4 pb-24 pt-16 text-center">
        <h1 className="text-4xl font-semibold">Chưa có đơn nào</h1>
        <p className="mt-4 text-ink/65">
          Khi bạn đặt hàng, đơn sẽ xuất hiện ở đây để theo dõi.
        </p>
        <Link
          href="/products"
          className="mt-8 inline-block rounded-xl bg-moss px-8 py-4 font-semibold text-white transition hover:bg-moss-dark"
        >
          Bắt đầu mua sắm
        </Link>
      </main>
    );
  }

  // Các tab lọc: chỉ hiện trạng thái đang có đơn
  const presentStatuses = [...FLOW, "cancelled"].filter((s) =>
    orders.some((o) => o.status === s),
  );
  // Trạng thái lạ (không nằm trong danh sách trên) vẫn có tab
  const otherStatuses = Array.from(new Set(orders.map((o) => o.status))).filter(
    (s) => !presentStatuses.includes(s),
  );
  const tabs = [
    { key: "all", label: "Tất cả", count: orders.length },
    ...[...presentStatuses, ...otherStatuses].map((s) => ({
      key: s,
      label: statusLabels[s] ?? s,
      count: orders.filter((o) => o.status === s).length,
    })),
  ];

  const filtered =
    filter === "all" ? orders : orders.filter((o) => o.status === filter);

  // Đơn đang hiện ở khung bên phải (máy tính): đơn được chọn, mặc định là đơn đầu
  const activeOrder =
    filtered.find((o) => o.id === selectedId) ?? filtered[0] ?? null;

  function handleSelect(id: number) {
    // Máy tính: luôn chọn. Điện thoại: bấm lần nữa thì thu lại.
    setSelectedId((prev) => (!isLg && prev === id ? null : id));
  }

  return (
    <main className="mx-auto max-w-6xl px-4 pb-24 pt-10">
      <header className="flex flex-wrap items-end justify-between gap-3">
        <h1 className="text-4xl font-semibold leading-tight sm:text-5xl">
          Đơn hàng của tôi
        </h1>
        <p className="pb-1 text-sm text-ink/55">
          <span className="font-semibold text-ink">{orders.length}</span> đơn
        </p>
      </header>

      {/* Tab lọc theo trạng thái */}
      <nav
        aria-label="Lọc theo trạng thái"
        className="mt-8 flex gap-6 overflow-x-auto border-b border-ink/15"
      >
        {tabs.map((tab) => (
          <button
            key={tab.key}
            type="button"
            onClick={() => {
              setFilter(tab.key);
              setSelectedId(null);
            }}
            className={`-mb-px shrink-0 border-b-2 pb-3 text-sm transition-colors ${
              filter === tab.key
                ? "border-moss font-semibold text-ink"
                : "border-transparent text-ink/55 hover:text-ink"
            }`}
          >
            {tab.label}
            <span className="ml-1.5 text-xs text-ink/45">{tab.count}</span>
          </button>
        ))}
      </nav>

      <div className="mt-8 grid items-start gap-8 lg:grid-cols-[340px_1fr]">
        {/* Danh sách đơn */}
        <ul className="space-y-3 lg:sticky lg:top-24 lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:p-1 lg:pr-2 lg:[scrollbar-width:thin]">
          {filtered.map((order) => {
            const isActive = isLg
              ? activeOrder?.id === order.id
              : selectedId === order.id;
            const photos = order.orderItems
              .filter((i) => i.product.imageUrl)
              .slice(0, 3);
            const extra = order.orderItems.length - photos.length;

            return (
              <li key={order.id}>
                <button
                  type="button"
                  onClick={() => handleSelect(order.id)}
                  aria-expanded={isActive}
                  className={`relative w-full rounded-xl p-4 text-left transition ${
                    isActive ? "bg-white shadow-warm" : "hover:bg-white/60"
                  }`}
                >
                  {/* Vạch nhấn bên trái khi được chọn */}
                  <span
                    aria-hidden
                    className={`absolute bottom-3 left-0 top-3 w-1 rounded-r-full bg-moss transition-opacity ${
                      isActive ? "opacity-100" : "opacity-0"
                    }`}
                  />
                  <div className="flex items-center justify-between gap-3">
                    <p className="font-semibold">Đơn #{order.id}</p>
                    <StatusBadge status={order.status} />
                  </div>
                  <div className="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1">
                    <p className="text-sm text-ink/55">
                      {shortDate(order.createdAt)} · {order.orderItems.length}{" "}
                      món
                    </p>
                    <PaymentBadge order={order} />
                  </div>

                  <div className="mt-3 flex items-center justify-between gap-3">
                    <div className="flex items-center">
                      {photos.map((item, i) => (
                        <span
                          key={item.id}
                          className={`relative h-9 w-9 overflow-hidden rounded-full border-2 border-paper bg-blush ${
                            i > 0 ? "-ml-2.5" : ""
                          }`}
                        >
                          <Image
                            src={item.product.imageUrl as string}
                            alt={item.product.name}
                            fill
                            sizes="36px"
                            className="object-cover"
                          />
                        </span>
                      ))}
                      {extra > 0 && (
                        <span className="-ml-2.5 flex h-9 w-9 items-center justify-center rounded-full border-2 border-paper bg-ink text-xs font-semibold text-paper">
                          +{extra}
                        </span>
                      )}
                    </div>
                    <p className="font-semibold tabular-nums text-moss-dark">
                      {formatVND(orderTotal(order))}
                    </p>
                  </div>
                </button>

                {/* Điện thoại: chi tiết mở rộng ngay dưới đơn đang chọn */}
                {!isLg && selectedId === order.id && (
                  <div className="mt-2 rounded-2xl bg-white p-5">
                    <OrderDetail
                      key={order.id}
                      order={order}
                      onChanged={handleChanged}
                    />
                  </div>
                )}
              </li>
            );
          })}

          {filtered.length === 0 && (
            <li className="rounded-xl bg-white px-4 py-8 text-center text-sm text-ink/60">
              Không có đơn nào ở trạng thái này.
            </li>
          )}
        </ul>

        {/* Máy tính: khung chi tiết bên phải, dính theo màn hình */}
        {isLg && activeOrder && (
          <section className="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto rounded-2xl bg-white p-8 [scrollbar-width:thin]">
            <OrderDetail
              key={activeOrder.id}
              order={activeOrder}
              onChanged={handleChanged}
            />
          </section>
        )}
      </div>
    </main>
  );
}
</file>

<file path="src/app/globals.css">
@import "tailwindcss";

@theme {
  /* Bảng màu hồng san hô - mận */
  --color-paper: #fff7f3; /* nền trắng hồng rất nhạt */
  --color-card: #ffffff; /* thẻ, khung: trắng sạch cho nổi trên nền */
  --color-ink: #33202a; /* chữ mận đậm */
  --color-moss: #f4604f; /* nhấn chính: san hô (giữ tên cũ để không phải sửa file khác) */
  --color-moss-dark: #d9432f; /* san hô đậm, dùng cho hover và chữ nhỏ */
  --color-peach: #f9a8a0; /* hồng đào, dùng cho viền, huy hiệu, họa tiết */
  --color-blush: #fde3dd; /* nền nhấn nhạt */
  --color-ochre: #f2b84b; /* vàng ấm, giữ cho sao đánh giá và cảnh báo */

  --font-heading: var(--font-heading);
  --font-body: var(--font-body);

  /* Bóng đổ ngả mận (dùng bằng class shadow-warm, shadow-warm-lg) */
  --shadow-warm: 0 6px 20px -6px rgb(51 32 42 / 0.16);
  --shadow-warm-lg: 0 18px 40px -12px rgb(51 32 42 / 0.26);

  /* Hiệu ứng: dùng bằng class animate-fade-up, animate-fade-in, animate-float, animate-marquee */
  --animate-fade-up: fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  --animate-fade-in: fade-in 0.8s ease-out both;
  --animate-float: float 9s ease-in-out infinite;
  --animate-marquee: marquee 28s linear infinite;

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(18px, -26px) scale(1.06);
    }
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  background-color: var(--color-paper);
  color: var(--color-ink);
}

h1,
h2,
h3,
h4 {
  font-family: var(--font-heading);
}

/* Bôi đen chữ cũng ra màu ấm */
::selection {
  background-color: var(--color-peach);
  color: var(--color-ink);
}
/* Người dùng tắt chuyển động trong hệ điều hành thì giảm hiệu ứng */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Dải chữ chạy ngang luôn chạy, kể cả khi máy tắt hiệu ứng động */
.marquee-track {
  animation-duration: 28s !important;
  animation-iteration-count: infinite !important;
}
</file>

<file path="src/components/AddToCartButton.tsx">
"use client";

import Link from "next/link";
import { useRouter } from "next/navigation";
import { useState } from "react";
import { useCart } from "../../lib/cart-context";

interface AddToCartButtonProps {
  productId: number;
  name: string;
  price: number;
  imageUrl: string | null;
  stock: number;
  isLoggedIn: boolean;
}

export default function AddToCartButton({
  productId,
  name,
  price,
  imageUrl,
  stock,
  isLoggedIn,
}: AddToCartButtonProps) {
  const router = useRouter();
  const { items, addItem } = useCart();
  const [quantity, setQuantity] = useState(1);
  const [draft, setDraft] = useState<string | null>(null); // đang gõ tay
  const [message, setMessage] = useState("");
  const [isWarning, setIsWarning] = useState(false);

  // Số lượng sản phẩm này đang có trong giỏ
  const inCart = items.find((i) => i.id === productId)?.quantity ?? 0;
  // Số còn có thể thêm được nữa
  const remaining = Math.max(stock - inCart, 0);
  const reachedMax = stock > 0 && remaining === 0;

  // Số lượng đang chọn, luôn nằm trong khoảng 1..remaining
  const qty = remaining > 0 ? Math.min(Math.max(quantity, 1), remaining) : 0;

  function commitDraft() {
    if (draft === null) return;
    const n = parseInt(draft, 10);
    if (!Number.isNaN(n) && n >= 1) {
      setQuantity(Math.min(n, Math.max(remaining, 1)));
    }
    setDraft(null);
  }

  function requireLogin() {
    if (!isLoggedIn) {
      router.push(`/login?next=/products/${productId}`);
      return true;
    }
    return false;
  }

  function handleAdd() {
    if (requireLogin()) return;

    const { added, limited } = addItem(
      { id: productId, name, price, imageUrl, stock },
      qty,
    );

    if (added === 0) {
      setIsWarning(true);
      setMessage(`Trong giỏ đã có tối đa ${stock} sản phẩm (hết tồn kho)`);
    } else if (limited) {
      setIsWarning(true);
      setMessage(`Chỉ còn ${stock} sản phẩm, đã thêm tối đa vào giỏ`);
    } else {
      setIsWarning(false);
      setMessage(`Đã thêm ${added} sản phẩm vào giỏ hàng`);
    }
    setQuantity(1);
  }

  function handleBuyNow() {
    if (requireLogin()) return;

    // Giỏ đã đầy sản phẩm này thì không thêm nữa, đi thẳng sang đặt hàng
    if (qty > 0) {
      addItem({ id: productId, name, price, imageUrl, stock }, qty);
    }
    router.push("/checkout");
  }

  const addLabel =
    stock === 0 ? "Hết hàng" : reachedMax ? "Đã thêm tối đa" : "Thêm vào giỏ";

  return (
    <div className="mt-8">
      {/* Chọn số lượng */}
      {stock > 0 && (
        <div className="mb-4 flex flex-wrap items-center gap-x-5 gap-y-2">
          <span className="text-sm font-semibold text-ink">Số lượng</span>

          <div className="inline-flex items-center overflow-hidden rounded-lg border border-ink/15 bg-white">
            <button
              type="button"
              aria-label="Giảm số lượng"
              onClick={() => setQuantity(Math.max(qty - 1, 1))}
              disabled={qty <= 1}
              className="h-11 w-11 text-lg text-ink transition hover:bg-blush disabled:cursor-not-allowed disabled:text-ink/30 disabled:hover:bg-transparent"
            >
              −
            </button>
            <input
              type="text"
              inputMode="numeric"
              aria-label="Số lượng"
              value={draft ?? String(qty)}
              disabled={remaining === 0}
              onChange={(e) => setDraft(e.target.value.replace(/\D/g, ""))}
              onBlur={commitDraft}
              onKeyDown={(e) => {
                if (e.key === "Enter") {
                  e.preventDefault();
                  commitDraft();
                }
              }}
              className="h-11 w-14 border-x border-ink/15 bg-transparent text-center text-base font-semibold text-ink outline-none focus:bg-blush/50 disabled:text-ink/30"
            />
            <button
              type="button"
              aria-label="Tăng số lượng"
              onClick={() => setQuantity(Math.min(qty + 1, remaining))}
              disabled={qty >= remaining}
              className="h-11 w-11 text-lg text-ink transition hover:bg-blush disabled:cursor-not-allowed disabled:text-ink/30 disabled:hover:bg-transparent"
            >
              +
            </button>
          </div>

          <span className="text-sm text-ink/55">
            {reachedMax
              ? `Giỏ của bạn đã có đủ ${stock} sản phẩm`
              : inCart > 0
                ? `Còn thêm được ${remaining} (đã có ${inCart} trong giỏ)`
                : `Còn ${stock} sản phẩm`}
          </span>
        </div>
      )}

      {/* Hai nút hành động */}
      <div className="grid gap-3 sm:grid-cols-2">
        <button
          type="button"
          onClick={handleAdd}
          disabled={stock === 0 || reachedMax}
          className="flex items-center justify-center gap-2.5 rounded-lg border-2 border-moss bg-white py-3.5 text-base font-semibold text-moss-dark transition hover:-translate-y-0.5 hover:bg-blush active:translate-y-0 disabled:translate-y-0 disabled:cursor-not-allowed disabled:border-ink/15 disabled:bg-ink/10 disabled:text-ink/45 disabled:hover:bg-ink/10"
        >
          {/* Biểu tượng giỏ hàng */}
          <svg
            aria-hidden
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth={1.9}
            strokeLinecap="round"
            strokeLinejoin="round"
            className="h-5 w-5"
          >
            <path d="M3 4h2l2.2 10.2a1.5 1.5 0 0 0 1.5 1.2h8.1a1.5 1.5 0 0 0 1.5-1.1L20 8H6.2" />
            <circle cx="9.5" cy="19.5" r="1.2" />
            <circle cx="17" cy="19.5" r="1.2" />
          </svg>
          {addLabel}
        </button>

        <button
          type="button"
          onClick={handleBuyNow}
          disabled={stock === 0}
          className="flex items-center justify-center gap-2.5 rounded-lg bg-moss py-3.5 text-base font-semibold text-white shadow-warm transition hover:-translate-y-0.5 hover:bg-moss-dark hover:shadow-warm-lg active:translate-y-0 disabled:translate-y-0 disabled:cursor-not-allowed disabled:bg-ink/15 disabled:text-ink/45 disabled:shadow-none"
        >
          Đặt hàng ngay
          <span aria-hidden>→</span>
        </button>
      </div>

      {/* Thông báo sau khi thêm vào giỏ */}
      <div role="status" aria-live="polite">
        {message && (
          <p
            className={`mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg px-4 py-2.5 text-sm ${
              isWarning
                ? "border border-ochre bg-ochre/20 text-ink"
                : "border border-peach bg-blush/60 text-moss-dark"
            }`}
          >
            <span className="font-medium">
              {isWarning ? "⚠ " : "✓ "}
              {message}
            </span>
            {isLoggedIn && (
              <Link
                href="/cart"
                className="font-semibold underline decoration-2 underline-offset-4 hover:text-moss"
              >
                Xem giỏ hàng →
              </Link>
            )}
          </p>
        )}
      </div>

      {/* Nhắc khách chưa đăng nhập */}
      {!isLoggedIn && stock > 0 && (
        <p className="mt-3 text-center text-sm text-ink/55">
          Bạn cần đăng nhập để đặt hàng hoặc thêm vào giỏ.
        </p>
      )}
    </div>
  );
}
</file>

<file path="src/components/ProductCard.tsx">
import Link from "next/link";
import Reveal from "./Reveal";
import WishlistButton from "./WishlistButton";

type ProductCardProps = {
  id: number;
  name: string;
  price: number;
  imageUrl: string | null;
  stock: number;
  index?: number; // Thứ tự thẻ trong danh sách, dùng để hiện lần lượt
};

// Từ ngưỡng này trở xuống thì báo "Chỉ còn ..." để khách biết món sắp hết
const LOW_STOCK = 5;

export default function ProductCard({
  id,
  name,
  price,
  imageUrl,
  stock,
  index = 0,
}: ProductCardProps) {
  const outOfStock = stock <= 0;
  const lowStock = !outOfStock && stock <= LOW_STOCK;

  const formattedPrice = new Intl.NumberFormat("vi-VN", {
    style: "currency",
    currency: "VND",
  }).format(price);

  return (
    // Trễ theo cột (tối đa 4 cột) để cả hàng hiện lần lượt, không bị chờ lâu ở các hàng dưới
    <Reveal delay={(index % 4) * 0.08}>
      {/* Thẻ bọc ngoài: giữ hiệu ứng nổi lên và làm mốc cho nút trái tim */}
      <div className="group relative transition duration-300 hover:-translate-y-1">
        <Link
          href={`/products/${id}`}
          className="block rounded-lg border border-peach/50 bg-white p-2 shadow-warm transition duration-300 group-hover:border-moss group-hover:shadow-warm-lg"
        >
          <div className="relative aspect-square w-full overflow-hidden bg-blush/40">
            {imageUrl ? (
              // eslint-disable-next-line @next/next/no-img-element
              <img
                src={imageUrl}
                alt={name}
                className={`h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 ${
                  outOfStock ? "opacity-60 grayscale" : ""
                }`}
              />
            ) : (
              <div className="flex h-full w-full items-center justify-center text-sm text-ink/40">
                Không có ảnh
              </div>
            )}

            {/* Nhãn trạng thái: hết hàng hoặc sắp hết */}
            {outOfStock && (
              <span className="absolute left-0 top-3 bg-ink px-3 py-1 text-xs font-medium uppercase tracking-wider text-paper">
                Hết hàng
              </span>
            )}
            {lowStock && (
              <span className="absolute left-0 top-3 bg-ochre px-3 py-1 text-xs font-semibold uppercase tracking-wider text-ink">
                Chỉ còn {stock}
              </span>
            )}

            {/* Dải trượt lên khi rê chuột */}
            <span className="absolute inset-x-0 bottom-0 translate-y-full bg-moss py-2.5 text-center text-sm font-medium text-white transition duration-300 group-hover:translate-y-0">
              Xem chi tiết →
            </span>
          </div>

          <div className="px-1.5 pb-1.5 pt-3">
            <h3 className="line-clamp-2 min-h-10 text-sm font-medium leading-5 text-ink transition-colors group-hover:text-moss-dark">
              {name}
            </h3>
            <p className="mt-1.5 text-base font-semibold text-moss-dark">
              {formattedPrice}
            </p>
          </div>
        </Link>

        {/* Nút trái tim nằm NGOÀI Link để bấm không bị chuyển trang */}
        <div className="absolute right-4 top-4 z-10">
          <WishlistButton productId={id} variant="icon" />
        </div>
      </div>
    </Reveal>
  );
}
</file>

<file path="src/proxy.ts">
import { NextRequest, NextResponse } from "next/server";
import jwt from "jsonwebtoken";

const COOKIE_NAME = "session";
// Trang đăng nhập của Admin, sửa lại nếu đường dẫn thật của bạn khác
const ADMIN_LOGIN_PATH = "/admin/login";

type Role = "customer" | "admin";

// Đọc role từ cookie. Trả về null nếu chưa đăng nhập / token sai / hết hạn.
// Tự verify bằng jsonwebtoken thay vì import lib/auth.ts để proxy không
// phải kéo theo Prisma (lib/auth.ts import prisma).
function getRole(request: NextRequest): Role | null {
  const token = request.cookies.get(COOKIE_NAME)?.value;
  const secret = process.env.JWT_SECRET;
  if (!token || !secret) return null;

  try {
    const payload = jwt.verify(token, secret) as { role?: Role };
    return payload.role ?? null;
  } catch {
    return null;
  }
}

function redirectToLogin(request: NextRequest, loginPath: string) {
  const { pathname, search } = request.nextUrl;
  const url = new URL(loginPath, request.url);
  // Sau khi đăng nhập xong sẽ quay lại đúng trang đang định vào
  url.searchParams.set("next", pathname + search);
  return NextResponse.redirect(url);
}

export function proxy(request: NextRequest) {
  const { pathname } = request.nextUrl;
  const role = getRole(request);

  // Khu Admin: chỉ role "admin" được vào (trừ chính trang đăng nhập Admin)
  if (pathname.startsWith("/admin")) {
    if (pathname === ADMIN_LOGIN_PATH || role === "admin") {
      return NextResponse.next();
    }
    return redirectToLogin(request, ADMIN_LOGIN_PATH);
  }

  // /checkout, /orders, /account: chỉ role "customer"
  if (role !== "customer") {
    return redirectToLogin(request, "/login");
  }

  return NextResponse.next();
}

export const config = {
  matcher: [
    "/checkout/:path*",
    "/orders/:path*",
    "/account/:path*",
    "/custom/:path*",
    "/admin/:path*",
  ],
};
</file>

