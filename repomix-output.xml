import { z } from "zod";

// Chuỗi rỗng -> null để khớp cột nullable trong DB
const optionalText = (max: number, msg: string) =>
  z
    .string()
    .trim()
    .max(max, msg)
    .transform((v) => (v === "" ? null : v))
    .nullable()
    .optional();

export const productSchema = z.object({
  name: z
    .string()
