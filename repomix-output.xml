<file path="src/app/admin/reviews/page.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import Image from "next/image";
import Link from "next/link";
import { AnimatePresence, motion } from "motion/react";

type ReviewStatus = "pending" | "approved" | "hidden";

type Review = {
  id: number;
  rating: number;
  comment: string | null;
  status: ReviewStatus;
  createdAt: string;
  customer: { id: number; name: string; email: string };
  product: {
    id: number;
    name: string;
    imageUrl: string | null;
    isActive: boolean;
  };
};

const COLUMNS: {
  status: ReviewStatus;
  title: string;
  hint: string;
  accent: string;
  empty: string;
}[] = [
  {
    status: "pending",
    title: "Chờ duyệt",
    hint: "Đọc rồi quyết định hiện hay ẩn",
    accent: "bg-ochre",
    empty: "Không còn đánh giá nào chờ duyệt 🎉",
  },
  {
    status: "approved",
    title: "Đang hiển thị",
    hint: "Khách xem được ở trang sản phẩm",
    accent: "bg-emerald-600",
    empty: "Chưa có đánh giá nào đang hiển thị.",
  },
  {
    status: "hidden",
    title: "Đã ẩn",
    hint: "Không hiện với khách",
    accent: "bg-ink/40",
    empty: "Chưa ẩn đánh giá nào.",
  },
];

// Nút theo cột hiện tại (API vẫn là nơi chốt luật: chỉ approved/hidden)
const ACTIONS: Record<
  ReviewStatus,
  { to: "approved" | "hidden"; label: string; danger?: boolean }[]
> = {
  pending: [
    { to: "approved", label: "Duyệt" },
    { to: "hidden", label: "Ẩn", danger: true },
  ],
  approved: [{ to: "hidden", label: "Ẩn đánh giá", danger: true }],
  hidden: [{ to: "approved", label: "Hiện lại" }],
};

function Stars({ value }: { value: number }) {
  return (
    <span className="flex gap-0.5" aria-label={`${value} trên 5 sao`}>
      {[1, 2, 3, 4, 5].map((s) => (
        <span key={s} className={s <= value ? "text-ochre" : "text-ink/20"}>
          ★
        </span>
      ))}
    </span>
  );
}

export default function AdminReviewsPage() {
  const [reviews, setReviews] = useState<Review[] | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [actionError, setActionError] = useState<string | null>(null);
  const [needLogin, setNeedLogin] = useState(false);
  const [busyId, setBusyId] = useState<number | null>(null);
  const [search, setSearch] = useState("");
  const [reloadKey, setReloadKey] = useState(0);

  useEffect(() => {
    let cancelled = false;

    async function load() {
      setError(null);
      try {
        const res = await fetch("/api/admin/reviews");
        const json = await res.json();
        if (cancelled) return;

        if (res.ok && json.success) {
          setReviews(json.data);
          return;
        }
        if (res.status === 401) setNeedLogin(true);
        setError(json.message ?? "Có lỗi xảy ra, vui lòng thử lại");
      } catch {
        if (!cancelled)
          setError("Không kết nối được máy chủ, vui lòng thử lại");
      }
    }

    load();
    return () => {
      cancelled = true;
    };
  }, [reloadKey]);

  async function changeStatus(review: Review, to: "approved" | "hidden") {
    setBusyId(review.id);
    setActionError(null);
    try {
      const res = await fetch(`/api/admin/reviews/${review.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: to }),
      });
      const json = await res.json();

      if (res.ok && json.success) {
        const updated: Review = json.data;
        setReviews((prev) =>
          prev === null
            ? prev
            : prev.map((r) => (r.id === updated.id ? updated : r)),
        );
        return;
      }

      if (res.status === 401) setNeedLogin(true);
      setActionError(json.message ?? "Có lỗi xảy ra, vui lòng thử lại");
    } catch {
      setActionError("Không kết nối được máy chủ, vui lòng thử lại");
    } finally {
      setBusyId(null);
    }
  }

  // Lọc theo ô tìm kiếm: tên sản phẩm, tên/email khách, nội dung đánh giá
  const visible = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q) return reviews ?? [];
    return (reviews ?? []).filter(
      (r) =>
        r.product.name.toLowerCase().includes(q) ||
        r.customer.name.toLowerCase().includes(q) ||
        r.customer.email.toLowerCase().includes(q) ||
        (r.comment ?? "").toLowerCase().includes(q),
    );
  }, [reviews, search]);

  if (needLogin) {
    return (
      <main className="mx-auto max-w-5xl px-4 py-16 text-center">
        <h1 className="font-heading text-3xl">Duyệt đánh giá</h1>
        <p className="mt-3 opacity-70">{error}</p>
        <Link
          href="/admin/login?next=/admin/reviews"
          className="mt-6 inline-block rounded-lg bg-ink px-5 py-2.5 text-paper"
        >
          Đăng nhập quản trị
        </Link>
      </main>
    );
  }

  return (
    <main className="mx-auto max-w-7xl px-4 py-10">
      <motion.div
        initial={{ opacity: 0, y: -12 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.5 }}
        className="flex flex-wrap items-end justify-between gap-3"
      >
        <div>
          <h1 className="font-heading text-3xl sm:text-4xl">Duyệt đánh giá</h1>
          <p className="mt-1 text-sm text-ink/60">
            Đánh giá mới của khách nằm ở cột Chờ duyệt cho đến khi bạn quyết
            định
          </p>
        </div>

        <div className="flex gap-2">
          <input
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="🔍 Sản phẩm, khách, nội dung..."
            className="w-64 rounded-full border border-ink/20 bg-paper px-4 py-2 text-sm outline-none transition focus:border-ink focus:ring-2 focus:ring-ochre/30"
          />
          <button
            type="button"
            onClick={() => setReloadKey((k) => k + 1)}
            className="rounded-full border border-ink/20 px-4 py-2 text-sm transition hover:bg-ink hover:text-paper"
          >
            ↻ Tải lại
          </button>
        </div>
      </motion.div>

      {actionError && (
        <div className="mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">
          {actionError}
        </div>
      )}

      {error && <p className="mt-8 text-center text-red-700">{error}</p>}

      {!error && reviews === null && (
        <div className="mt-8 grid gap-5 lg:grid-cols-3">
          {[0, 1, 2].map((i) => (
            <div
              key={i}
              className="h-72 animate-pulse rounded-2xl border border-ink/10 bg-card"
            />
          ))}
        </div>
      )}

      {reviews !== null && (
        <div className="mt-8 grid items-start gap-5 lg:grid-cols-3">
          {COLUMNS.map((col) => {
            const items = visible.filter((r) => r.status === col.status);
            return (
              <section
                key={col.status}
                className="overflow-hidden rounded-2xl border border-ink/10 bg-card shadow-sm"
              >
                <div className={`h-1.5 ${col.accent}`} />
                <header className="flex items-start justify-between gap-3 px-4 pb-2 pt-4">
                  <div>
                    <h2 className="font-heading text-xl font-semibold">
                      {col.title}
                    </h2>
                    <p className="text-xs text-ink/55">{col.hint}</p>
                  </div>
                  <span
                    className={`rounded-full px-2.5 py-0.5 text-sm font-semibold ${
                      col.status === "pending" && items.length > 0
                        ? "bg-ochre text-ink"
                        : "bg-ink/10 text-ink/70"
                    }`}
                  >
                    {items.length}
                  </span>
                </header>

                <ul className="max-h-[70vh] space-y-3 overflow-y-auto p-3">
                  <AnimatePresence mode="popLayout" initial={false}>
                    {items.map((r) => (
                      <motion.li
                        key={r.id}
                        layout
                        initial={{ opacity: 0, y: 16 }}
                        animate={{ opacity: 1, y: 0 }}
                        exit={{ opacity: 0, scale: 0.95 }}
                        transition={{ duration: 0.3 }}
                        className="rounded-xl border border-ink/10 bg-paper p-4"
                      >
                        {/* Sản phẩm được đánh giá */}
                        <Link
                          href={`/products/${r.product.id}`}
                          target="_blank"
                          className="flex items-center gap-3"
                        >
                          <span className="relative h-11 w-11 shrink-0 overflow-hidden rounded-lg bg-card">
                            {r.product.imageUrl && (
                              <Image
                                src={r.product.imageUrl}
                                alt={r.product.name}
                                fill
                                sizes="44px"
                                className="object-cover"
                              />
                            )}
                          </span>
                          <span className="min-w-0">
                            <span className="line-clamp-2 text-sm font-medium leading-snug hover:underline">
                              {r.product.name}
                            </span>
                            {!r.product.isActive && (
                              <span className="mt-0.5 inline-block rounded bg-ink/10 px-1.5 text-[11px] text-ink/60">
                                Sản phẩm đang ẩn
                              </span>
                            )}
                          </span>
                        </Link>

                        {/* Sao + ngày */}
                        <div className="mt-3 flex items-center justify-between gap-2">
                          <Stars value={r.rating} />
                          <span className="text-xs text-ink/50">
                            {new Date(r.createdAt).toLocaleDateString("vi-VN")}
                          </span>
                        </div>

                        {/* Nội dung */}
                        {r.comment ? (
                          <p className="mt-2 whitespace-pre-line break-words text-sm leading-relaxed text-ink/80">
                            {r.comment}
                          </p>
                        ) : (
                          <p className="mt-2 text-sm italic text-ink/45">
                            Khách chỉ chấm sao, không viết nhận xét.
                          </p>
                        )}

                        {/* Người viết */}
                        <p className="mt-3 truncate text-xs text-ink/55">
                          {r.customer.name} · {r.customer.email}
                        </p>

                        {/* Nút xử lý */}
                        <div className="mt-3 flex flex-wrap justify-end gap-2 border-t border-ink/10 pt-3">
                          {ACTIONS[r.status].map((a) => (
                            <motion.button
                              key={a.to}
                              type="button"
                              whileTap={{ scale: 0.95 }}
                              disabled={busyId === r.id}
                              onClick={() => changeStatus(r, a.to)}
                              className={`rounded-full px-4 py-1.5 text-sm font-medium transition disabled:opacity-50 ${
                                a.danger
                                  ? "border border-red-700 text-red-700 hover:bg-red-700 hover:text-white"
                                  : "bg-ink text-paper hover:bg-moss-dark"
                              }`}
                            >
                              {busyId === r.id ? "Đang xử lý..." : a.label}
                            </motion.button>
                          ))}
                        </div>
                      </motion.li>
                    ))}
                  </AnimatePresence>

                  {items.length === 0 && (
                    <li className="rounded-xl border border-dashed border-ink/20 px-4 py-10 text-center text-sm text-ink/55">
                      {search ? "Không có đánh giá nào khớp." : col.empty}
                    </li>
                  )}
                </ul>
              </section>
            );
          })}
        </div>
      )}
    </main>
  );
}
</file>

<file path="src/app/admin/stock/page.tsx">
"use client";

import { useEffect, useRef, useState } from "react";

type Reason = "import" | "sale" | "cancel_restore" | "adjustment";

type Movement = {
  id: number;
  productId: number;
  productName: string;
  orderId: number | null;
  change: number;
  stockAfter: number;
  reason: Reason;
  note: string | null;
  createdAt: string;
};

const PAGE_SIZE = 20;

const REASON_META: Record<Reason, { label: string; tone: string }> = {
  import: {
    label: "Nhập hàng",
    tone: "border-emerald-300 bg-emerald-50 text-emerald-800",
  },
  sale: {
    label: "Bán ra",
    tone: "border-stone-300 bg-stone-50 text-stone-700",
  },
  cancel_restore: {
    label: "Hoàn kho",
    tone: "border-sky-300 bg-sky-50 text-sky-800",
  },
  adjustment: {
    label: "Điều chỉnh",
    tone: "border-amber-300 bg-amber-50 text-amber-800",
  },
};

const FILTERS: { value: Reason | ""; label: string }[] = [
  { value: "", label: "Tất cả" },
  { value: "import", label: "Nhập hàng" },
  { value: "sale", label: "Bán ra" },
  { value: "cancel_restore", label: "Hoàn kho" },
  { value: "adjustment", label: "Điều chỉnh" },
];

async function fetchPage(page: number, reason: Reason | "", q: string) {
  const params = new URLSearchParams({
    page: String(page),
    pageSize: String(PAGE_SIZE),
  });
  if (reason) params.set("reason", reason);
  if (q) params.set("q", q);

  const res = await fetch(`/api/admin/stock-movements?${params.toString()}`);
  const json = await res.json().catch(() => null);
  if (!res.ok || !json?.success) {
    throw new Error(json?.message ?? "Không thể tải lịch sử tồn kho");
  }
  return json as { data: Movement[]; total: number };
}

function dayLabel(iso: string) {
  return new Date(iso).toLocaleDateString("vi-VN", {
    weekday: "long",
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
}

function timeLabel(iso: string) {
  return new Date(iso).toLocaleTimeString("vi-VN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

export default function AdminStockPage() {
  const [items, setItems] = useState<Movement[]>([]);
  const [total, setTotal] = useState(0);
  const [page, setPage] = useState(1);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const [reason, setReason] = useState<Reason | "">("");
  const [q, setQ] = useState("");
  const [debouncedQ, setDebouncedQ] = useState("");

  // Bỏ qua kết quả của request cũ nếu người dùng đã đổi bộ lọc
  const reqId = useRef(0);

  // Gõ xong 0,4 giây mới tìm
  useEffect(() => {
    const t = setTimeout(() => setDebouncedQ(q.trim()), 400);
    return () => clearTimeout(t);
  }, [q]);

  // Đổi bộ lọc thì tải lại từ trang 1
  useEffect(() => {
    const id = ++reqId.current;
    setLoading(true);
    setError(null);
    fetchPage(1, reason, debouncedQ)
      .then((r) => {
        if (id !== reqId.current) return;
        setItems(r.data);
        setTotal(r.total);
        setPage(1);
      })
      .catch((e: Error) => {
        if (id !== reqId.current) return;
        setError(e.message);
        setItems([]);
        setTotal(0);
      })
      .finally(() => {
        if (id === reqId.current) setLoading(false);
      });
  }, [reason, debouncedQ]);

  function loadMore() {
    const id = ++reqId.current;
    setLoading(true);
    setError(null);
    fetchPage(page + 1, reason, debouncedQ)
      .then((r) => {
        if (id !== reqId.current) return;
        setItems((prev) => [...prev, ...r.data]);
        setTotal(r.total);
        setPage((p) => p + 1);
      })
      .catch((e: Error) => {
        if (id !== reqId.current) return;
        setError(e.message);
      })
      .finally(() => {
        if (id === reqId.current) setLoading(false);
      });
  }

  // Gom các dòng theo ngày, giữ nguyên thứ tự mới nhất lên đầu
  const groups: { label: string; rows: Movement[] }[] = [];
  for (const m of items) {
    const label = dayLabel(m.createdAt);
    const last = groups[groups.length - 1];
    if (last && last.label === label) last.rows.push(m);
    else groups.push({ label, rows: [m] });
  }

  return (
    <main className="mx-auto max-w-3xl px-4 py-10">
      <header className="mb-6">
        <p className="text-[11px] font-medium uppercase tracking-[0.22em] text-moss-dark">
          Quản trị
        </p>
        <h1 className="mt-1 font-heading text-3xl font-semibold text-ink">
          Sổ kho
        </h1>
        <p className="mt-1 text-sm text-ink/60">
          Mọi lần tồn kho tăng hoặc giảm đều được ghi lại ở đây, kèm số tồn sau
          mỗi lần thay đổi.
        </p>
      </header>

      <div className="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div className="flex flex-wrap gap-2">
          {FILTERS.map((f) => (
            <button
              key={f.value || "all"}
              type="button"
              onClick={() => setReason(f.value)}
              className={
                "rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors " +
                (reason === f.value
                  ? "bg-ink text-white"
                  : "bg-blush text-ink/75 hover:text-moss-dark")
              }
            >
              {f.label}
            </button>
          ))}
        </div>
        <input
          value={q}
          onChange={(e) => setQ(e.target.value)}
          placeholder="Tìm theo tên sản phẩm"
          className="w-full rounded-full border border-peach/60 bg-white px-4 py-2 text-sm text-ink placeholder:text-ink/40 focus:border-moss focus:outline-none sm:w-64"
        />
      </div>

      {error && (
        <p className="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          {error}
        </p>
      )}

      {!loading && !error && items.length === 0 && (
        <p className="rounded-xl border border-dashed border-peach/60 px-4 py-10 text-center text-sm text-ink/60">
          Chưa có biến động nào khớp bộ lọc.
        </p>
      )}

      <div className="space-y-8">
        {groups.map((g) => (
          <section key={g.label}>
            <h2 className="mb-3 text-sm font-semibold capitalize text-ink/70">
              {g.label}
            </h2>
            <ol className="ml-2 border-l border-peach/60">
              {g.rows.map((m) => {
                const meta = REASON_META[m.reason];
                const up = m.change > 0;
                return (
                  <li key={m.id} className="relative pb-4 pl-6 last:pb-0">
                    <span
                      aria-hidden
                      className={
                        "absolute -left-[5px] top-4 h-2.5 w-2.5 rounded-full " +
                        (up ? "bg-emerald-600" : "bg-red-500")
                      }
                    />
                    <div className="flex items-start justify-between gap-4 rounded-2xl border border-peach/40 bg-white px-4 py-3">
                      <div className="min-w-0">
                        <p className="text-xs text-ink/50">
                          {timeLabel(m.createdAt)}
                        </p>
                        <button
                          type="button"
                          onClick={() => setQ(m.productName)}
                          title="Lọc theo sản phẩm này"
                          className="mt-0.5 text-left font-medium text-ink hover:text-moss-dark"
                        >
                          {m.productName}
                        </button>
                        <div className="mt-1.5 flex flex-wrap items-center gap-2">
                          <span
                            className={
                              "rounded-full border px-2.5 py-0.5 text-xs font-medium " +
                              meta.tone
                            }
                          >
                            {meta.label}
                          </span>
                          {m.orderId && (
                            <span className="text-xs text-ink/50">
                              Đơn #{m.orderId}
                            </span>
                          )}
                        </div>
                        {m.note && (
                          <p className="mt-1.5 text-xs text-ink/60">{m.note}</p>
                        )}
                      </div>
                      <div className="shrink-0 text-right">
                        <p
                          className={
                            "font-heading text-2xl font-semibold tabular-nums " +
                            (up ? "text-emerald-700" : "text-red-600")
                          }
                        >
                          {up ? "+" : ""}
                          {m.change}
                        </p>
                        <p className="text-xs text-ink/50">
                          Tồn: {m.stockAfter}
                        </p>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>

      {loading && (
        <p className="mt-6 text-center text-sm text-ink/50">Đang tải...</p>
      )}

      {!loading && items.length > 0 && (
        <div className="mt-8 text-center">
          <p className="text-xs text-ink/50">
            Đang hiển thị {items.length} / {total} dòng
          </p>
          {items.length < total && (
            <button
              type="button"
              onClick={loadMore}
              className="mt-3 rounded-full border border-peach/60 bg-white px-5 py-2 text-sm font-medium text-ink hover:bg-blush"
            >
              Xem thêm
            </button>
          )}
        </div>
      )}
    </main>
  );
}
