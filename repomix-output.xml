"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import { useCallback, useEffect, useState } from "react";

interface OrderLine {
  name: string;
  quantity: number;
  price: number;
}

interface CustomerOrder {
  id: number;
  status: string;
  paymentMethod: string;
  isPaid: boolean;
  createdAt: string;
  customerName: string;
  phone: string;
  address: string;
  total: number;
  items: OrderLine[];
}

interface CustomerDetail {
  id: number;
  name: string;
  email: string;
  phone: string | null;
  isActive: boolean;
  reviewCount: number;
  orderCount: number;
  totalSpent: number;
  orders: CustomerOrder[];
}

const money = (n: number) => new Intl.NumberFormat("vi-VN").format(n) + "đ";

const STATUS_LABEL: Record<string, string> = {
  pending: "Chờ xác nhận",
  confirmed: "Đã xác nhận",
  shipped: "Đang giao",
  completed: "Hoàn thành",
  cancelled: "Đã hủy",
};

const STATUS_DOT: Record<string, string> = {
  pending: "bg-ochre",
  confirmed: "bg-peach",
  shipped: "bg-moss",
  completed: "bg-emerald-500",
  cancelled: "bg-ink/30",
};

export default function AdminCustomerDetailPage() {
  const params = useParams<{ id: string }>();
  const id = params.id;

  const [customer, setCustomer] = useState<CustomerDetail | null>(null);
  const [loading, setLoading] = useState(true);
  const [notFound, setNotFound] = useState(false);
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);
  const [tempPassword, setTempPassword] = useState("");
  const [copied, setCopied] = useState(false);

  const load = useCallback(async () => {
    try {
      const res = await fetch("/api/admin/customers/" + id);
      if (res.status === 401) {
        window.location.href = "/admin/login?next=/admin/customers/" + id;
        return;
      }
      if (res.status === 404 || res.status === 400) {
        setNotFound(true);
        return;
      }
      const json = await res.json();
      if (!json.success) {
        setError(json.message ?? "Không tải được thông tin khách hàng");
        return;
      }
      setCustomer(json.data);
      setError("");
    } catch {
      setError("Không kết nối được máy chủ, vui lòng thử lại");
    } finally {
      setLoading(false);
    }
  }, [id]);

  useEffect(() => {
    load();
  }, [load]);

  async function runAction(action: "lock" | "unlock" | "reset_password") {
    if (!customer) return;

    const ask =
      action === "lock"
        ? `Khóa tài khoản của ${customer.name}? Khách sẽ không đăng nhập và đặt hàng được nữa.`
        : action === "unlock"
          ? `Mở khóa tài khoản của ${customer.name}?`
          : `Đặt lại mật khẩu cho ${customer.name}? Mật khẩu cũ sẽ không dùng được nữa.`;
    if (!window.confirm(ask)) return;

    setBusy(true);
    setError("");
    setCopied(false);
    try {
      const res = await fetch("/api/admin/customers/" + customer.id, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action }),
      });
      const json = await res.json();
      if (!json.success) {
        setError(json.message ?? "Không thực hiện được");
        return;
      }
      if (action === "reset_password") {
        setTempPassword(json.data.tempPassword);
      } else {
        setTempPassword("");
        setCustomer({ ...customer, isActive: json.data.isActive });
      }
    } catch {
      setError("Không kết nối được máy chủ, vui lòng thử lại");
    } finally {
      setBusy(false);
    }
  }

  async function copyPassword() {
    try {
      await navigator.clipboard.writeText(tempPassword);
      setCopied(true);
    } catch {
      setCopied(false);
    }
  }

  if (loading) {
    return (
      <main className="mx-auto max-w-4xl px-4 py-16 text-center text-sm text-ink/50">
        Đang tải thông tin khách hàng...
      </main>
    );
  }

  if (notFound || !customer) {
    return (
      <main className="mx-auto max-w-4xl px-4 py-16 text-center">
        <p className="font-heading text-2xl text-ink">
          {notFound ? "Không tìm thấy khách hàng" : "Có lỗi xảy ra"}
        </p>
        {error && <p className="mt-2 text-sm text-moss-dark">{error}</p>}
        <Link
          href="/admin/customers"
          className="mt-6 inline-block rounded-full bg-ink px-5 py-2 text-sm text-paper"
        >
          Về sổ khách hàng
        </Link>
      </main>
    );
  }

  return (
    <main className="mx-auto max-w-4xl px-4 py-8 sm:px-6">
      <Link
        href="/admin/customers"
        className="text-sm text-ink/60 transition hover:text-ink"
      >
        ← Sổ khách hàng
      </Link>

      {/* Dải hồ sơ */}
      <section className="mt-4 overflow-hidden rounded-3xl bg-ink text-paper shadow-warm-lg">
        <div className="flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
          <div className="flex items-center gap-4">
            <span className="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-peach font-heading text-3xl text-ink">
              {customer.name.trim().charAt(0).toUpperCase()}
            </span>
            <div className="min-w-0">
              <h1 className="truncate font-heading text-2xl sm:text-3xl">
                {customer.name}
              </h1>
              <p className="truncate text-sm text-paper/70">{customer.email}</p>
              <p className="text-sm text-paper/70">
                {customer.phone ?? "Chưa có số điện thoại"}
              </p>
            </div>
          </div>
          <span
            className={
              "w-fit -rotate-2 rounded-md border-2 border-dashed px-3 py-1 text-xs font-semibold uppercase tracking-widest " +
              (customer.isActive
                ? "border-emerald-300 text-emerald-300"
                : "border-ochre text-ochre")
            }
          >
            {customer.isActive ? "Đang hoạt động" : "Đã bị khóa"}
          </span>
        </div>

        <div className="flex flex-wrap gap-3 border-t border-paper/15 bg-paper/5 px-6 py-4 sm:px-8">
          <button
            type="button"
            disabled={busy}
            onClick={() => runAction(customer.isActive ? "lock" : "unlock")}
            className={
              "rounded-full px-5 py-2 text-sm font-medium transition disabled:opacity-50 " +
              (customer.isActive
                ? "bg-ochre text-ink hover:bg-ochre/80"
                : "bg-moss text-white hover:bg-moss-dark")
            }
          >
            {customer.isActive ? "Khóa tài khoản" : "Mở khóa tài khoản"}
          </button>
          <button
            type="button"
            disabled={busy}
            onClick={() => runAction("reset_password")}
            className="rounded-full border border-paper/40 px-5 py-2 text-sm text-paper transition hover:border-paper disabled:opacity-50"
          >
            Đặt lại mật khẩu
          </button>
        </div>
      </section>

      {error && (
        <p className="mt-4 rounded-2xl bg-blush px-4 py-3 text-sm text-moss-dark">
          {error}
        </p>
      )}

      {tempPassword && (
        <section className="mt-4 rounded-3xl border-2 border-dashed border-ochre bg-ochre/15 p-5">
          <p className="text-sm font-medium text-ink">
            Mật khẩu tạm của {customer.name}
          </p>
          <div className="mt-2 flex flex-wrap items-center gap-3">
            <code className="rounded-xl bg-white px-4 py-2 text-lg tracking-widest text-ink">
              {tempPassword}
            </code>
            <button
              type="button"
              onClick={copyPassword}
              className="rounded-full bg-ink px-4 py-2 text-sm text-paper"
            >
              {copied ? "Đã chép" : "Chép"}
            </button>
          </div>
          <p className="mt-3 text-xs text-ink/70">
            Mật khẩu này chỉ hiện một lần, tải lại trang là mất. Hãy gửi cho
            khách ngay và nhắc khách đổi lại sau khi đăng nhập.
          </p>
        </section>
      )}

      {/* Dải số liệu */}
      <section className="mt-6 grid grid-cols-3 divide-x divide-ink/10 rounded-3xl bg-card py-5 shadow-warm">
        <div className="px-4 text-center">
          <p className="font-heading text-2xl text-ink">
            {customer.orderCount}
          </p>
          <p className="text-xs text-ink/60">Đơn (chưa hủy)</p>
        </div>
        <div className="px-4 text-center">
          <p className="font-heading text-2xl text-ink">
            {money(customer.totalSpent)}
          </p>
          <p className="text-xs text-ink/60">Tổng đã mua</p>
        </div>
        <div className="px-4 text-center">
          <p className="font-heading text-2xl text-ink">
            {customer.reviewCount}
          </p>
          <p className="text-xs text-ink/60">Đánh giá đã viết</p>
        </div>
      </section>

      {/* Lịch sử đơn */}
      <section className="mt-8">
        <h2 className="font-heading text-xl text-ink">Lịch sử đơn hàng</h2>

        {customer.orders.length === 0 ? (
          <p className="mt-4 rounded-2xl bg-blush px-4 py-6 text-center text-sm text-ink/60">
            Khách này chưa đặt đơn nào.
          </p>
        ) : (
          <ol className="mt-5 ml-2 border-l-2 border-dashed border-ink/20">
            {customer.orders.map((o) => (
              <li key={o.id} className="relative pb-5 pl-6">
                <span
                  className={
                    "absolute -left-[9px] top-4 h-4 w-4 rounded-full border-2 border-paper " +
                    (STATUS_DOT[o.status] ?? "bg-ink/30")
                  }
                />
                <details className="group rounded-2xl bg-card shadow-warm">
                  <summary className="flex cursor-pointer list-none flex-wrap items-center justify-between gap-2 px-5 py-4">
                    <div>
                      <p className="font-medium text-ink">Mã đơn #{o.id}</p>
                      <p className="text-xs text-ink/60">
                        {new Date(o.createdAt).toLocaleString("vi-VN")}
                      </p>
                    </div>
                    <div className="flex flex-wrap items-center gap-2 text-sm">
                      <span className="rounded-full bg-blush px-3 py-1 text-xs text-ink">
                        {STATUS_LABEL[o.status] ?? o.status}
                      </span>
                      <span className="font-medium text-ink">
                        {money(o.total)}
                      </span>
                      <span className="text-ink/40 transition group-open:rotate-180">
                        ▾
                      </span>
                    </div>
                  </summary>

                  <div className="border-t border-ink/10 px-5 py-4 text-sm">
                    <ul className="space-y-1">
                      {o.items.map((it, i) => (
                        <li key={i} className="flex justify-between gap-3">
                          <span className="text-ink">
                            {it.name}{" "}
                            <span className="text-ink/50">× {it.quantity}</span>
                          </span>
                          <span className="text-ink/70">
                            {money(it.price * it.quantity)}
                          </span>
                        </li>
                      ))}
                    </ul>
                    <div className="mt-3 space-y-0.5 text-ink/70">
                      <p>
                        Giao tới: {o.customerName}, {o.phone}
                      </p>
                      <p>{o.address}</p>
                      <p>
                        Thanh toán:{" "}
                        {o.paymentMethod === "bank_transfer"
                          ? "Chuyển khoản"
                          : "Khi nhận hàng (COD)"}
                        {o.paymentMethod === "bank_transfer" &&
                          (o.isPaid ? " - đã nhận tiền" : " - chưa nhận tiền")}
                      </p>
                    </div>
                  </div>
                </details>
              </li>
            ))}
          </ol>
        )}
      </section>
    </main>
  );
}
</file>

<file path="src/app/admin/login/page.tsx">
"use client";

import { useState, Suspense } from "react";
import Link from "next/link";
import { useRouter, useSearchParams } from "next/navigation";

const fieldClass =
  "w-full rounded-xl border border-ink/15 bg-paper px-4 py-3 text-ink placeholder:text-ink/35 " +
  "transition focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/20 " +
  "[&:-webkit-autofill]:[-webkit-text-fill-color:#33202a] " +
  "[&:-webkit-autofill]:shadow-[inset_0_0_0_1000px_#fff7f3]";

// Chiếc cúc áo 4 lỗ, màu lấy từ currentColor
function ButtonShape({ className = "" }: { className?: string }) {
  return (
    <svg viewBox="0 0 100 100" aria-hidden className={className}>
      <circle cx="50" cy="50" r="48" fill="currentColor" />
      <circle
        cx="50"
        cy="50"
        r="36"
        fill="none"
        stroke="#33202a"
        strokeOpacity="0.1"
        strokeWidth="3"
      />
      <g fill="#33202a" fillOpacity="0.25">
        <circle cx="40" cy="40" r="5" />
        <circle cx="60" cy="40" r="5" />
        <circle cx="40" cy="60" r="5" />
        <circle cx="60" cy="60" r="5" />
      </g>
      <g
        stroke="#33202a"
        strokeOpacity="0.3"
        strokeWidth="2.5"
        strokeLinecap="round"
      >
        <line x1="40" y1="40" x2="60" y2="60" />
        <line x1="60" y1="40" x2="40" y2="60" />
      </g>
    </svg>
  );
}

function AdminLoginForm() {
  const router = useRouter();
  const searchParams = useSearchParams();

  // Chỉ chấp nhận quay lại các trang thuộc khu /admin, còn lại về trang tổng quan
  const rawNext = searchParams.get("next");
  const next =
    rawNext && rawNext.startsWith("/admin") && !rawNext.startsWith("//")
      ? rawNext
      : "/admin";

  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setError("");
    setLoading(true);

    try {
      const res = await fetch("/api/admin/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username, password }),
      });
      const data = await res.json();

      if (!data.success) {
        setError(data.message);
        return;
      }

      router.push(next);
      router.refresh();
    } catch {
      setError("Không thể kết nối tới server, vui lòng thử lại");
    } finally {
      setLoading(false);
    }
  }

  return (
    // Phủ kín màn hình để che Header/Footer của khu khách
    <div className="fixed inset-0 z-[60] overflow-y-auto overflow-x-hidden bg-paper text-ink">
      <style>{`
        @keyframes admin-bob {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-10px); }
        }
        @media (prefers-reduced-motion: no-preference) {
          .admin-bob { animation: admin-bob 7s ease-in-out infinite; }
        }
      `}</style>

      {/* Cúc áo trang trí, màu nhạt để không tranh với form */}
      <ButtonShape className="admin-bob pointer-events-none absolute -left-16 -top-16 h-56 w-56 text-blush sm:h-72 sm:w-72" />
      <ButtonShape className="admin-bob pointer-events-none absolute -bottom-20 -right-12 h-64 w-64 text-peach/60 sm:h-80 sm:w-80" />
      <ButtonShape className="admin-bob pointer-events-none absolute bottom-16 left-[12%] hidden h-14 w-14 text-ochre/70 md:block" />

      <div className="relative flex min-h-full flex-col items-center justify-center px-5 py-10">
        <div className="relative w-full max-w-md">
          {/* Nhãn vàng nghiêng đè lên mép trên thẻ */}
          <span className="absolute -top-4 right-6 z-10 rotate-3 bg-ochre px-4 py-1.5 text-sm font-semibold tracking-wide text-ink shadow-warm">
            Chỉ dành cho quản trị
          </span>

          <div className="overflow-hidden rounded-3xl bg-card shadow-warm-lg">
            {/* Đầu thẻ màu mận */}
            <div className="relative bg-ink px-8 pb-8 pt-9 text-paper sm:px-10">
              {/* Đường chỉ khâu dọc theo mép dưới */}
              <div className="pointer-events-none absolute inset-x-4 bottom-3 border-t-2 border-dashed border-paper/25" />

              <div className="flex items-center gap-3">
                <span className="font-heading flex h-10 w-10 items-center justify-center rounded-full bg-moss text-lg font-semibold text-white">
                  C
                </span>
                <span className="text-xs font-medium tracking-[0.2em] text-paper/70">
                  CỎ MAY · HANDMADE
                </span>
              </div>
              <h1 className="font-heading mt-6 text-4xl font-semibold leading-tight">
                Khu vực quản trị
              </h1>
              <p className="mt-2 text-sm text-paper/65">
                Đăng nhập để quản lý đơn hàng và sản phẩm của shop.
              </p>
            </div>

            {/* Form */}
            <form
              onSubmit={handleSubmit}
              className="flex flex-col gap-5 px-8 pb-8 pt-7 sm:px-10 sm:pb-10"
            >
              <div>
                <label
                  htmlFor="username"
                  className="mb-1.5 block text-sm font-medium"
                >
                  Tên đăng nhập
                </label>
                <input
                  id="username"
                  type="text"
                  value={username}
                  onChange={(e) => setUsername(e.target.value)}
                  required
                  autoComplete="username"
                  className={fieldClass}
                />
              </div>

              <div>
                <label
                  htmlFor="password"
                  className="mb-1.5 block text-sm font-medium"
                >
                  Mật khẩu
                </label>
                <div className="relative">
                  <input
                    id="password"
                    type={showPassword ? "text" : "password"}
                    value={password}
                    onChange={(e) => setPassword(e.target.value)}
                    required
                    autoComplete="current-password"
                    className={`${fieldClass} pr-16`}
                  />
                  <button
                    type="button"
                    onClick={() => setShowPassword((v) => !v)}
                    className="absolute inset-y-0 right-0 px-4 text-sm font-medium text-moss-dark transition-colors hover:text-ink"
                  >
                    {showPassword ? "Ẩn" : "Hiện"}
                  </button>
                </div>
              </div>

              {error && (
                <p
                  role="alert"
                  className="rounded-xl border-l-4 border-moss-dark bg-blush px-4 py-3 text-sm text-moss-dark"
                >
                  {error}
                </p>
              )}

              <button
                type="submit"
                disabled={loading}
                className="mt-1 rounded-full bg-moss py-3.5 font-semibold text-white shadow-warm transition hover:bg-moss-dark disabled:opacity-50"
              >
                {loading ? "Đang xử lý..." : "Vào trang quản trị"}
              </button>
            </form>
          </div>

          <div className="mt-6 text-center">
            <Link
              href="/"
              className="text-sm font-medium text-ink/60 underline-offset-4 transition-colors hover:text-ink hover:underline"
            >
              ← Về cửa hàng
            </Link>
          </div>
        </div>
      </div>
    </div>
  );
}

export default function AdminLoginPage() {
  return (
    <Suspense
      fallback={
        <div className="fixed inset-0 z-[60] flex items-center justify-center bg-paper text-ink/60">
          Đang tải...
        </div>
      }
    >
      <AdminLoginForm />
    </Suspense>
  );
}
</file>

<file path="src/app/admin/orders/[id]/invoice/page.tsx">
"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useParams } from "next/navigation";
import { formatVND } from "../../../../../../lib/format";

type OrderItem = {
  id: number;
  quantity: number;
  priceAtOrder: string; // Prisma Decimal -> chuỗi
  product: { id: number; name: string };
};

type Order = {
  id: number;
  customerName: string;
  phone: string;
  address: string;
  status: string;
  paymentMethod: string; // "cod" | "bank_transfer"
  isPaid: boolean;
  paidAt: string | null;
  shippingFee?: string;
  discountAmount?: string;
  shippingDiscount?: string;
  createdAt: string;
  orderItems: OrderItem[];
};

const paymentLabels: Record<string, string> = {
  cod: "Thanh toán khi nhận hàng (COD)",
  bank_transfer: "Chuyển khoản ngân hàng",
};

// Quy tắc in: chỉ giữ lại tờ hóa đơn, ẩn Header/Footer và các nút
const PRINT_CSS = `
@page { size: A4; margin: 12mm; }
@media print {
  html, body { height: auto !important; background: #fff !important; }
  body * { visibility: hidden !important; }
  #invoice-root { position: static !important; overflow: visible !important; background: #fff !important; }
  #invoice-sheet, #invoice-sheet * { visibility: visible !important; }
  #invoice-sheet {
    position: absolute !important; left: 0; top: 0; width: 100%;
    margin: 0 !important; padding: 0 !important; border: 0 !important; box-shadow: none !important;
  }
}
`;

export default function InvoicePage() {
  const params = useParams<{ id: string }>();
  const orderId = Number(params.id);

  const [order, setOrder] = useState<Order | null>(null);
  const [state, setState] = useState<
    "loading" | "ready" | "notfound" | "login" | "error"
  >("loading");

  useEffect(() => {
    let cancelled = false;

    async function load() {
      try {
        const res = await fetch("/api/admin/orders");
        const json = await res.json();
        if (cancelled) return;

        if (res.status === 401) {
          setState("login");
          return;
        }
        if (!res.ok || !json.success) {
          setState("error");
          return;
        }

        const found = (json.data as Order[]).find((o) => o.id === orderId);
        if (!found) {
          setState("notfound");
          return;
        }
        setOrder(found);
        setState("ready");
      } catch {
        if (!cancelled) setState("error");
      }
    }

    load();
    return () => {
      cancelled = true;
    };
  }, [orderId]);

  // Che Header/Footer của web khi xem trên màn hình
  const shell = "fixed inset-0 z-[60] overflow-y-auto bg-neutral-100 px-4 py-8";

  if (state !== "ready" || !order) {
    return (
      <div id="invoice-root" className={shell}>
        <div className="mx-auto max-w-md pt-20 text-center">
          {state === "loading" && (
            <p className="text-neutral-600">Đang tải hóa đơn...</p>
          )}
          {state === "login" && (
            <>
              <p className="text-neutral-700">
                Bạn cần đăng nhập quản trị để xem hóa đơn.
              </p>
              <Link
                href={`/admin/login?next=/admin/orders/${params.id}/invoice`}
                className="mt-4 inline-block rounded-lg bg-black px-5 py-2.5 text-white"
              >
                Đăng nhập quản trị
              </Link>
            </>
          )}
          {state === "notfound" && (
            <>
              <p className="text-neutral-700">
                Không tìm thấy đơn hàng #{params.id}.
              </p>
              <Link
                href="/admin/orders"
                className="mt-4 inline-block rounded-lg bg-black px-5 py-2.5 text-white"
              >
                Về danh sách đơn
              </Link>
            </>
          )}
          {state === "error" && (
            <p className="text-red-700">
              Không tải được hóa đơn, vui lòng thử lại.
            </p>
          )}
        </div>
      </div>
    );
  }

  const itemsTotal = order.orderItems.reduce(
    (sum, it) => sum + Number(it.priceAtOrder) * it.quantity,
    0,
  );
  const shipping = Number(order.shippingFee ?? 0);
  const discount = Number(order.discountAmount ?? 0);
  const shippingDiscount = Number(order.shippingDiscount ?? 0);
  const total = Math.max(
    0,
    itemsTotal + shipping - discount - shippingDiscount,
  );
  const created = new Date(order.createdAt);
  const cancelled = order.status === "cancelled";

  return (
    <div id="invoice-root" className={shell}>
      <style>{PRINT_CSS}</style>

      {/* Thanh công cụ (không in) */}
      <div className="mx-auto mb-4 flex max-w-[210mm] items-center justify-between gap-3">
        <Link
          href="/admin/orders"
          className="text-sm text-neutral-600 hover:text-black"
        >
          ← Về danh sách đơn
        </Link>
        <button
          type="button"
          onClick={() => window.print()}
          className="rounded-full bg-black px-6 py-2 text-sm font-medium text-white shadow transition hover:bg-neutral-800"
        >
          🖨 In hóa đơn
        </button>
      </div>

      {/* Tờ hóa đơn */}
      <div
        id="invoice-sheet"
        className="relative mx-auto max-w-[210mm] bg-white p-8 text-black shadow-md sm:p-12"
      >
        {cancelled && (
          <p
            aria-hidden
            className="pointer-events-none absolute right-10 top-40 -rotate-12 rounded-md border-4 border-double border-red-600 px-4 py-1 text-2xl font-bold uppercase tracking-widest text-red-600 opacity-70"
          >
            Đã hủy
          </p>
        )}

        {/* Đầu hóa đơn */}
        <header className="flex flex-wrap items-start justify-between gap-4 border-b-2 border-black pb-5">
          <div>
            <p className="font-heading text-2xl font-semibold">
              Cỏ May Handmade
            </p>
            <p className="mt-0.5 text-sm text-neutral-600">
              Đồ thủ công làm tay từng món
            </p>
          </div>
          <div className="text-right">
            <p className="font-heading text-3xl font-semibold uppercase tracking-wide">
              Hóa đơn
            </p>
            <p className="mt-0.5 text-sm">
              Số: <span className="font-semibold">#{order.id}</span>
            </p>
            <p className="text-sm text-neutral-600">
              {created.toLocaleDateString("vi-VN")}{" "}
              {created.toLocaleTimeString("vi-VN", {
                hour: "2-digit",
                minute: "2-digit",
              })}
            </p>
          </div>
        </header>

        {/* Người nhận + thanh toán */}
        <section className="mt-5 grid gap-5 text-sm sm:grid-cols-2">
          <div>
            <p className="text-xs font-semibold uppercase tracking-wider text-neutral-500">
              Người nhận
            </p>
            <p className="mt-1 text-base font-medium">{order.customerName}</p>
            <p>{order.phone}</p>
            <p className="mt-1 whitespace-pre-line text-neutral-700">
              {order.address}
            </p>
          </div>
          <div>
            <p className="text-xs font-semibold uppercase tracking-wider text-neutral-500">
              Thanh toán
            </p>
            <p className="mt-1">
              {paymentLabels[order.paymentMethod] ?? order.paymentMethod}
            </p>
            <p className="mt-1 font-medium">
              {order.isPaid
                ? `Đã thanh toán${
                    order.paidAt
                      ? ` lúc ${new Date(order.paidAt).toLocaleString("vi-VN")}`
                      : ""
                  }`
                : "Chưa thanh toán"}
            </p>
          </div>
        </section>

        {/* Bảng sản phẩm */}
        <table className="mt-6 w-full border-collapse text-sm">
          <thead>
            <tr className="border-y border-black text-left text-xs uppercase tracking-wider">
              <th className="w-10 py-2">STT</th>
              <th className="py-2">Sản phẩm</th>
              <th className="w-12 py-2 text-right">SL</th>
              <th className="w-28 py-2 text-right">Đơn giá</th>
              <th className="w-32 py-2 text-right">Thành tiền</th>
            </tr>
          </thead>
          <tbody>
            {order.orderItems.map((it, i) => (
              <tr key={it.id} className="border-b border-neutral-300 align-top">
                <td className="py-2.5">{i + 1}</td>
                <td className="py-2.5 pr-3">{it.product.name}</td>
                <td className="py-2.5 text-right tabular-nums">
                  {it.quantity}
                </td>
                <td className="py-2.5 text-right tabular-nums">
                  {formatVND(Number(it.priceAtOrder))}
                </td>
                <td className="py-2.5 text-right tabular-nums">
                  {formatVND(Number(it.priceAtOrder) * it.quantity)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        {/* Tổng kết tiền */}
        <dl className="ml-auto mt-4 w-full max-w-xs space-y-1 text-sm">
          <div className="flex justify-between gap-4">
            <dt className="text-neutral-600">Tiền hàng</dt>
            <dd className="tabular-nums">{formatVND(itemsTotal)}</dd>
          </div>
          <div className="flex justify-between gap-4">
            <dt className="text-neutral-600">Phí vận chuyển</dt>
            <dd className="tabular-nums">{formatVND(shipping)}</dd>
          </div>
          {discount > 0 && (
            <div className="flex justify-between gap-4">
              <dt className="text-neutral-600">Giảm giá đơn hàng</dt>
              <dd className="tabular-nums">-{formatVND(discount)}</dd>
            </div>
          )}
          {shippingDiscount > 0 && (
            <div className="flex justify-between gap-4">
              <dt className="text-neutral-600">Giảm phí vận chuyển</dt>
              <dd className="tabular-nums">-{formatVND(shippingDiscount)}</dd>
            </div>
          )}
          <div className="flex justify-between gap-4 border-t-2 border-black pt-2 text-base font-semibold">
            <dt>Tổng cộng</dt>
            <dd className="tabular-nums">{formatVND(total)}</dd>
          </div>
        </dl>

        {/* Chân hóa đơn */}
        <footer className="mt-10 flex items-end justify-between gap-6 border-t border-neutral-300 pt-5 text-sm">
          <p className="text-neutral-600">
            Cảm ơn bạn đã ủng hộ Cỏ May Handmade ♥
          </p>
          <div className="w-40 text-center text-neutral-600">
            <p>Người lập phiếu</p>
            <p className="mt-12 border-t border-neutral-400 pt-1 text-xs">
              (Ký, ghi rõ họ tên)
            </p>
          </div>
        </footer>
      </div>
    </div>
  );
}
