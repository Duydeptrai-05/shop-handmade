<file path="src/app/api/orders/[id]/route.ts">
import { NextRequest, NextResponse } from "next/server";
import { prisma } from "../../../../../lib/prisma";
import { getAuthPayload } from "../../../../../lib/auth";
import { updateOrderSchema } from "../../../../../lib/validation/order";
import { cancelExpiredBankOrders } from "../../../../../lib/expire-orders";
import { logStockMovement } from "../../../../../lib/stock";

class OrderError extends Error {
  status: number;
  constructor(message: string, status = 400) {
    super(message);
    this.status = status;
  }
}

// Khách hủy đơn hoặc đổi thông tin nhận hàng (chỉ khi đơn còn "pending")
export async function PATCH(
  request: NextRequest,
  { params }: { params: Promise<{ id: string }> },
) {
  try {
    // 1. Xác thực: customerId lấy từ token
    const payload = await getAuthPayload();
    if (!payload || payload.role !== "customer") {
      return NextResponse.json(
        { success: false, message: "Bạn cần đăng nhập" },
        { status: 401 },
      );
    }

    // 2. Mã đơn trên URL
    const { id } = await params;
    const orderId = Number(id);
    if (!Number.isInteger(orderId) || orderId <= 0) {
      return NextResponse.json(
        { success: false, message: "Mã đơn không hợp lệ" },
        { status: 400 },
      );
    }

    // Hủy trước các đơn chuyển khoản quá hạn để trạng thái luôn đúng
    await cancelExpiredBankOrders().catch((e) =>
      console.error("cancelExpiredBankOrders (PATCH /api/orders/[id]):", e),
    );

    // 3. Validate body
    let body: unknown;
    try {
      body = await request.json();
    } catch {
      return NextResponse.json(
        { success: false, message: "Dữ liệu gửi lên không hợp lệ" },
        { status: 400 },
      );
    }
    const parsed = updateOrderSchema.safeParse(body);
    if (!parsed.success) {
      return NextResponse.json(
        {
          success: false,
          message: "Dữ liệu không hợp lệ",
          errors: parsed.error.flatten(),
        },
        { status: 400 },
      );
    }
    const input = parsed.data;

    // 4. Tìm đơn CỦA CHÍNH khách này (đơn người khác -> 404, không lộ là có tồn tại)
    const order = await prisma.order.findFirst({
      where: { id: orderId, customerId: payload.id },
      include: { orderItems: true },
    });
    if (!order) {
      throw new OrderError("Không tìm thấy đơn hàng", 404);
    }

    // 5. Chỉ sửa được khi shop chưa xác nhận
    if (order.status !== "pending") {
      throw new OrderError(
        order.status === "cancelled"
          ? "Đơn này đã được hủy trước đó"
          : "Shop đã xác nhận đơn này nên không thể tự thay đổi, vui lòng liên hệ shop",
      );
    }

    if (input.action === "cancel") {
      // Đã chuyển khoản xong thì hoàn tiền là việc thủ công -> không cho tự hủy
      if (order.paymentMethod === "bank_transfer" && order.isPaid) {
        throw new OrderError(
          "Đơn này đã thanh toán chuyển khoản, vui lòng liên hệ shop để được hỗ trợ hủy và hoàn tiền",
        );
      }

      await prisma.$transaction(async (tx) => {
        // Điều kiện status = pending ngay trong câu update:
        // nếu Admin vừa xác nhận cùng lúc thì count = 0, không hủy nhầm
        const result = await tx.order.updateMany({
          where: { id: orderId, customerId: payload.id, status: "pending" },
          data: { status: "cancelled" },
        });
        if (result.count === 0) {
          throw new OrderError(
            "Trạng thái đơn vừa thay đổi, vui lòng tải lại trang",
            409,
          );
        }

        // Hoàn kho cho từng món và ghi lịch sử
        for (const item of order.orderItems) {
          await tx.product.update({
            where: { id: item.productId },
            data: { stock: { increment: item.quantity } },
          });

          await logStockMovement(tx, {
            productId: item.productId,
            change: item.quantity,
            reason: "cancel_restore",
            orderId,
            note: "Khách tự hủy đơn",
          });
        }
      });
    } else {
      // update_address
      const result = await prisma.order.updateMany({
        where: { id: orderId, customerId: payload.id, status: "pending" },
        data: {
          customerName: input.customerName,
          phone: input.phone,
          address: input.address,
        },
      });
      if (result.count === 0) {
        throw new OrderError(
          "Trạng thái đơn vừa thay đổi, vui lòng tải lại trang",
          409,
        );
      }
    }

    // 6. Trả đơn mới nhất, cùng dạng với GET /api/orders
    const updated = await prisma.order.findUnique({
      where: { id: orderId },
      include: { orderItems: { include: { product: true } } },
    });

    return NextResponse.json({ success: true, data: updated });
  } catch (error) {
    if (error instanceof OrderError) {
      return NextResponse.json(
        { success: false, message: error.message },
        { status: error.status },
      );
    }
    console.error("PATCH /api/orders/[id] error:", error);
    return NextResponse.json(
      { success: false, message: "Có lỗi xảy ra, vui lòng thử lại" },
      { status: 500 },
    );
  }
}
</file>

<file path="src/app/api/products/[id]/reviews/route.ts">
import { NextResponse } from "next/server";
import { prisma } from "../../../../../../lib/prisma";
import { getAuthPayload } from "../../../../../../lib/auth";
import { createReviewSchema } from "../../../../../../lib/validation/review";

type Context = { params: Promise<{ id: string }> };

function parseId(raw: string): number | null {
  const id = Number(raw);
  return Number.isInteger(id) && id > 0 ? id : null;
}

// Lấy customerId từ token; null nếu chưa đăng nhập hoặc không phải Customer
async function getCustomerId(): Promise<number | null> {
  const payload = await getAuthPayload();
  if (!payload || payload.role !== "customer") return null;
  return Number(payload.id); // <-- xem ghi chú bên dưới
}

// Khách có đơn completed chứa sản phẩm này không?
async function hasPurchased(customerId: number, productId: number) {
  const item = await prisma.orderItem.findFirst({
    where: {
      productId,
      order: { customerId, status: "completed" },
    },
    select: { id: true },
  });
  return item !== null;
}

// GET: tình trạng review của khách hiện tại với sản phẩm này
export async function GET(_request: Request, { params }: Context) {
  try {
    const productId = parseId((await params).id);
    if (!productId) {
      return NextResponse.json(
        { success: false, message: "Mã sản phẩm không hợp lệ" },
        { status: 400 },
      );
    }

    const customerId = await getCustomerId();
    if (!customerId) {
      return NextResponse.json({
        success: true,
        data: { loggedIn: false, canReview: false, hasReviewed: false },
      });
    }

    const [purchased, existing] = await Promise.all([
      hasPurchased(customerId, productId),
      prisma.review.findUnique({
        where: { productId_customerId: { productId, customerId } },
        select: { id: true, status: true },
      }),
    ]);

    return NextResponse.json({
      success: true,
      data: {
        loggedIn: true,
        canReview: purchased && !existing,
        hasReviewed: existing !== null,
        reviewStatus: existing?.status ?? null,
      },
    });
  } catch (error) {
    console.error("GET /api/products/[id]/reviews lỗi:", error);
    return NextResponse.json(
      { success: false, message: "Không thể kiểm tra quyền đánh giá" },
      { status: 500 },
    );
  }
}

// POST: viết review
export async function POST(request: Request, { params }: Context) {
  try {
    const customerId = await getCustomerId();
    if (!customerId) {
      return NextResponse.json(
        { success: false, message: "Bạn cần đăng nhập để đánh giá" },
        { status: 401 },
      );
    }

    const productId = parseId((await params).id);
    if (!productId) {
      return NextResponse.json(
        { success: false, message: "Mã sản phẩm không hợp lệ" },
        { status: 400 },
      );
    }

    let body: unknown;
    try {
      body = await request.json();
    } catch {
      return NextResponse.json(
        { success: false, message: "Dữ liệu gửi lên không hợp lệ" },
        { status: 400 },
      );
    }

    const parsed = createReviewSchema.safeParse(body);
    if (!parsed.success) {
      return NextResponse.json(
        { success: false, message: parsed.error.issues[0].message },
        { status: 400 },
      );
    }

    const product = await prisma.product.findFirst({
      where: { id: productId, isActive: true },
      select: { id: true },
    });
    if (!product) {
      return NextResponse.json(
        { success: false, message: "Không tìm thấy sản phẩm" },
        { status: 404 },
      );
    }

    if (!(await hasPurchased(customerId, productId))) {
      return NextResponse.json(
        {
          success: false,
          message:
            "Bạn chỉ có thể đánh giá sản phẩm đã mua và đơn hàng đã hoàn thành",
        },
        { status: 403 },
      );
    }

    try {
      const review = await prisma.review.create({
        data: {
          productId,
          customerId,
          rating: parsed.data.rating,
          comment: parsed.data.comment ?? null,
          status: "pending",
        },
      });
      return NextResponse.json(
        { success: true, data: review },
        { status: 201 },
      );
    } catch (e) {
      // P2002 = vi phạm UNIQUE(productId, customerId): đã đánh giá rồi
      if (
        typeof e === "object" &&
        e !== null &&
        "code" in e &&
        (e as { code?: string }).code === "P2002"
      ) {
        return NextResponse.json(
          { success: false, message: "Bạn đã đánh giá sản phẩm này rồi" },
          { status: 409 },
        );
      }
      throw e;
    }
  } catch (error) {
    console.error("POST /api/products/[id]/reviews lỗi:", error);
    return NextResponse.json(
      { success: false, message: "Không thể gửi đánh giá" },
      { status: 500 },
    );
  }
}
</file>

<file path="src/app/products/page.tsx">
import ProductSearch from "../../components/ProductSearch";
import { prisma } from "../../../lib/prisma";
import ProductCard from "../../components/ProductCard";
import Reveal from "../../components/Reveal";
import Link from "next/link";

const PAGE_SIZE = 12;

const SORT_OPTIONS: Record<string, string> = {
  "": "Mặc định",
  newest: "Mới nhất",
  price_asc: "Giá tăng dần",
  price_desc: "Giá giảm dần",
  popular: "Bán chạy nhất",
};

// Đọc giá từ URL: chỉ nhận số nguyên không âm
function parsePrice(v?: string): number | null {
  if (!v) return null;
  const n = Number(v);
  return Number.isFinite(n) && n >= 0 ? Math.floor(n) : null;
}

export default async function ProductsPage({
  searchParams,
}: {
  searchParams: Promise<{
    category?: string;
    q?: string;
    sort?: string;
    min?: string;
    max?: string;
    page?: string;
  }>;
}) {
  const sp = await searchParams;

  // Bỏ qua giá trị category không hợp lệ (vd: ?category=abc)
  const categoryId = Number(sp.category);
  const validCategoryId =
    Number.isInteger(categoryId) && categoryId > 0 ? categoryId : null;

  const keyword = sp.q?.trim() ?? "";
  const sort = sp.sort && sp.sort in SORT_OPTIONS ? sp.sort : "";

  let minPrice = parsePrice(sp.min);
  let maxPrice = parsePrice(sp.max);
  // Nhập ngược (min > max) thì tự đổi chỗ
  if (minPrice !== null && maxPrice !== null && minPrice > maxPrice) {
    [minPrice, maxPrice] = [maxPrice, minPrice];
  }

  const [categories, allProducts] = await Promise.all([
    prisma.category.findMany({ orderBy: { name: "asc" } }),
    prisma.product.findMany({
      where: {
        isActive: true,
        ...(validCategoryId ? { categoryId: validCategoryId } : {}),
      },
      orderBy: { id: "asc" },
    }),
  ]);

  // Lọc theo tên ở đây thay vì trong SQL: collation của MariaDB bỏ qua dấu
  // nên "thỏ" sẽ khớp cả "thơm". So sánh bằng JS thì phân biệt dấu,
  // chỉ bỏ qua hoa/thường.
  const normalize = (s: string) => s.normalize("NFC").toLowerCase();
  let products = allProducts.filter((p) => {
    if (keyword && !normalize(p.name).includes(normalize(keyword)))
      return false;
    const price = Number(p.price);
    if (minPrice !== null && price < minPrice) return false;
    if (maxPrice !== null && price > maxPrice) return false;
    return true;
  });

  // Sắp xếp
  if (sort === "newest") {
    products = [...products].sort((a, b) => b.id - a.id);
  } else if (sort === "price_asc") {
    products = [...products].sort((a, b) => Number(a.price) - Number(b.price));
  } else if (sort === "price_desc") {
    products = [...products].sort((a, b) => Number(b.price) - Number(a.price));
  } else if (sort === "popular") {
    // Tổng số lượng bán ra của các đơn chưa hủy
    const sold = await prisma.orderItem.groupBy({
      by: ["productId"],
      where: { order: { status: { not: "cancelled" } } },
      _sum: { quantity: true },
    });
    const soldMap = new Map(
      sold.map((s) => [s.productId, s._sum.quantity ?? 0]),
    );
    products = [...products].sort(
      (a, b) =>
        (soldMap.get(b.id) ?? 0) - (soldMap.get(a.id) ?? 0) || a.id - b.id,
    );
  }

  // Phân trang (cắt sau khi đã lọc và sắp xếp)
  const total = products.length;
  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
  const rawPage = Number(sp.page);
  const page =
    Number.isInteger(rawPage) && rawPage >= 1
      ? Math.min(rawPage, totalPages)
      : 1;
  const start = (page - 1) * PAGE_SIZE;
  const pageProducts = products.slice(start, start + PAGE_SIZE);

  // Tạo link trong trang /products, giữ lại mọi bộ lọc hiện tại,
  // chỉ ghi đè những giá trị truyền vào
  const current = {
    category: validCategoryId,
    q: keyword,
    sort,
    min: minPrice,
    max: maxPrice,
    page,
  };
  function buildHref(override: Partial<typeof current> = {}) {
    const m = { ...current, ...override };
    const params = new URLSearchParams();
    if (m.category) params.set("category", String(m.category));
    if (m.q) params.set("q", m.q);
    if (m.sort) params.set("sort", m.sort);
    if (m.min !== null) params.set("min", String(m.min));
    if (m.max !== null) params.set("max", String(m.max));
    if (m.page > 1) params.set("page", String(m.page));
    const qs = params.toString();
    return qs ? `/products?${qs}` : "/products";
  }

  const hasFilter = !!(
    keyword ||
    sort ||
    minPrice !== null ||
    maxPrice !== null
  );

  // Kiểu chung cho mục danh mục: đang chọn thì nền nâu mận, chưa chọn thì viền mảnh
  const tabClass = (active: boolean) =>
    `rounded-lg border px-4 py-2 text-sm font-medium transition-colors ${
      active
        ? "border-ink bg-ink text-paper"
        : "border-peach bg-white text-ink/70 hover:border-moss hover:text-moss-dark"
    }`;

  const inputClass =
    "rounded-lg border border-peach bg-white px-3 py-2 text-sm text-ink outline-none focus:border-moss";

  // Dãy số trang: luôn có trang đầu, cuối và 1 trang mỗi bên trang hiện tại
  const pageNumbers: (number | "...")[] = [];
  for (let i = 1; i <= totalPages; i++) {
    if (i === 1 || i === totalPages || Math.abs(i - page) <= 1) {
      pageNumbers.push(i);
    } else if (pageNumbers[pageNumbers.length - 1] !== "...") {
      pageNumbers.push("...");
    }
  }

  return (
    <main className="mx-auto max-w-6xl px-4 pb-20 pt-10">
      {/* Đầu trang: nền hồng nhạt, tiêu đề + mô tả + số món */}
      <Reveal>
        <header className="relative overflow-hidden rounded-2xl bg-blush px-6 py-10 sm:px-10">
          <span
            aria-hidden
            className="pointer-events-none absolute -right-2 -top-6 select-none font-heading text-[9rem] font-semibold leading-none text-white/50 sm:text-[12rem]"
          >
            {total}
          </span>
          <div className="relative max-w-lg">
            <p className="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-moss-dark">
              <span className="h-px w-8 bg-moss-dark" />
              Cửa hàng
            </p>
            <h1 className="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">
              Sản phẩm
            </h1>
            <p className="mt-3 text-sm leading-relaxed text-ink/70">
              Mỗi món đều làm bằng tay, mẻ nhỏ nên số lượng có hạn. Hết là hết,
              mẻ sau có thể sẽ hơi khác một chút.
            </p>
          </div>
        </header>
      </Reveal>

      <div className="mt-8 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
        {/* Danh mục: đổi danh mục thì về trang 1 */}
        <nav className="flex flex-wrap gap-2">
          <Link
            href={buildHref({ category: null, page: 1 })}
            className={tabClass(!validCategoryId)}
          >
            Tất cả
          </Link>
          {categories.map((c) => (
            <Link
              key={c.id}
              href={buildHref({ category: c.id, page: 1 })}
              className={tabClass(validCategoryId === c.id)}
            >
              {c.name}
            </Link>
          ))}
        </nav>

        {/* Ô tìm kiếm: giữ lại danh mục đang chọn */}
        <ProductSearch initialKeyword={keyword} categoryId={validCategoryId} />
      </div>

      {/* Sắp xếp + lọc giá: form GET, gửi lại cả danh mục và từ khóa */}
      <form
        method="GET"
        action="/products"
        className="mt-5 flex flex-wrap items-end gap-3 rounded-xl bg-white p-4 shadow-warm"
      >
        {validCategoryId && (
          <input type="hidden" name="category" value={validCategoryId} />
        )}
        {keyword && <input type="hidden" name="q" value={keyword} />}

        <label className="flex flex-col gap-1 text-xs font-semibold uppercase tracking-wider text-ink/55">
          Sắp xếp
          <select name="sort" defaultValue={sort} className={inputClass}>
            {Object.entries(SORT_OPTIONS).map(([value, label]) => (
              <option key={value} value={value}>
                {label}
              </option>
            ))}
          </select>
        </label>

        <label className="flex flex-col gap-1 text-xs font-semibold uppercase tracking-wider text-ink/55">
          Giá từ (đ)
          <input
            type="number"
            name="min"
            min={0}
            step={1000}
            defaultValue={minPrice ?? ""}
            placeholder="0"
            className={`${inputClass} w-32`}
          />
        </label>

        <label className="flex flex-col gap-1 text-xs font-semibold uppercase tracking-wider text-ink/55">
          Đến (đ)
          <input
            type="number"
            name="max"
            min={0}
            step={1000}
            defaultValue={maxPrice ?? ""}
            placeholder="500000"
            className={`${inputClass} w-32`}
          />
        </label>

        <button
          type="submit"
          className="rounded-lg bg-ink px-5 py-2 text-sm font-medium text-paper transition hover:bg-moss-dark"
        >
          Áp dụng
        </button>

        {hasFilter && (
          <Link
            href={buildHref({ q: "", sort: "", min: null, max: null, page: 1 })}
            className="px-1 py-2 text-sm font-medium text-moss-dark underline underline-offset-4 hover:text-moss"
          >
            Xóa bộ lọc
          </Link>
        )}
      </form>

      {keyword && (
        <p className="mt-6 text-sm text-ink/65">
          Kết quả cho &ldquo;
          <span className="font-semibold text-ink">{keyword}</span>&rdquo;:{" "}
          {total} sản phẩm ·{" "}
          <Link
            href={buildHref({ q: "", page: 1 })}
            className="font-medium text-moss-dark underline underline-offset-4 hover:text-moss"
          >
            Xóa tìm kiếm
          </Link>
        </p>
      )}

      <p className="mt-8 text-sm text-ink/55">
        {total === 0 ? (
          "Không có món nào"
        ) : (
          <>
            Đang hiển thị{" "}
            <span className="font-semibold text-ink">
              {start + 1}–{start + pageProducts.length}
            </span>{" "}
            trên <span className="font-semibold text-ink">{total}</span> món
          </>
        )}
      </p>

      <section className="mt-4 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
        {pageProducts.map((p, i) => (
          <ProductCard
            key={p.id}
            index={i}
            id={p.id}
            name={p.name}
            price={Number(p.price)}
            imageUrl={p.imageUrl}
            stock={p.stock}
          />
        ))}
      </section>

      {total === 0 && (
        <div className="mt-10 rounded-2xl border-2 border-dashed border-peach bg-white px-6 py-14 text-center">
          <p className="font-heading text-xl font-semibold">
            Chưa thấy món nào
          </p>
          <p className="mt-2 text-sm text-ink/65">
            {hasFilter
              ? "Không có món nào khớp với bộ lọc này."
              : "Danh mục này chưa có món nào."}
          </p>
          <Link
            href="/products"
            className="mt-5 inline-block rounded-lg bg-ink px-6 py-3 text-sm font-medium text-paper transition hover:bg-moss-dark"
          >
            Xem tất cả sản phẩm
          </Link>
        </div>
      )}

      {/* Phân trang */}
      {totalPages > 1 && (
        <nav
          aria-label="Phân trang"
          className="mt-12 flex flex-wrap items-center justify-center gap-2"
        >
          {page > 1 && (
            <Link
              href={buildHref({ page: page - 1 })}
              className={tabClass(false)}
            >
              ← Trước
            </Link>
          )}
          {pageNumbers.map((n, idx) =>
            n === "..." ? (
              <span key={`dots-${idx}`} className="px-1 text-ink/40">
                …
              </span>
            ) : (
              <Link
                key={n}
                href={buildHref({ page: n })}
                aria-current={n === page ? "page" : undefined}
                className={tabClass(n === page)}
              >
                {n}
              </Link>
            ),
          )}
          {page < totalPages && (
            <Link
              href={buildHref({ page: page + 1 })}
              className={tabClass(false)}
            >
              Sau →
            </Link>
          )}
        </nav>
      )}
    </main>
  );
}
</file>

