"use client";

import { useCallback, useEffect, useState } from "react";
import { animate, motion } from "motion/react";
import { productSchema } from "../../../../lib/validation/product";

type Category = { id: number; name: string };
type Product = {
  id: number;
  name: string;
  description: string | null;
  price: number;
  imageUrl: string | null;
  stock: number;
  isActive: boolean;
  categoryId: number;
  category: Category;
};
type FormState = {
  name: string;
  description: string;
  price: string;
  stock: string;
  imageUrl: string;
  categoryId: string;
};

const emptyForm: FormState = {
  name: "",
  description: "",
  price: "",
  stock: "0",
  imageUrl: "",
  categoryId: "",
};

// Kho dưới mức này thì cảnh báo "Sắp hết"
const LOW_STOCK = 10;

const formatPrice = (n: number) =>
  new Intl.NumberFormat("vi-VN").format(n) + " ₫";

// Số đếm chạy từ 0 lên giá trị thật
function AnimatedNumber({ value }: { value: number }) {
  const [display, setDisplay] = useState(0);
  useEffect(() => {
    const controls = animate(0, value, {
      duration: 0.8,
      ease: "easeOut",
      onUpdate: (v) => setDisplay(Math.round(v)),
    });
    return () => controls.stop();
  }, [value]);
  return <>{display}</>;
}

export default function AdminProductsPage() {
  const [products, setProducts] = useState<Product[]>([]);
  const [categories, setCategories] = useState<Category[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  // Bộ lọc
  const [keyword, setKeyword] = useState("");
  const [appliedKeyword, setAppliedKeyword] = useState("");
  const [status, setStatus] = useState("");

  // Form thêm/sửa
  const [showForm, setShowForm] = useState(false);
  const [editing, setEditing] = useState<Product | null>(null);
  const [form, setForm] = useState<FormState>(emptyForm);
  const [formError, setFormError] = useState("");
  const [saving, setSaving] = useState(false);
  const [uploading, setUploading] = useState(false);
  const [uploadError, setUploadError] = useState("");

  function goLogin() {
    window.location.href = "/admin/login?next=/admin/products";
  }

  const loadProducts = useCallback(async () => {
    try {
      const params = new URLSearchParams();
      if (appliedKeyword) params.set("q", appliedKeyword);
      if (status) params.set("status", status);
      const res = await fetch(`/api/admin/products?${params.toString()}`);
      if (res.status === 401) {
        goLogin();
        return;
      }
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      setProducts(json.data);
      setError("");
    } catch (e) {
      setError(e instanceof Error ? e.message : "Không thể tải sản phẩm");
    } finally {
      setLoading(false);
    }
  }, [appliedKeyword, status]);

  useEffect(() => {
    loadProducts();
  }, [loadProducts]);

  useEffect(() => {
    fetch("/api/admin/categories")
      .then((r) => r.json())
      .then((json) => {
        if (json.success) setCategories(json.data);
      })
      .catch(() => {});
  }, []);

  function openCreate() {
    setEditing(null);
    setForm(emptyForm);
    setFormError("");
    setUploadError("");
    setShowForm(true);
  }

  function openEdit(p: Product) {
    setEditing(p);
    setForm({
      name: p.name,
      description: p.description ?? "",
      price: String(p.price),
      stock: String(p.stock),
      imageUrl: p.imageUrl ?? "",
      categoryId: String(p.categoryId),
    });
    setFormError("");
    setShowForm(true);
  }

  function closeForm() {
    setShowForm(false);
    setEditing(null);
  }

  async function handleSubmit(e: React.SyntheticEvent) {
    e.preventDefault();
    setFormError("");

    const parsed = productSchema.safeParse(form);
    if (!parsed.success) {
      setFormError(parsed.error.issues[0].message);
      return;
    }

    setSaving(true);
    try {
      const res = await fetch(
        editing ? `/api/admin/products/${editing.id}` : "/api/admin/products",
        {
          method: editing ? "PATCH" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(parsed.data),
        },
      );
      if (res.status === 401) {
        goLogin();
        return;
      }
      const json = await res.json();
      if (!json.success) {
        setFormError(json.message);
        return;
      }
      closeForm();
      await loadProducts();
    } catch {
      setFormError("Không thể kết nối máy chủ");
    } finally {
      setSaving(false);
    }
  }

  async function toggleActive(p: Product) {
    if (
      p.isActive &&
      !window.confirm(`Ẩn sản phẩm "${p.name}" khỏi cửa hàng?`)
    ) {
      return;
    }
    try {
      const res = await fetch(`/api/admin/products/${p.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ isActive: !p.isActive }),
      });
      if (res.status === 401) {
        goLogin();
        return;
      }
      const json = await res.json();
      if (!json.success) {
        setError(json.message);
        return;
      }
      await loadProducts();
    } catch {
      setError("Không thể kết nối máy chủ");
    }
  }

  function setField(name: keyof FormState, value: string) {
    setForm((prev) => ({ ...prev, [name]: value }));
  }

  async function handleFile(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0];
    e.target.value = ""; // cho phép chọn lại đúng file vừa chọn
    if (!file) return;

    setUploadError("");
    setUploading(true);
    try {
      const fd = new FormData();
      fd.append("file", file);
      const res = await fetch("/api/admin/upload", {
        method: "POST",
        body: fd,
      });
      if (res.status === 401) {
        goLogin();
