// ============================================================
// Prisma schema - Shop handmade
// Provider: MariaDB (dùng provider "mysql", MariaDB tương thích
// giao thức MySQL nên Prisma dùng chung provider này)
// Lưu ý: mọi lệnh Prisma phải kèm --config prisma7.config.ts
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ------------------------------------------------------------
// Category
// ------------------------------------------------------------
model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(100)
  products Product[]

  @@map("categories")
}

// ------------------------------------------------------------
// Product
// ------------------------------------------------------------
model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active") // soft delete
  categoryId  Int      @map("category_id")

    category       Category        @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  reviews        Review[]
  stockMovements StockMovement[]
    wishlistedBy   Wishlist[]

  @@index([categoryId])
  @@map("products")
}



// ------------------------------------------------------------
// Customer
// ------------------------------------------------------------
model Customer {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(255)
  email        String  @unique @db.VarChar(255)
  phone        String? @db.VarChar(20)
  passwordHash String  @map("password_hash") @db.VarChar(255) // bcryptjs
  isActive     Boolean @default(true) @map("is_active") // false = Admin đã khóa tài khoản
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  orders    Order[]
  reviews   Review[]
  addresses Address[]
  resetTokens PasswordResetToken[]
  wishlist    Wishlist[]
  customRequests CustomRequest[]

  @@map("customers")
}

// ------------------------------------------------------------
// Address (sổ địa chỉ của khách)
// Mỗi khách có nhiều địa chỉ, tối đa 1 địa chỉ mặc định (kiểm soát ở tầng API)
// Đơn hàng vẫn lưu bản sao tên/SĐT/địa chỉ riêng nên sửa hay xóa địa chỉ ở đây không ảnh hưởng đơn cũ
// ------------------------------------------------------------
model Address {
  id            Int      @id @default(autoincrement())
  customerId    Int      @map("customer_id")
  recipientName String   @map("recipient_name") @db.VarChar(255)
  phone         String   @db.VarChar(20)
  address       String   @db.VarChar(500)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

// ------------------------------------------------------------
// Voucher
// type = discount: giảm tiền hàng; type = shipping: giảm phí ship
// discountKind = percent: value là số % (1-100), maxDiscount là mức giảm tối đa
// discountKind = fixed: value là số tiền giảm cố định
// Mã miễn phí ship = type shipping + percent 100 (hoặc fixed bằng phí ship)
// Số lượt đã dùng đếm từ các đơn chưa hủy, không lưu cột đếm
// ------------------------------------------------------------
enum VoucherType {
  discount
  shipping
}

enum DiscountKind {
  percent
  fixed
}

model Voucher {
  id           Int          @id @default(autoincrement())
  code         String       @unique @db.VarChar(50)
  description  String?      @db.VarChar(255)
  type         VoucherType
  discountKind DiscountKind @map("discount_kind")
  value        Decimal      @db.Decimal(12, 2)
  maxDiscount  Decimal?     @map("max_discount") @db.Decimal(12, 2) // chỉ dùng cho percent, null = không giới hạn
  minOrderValue Decimal     @default(0) @map("min_order_value") @db.Decimal(12, 2) // tính trên tiền hàng
  startsAt     DateTime?    @map("starts_at")
  expiresAt    DateTime?    @map("expires_at")
  usageLimit   Int?         @map("usage_limit") // tổng số lượt dùng, null = không giới hạn
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")

  discountOrders Order[] @relation("OrderDiscountVoucher")
  shippingOrders Order[] @relation("OrderShippingVoucher")

  @@map("vouchers")
}

// ------------------------------------------------------------
// Order
// Tổng tiền khách trả = tổng (priceAtOrder x quantity) - discountAmount
//                       + shippingFee - shippingDiscount
// Các cột tiền đều "đóng băng" tại lúc đặt; đơn cũ có giá trị mặc định 0
// ------------------------------------------------------------
enum OrderStatus {
  pending
  confirmed
  shipped
  completed
  cancelled
}
enum PaymentMethod {
  cod
  bank_transfer
}

model Order {
  id           Int         @id @default(autoincrement())
  customerId   Int         @map("customer_id") // bắt buộc, lấy từ JWT token, không nullable
  customerName String      @map("customer_name") @db.VarChar(255) // tên người nhận, có thể khác tên tài khoản
  phone        String      @db.VarChar(20)
  address      String      @db.VarChar(500)
  status       OrderStatus @default(pending)
  createdAt    DateTime    @default(now()) @map("created_at")

  paymentMethod PaymentMethod @default(cod) @map("payment_method")
  isPaid        Boolean       @default(false) @map("is_paid")
  paidAt        DateTime?     @map("paid_at")

  shippingFee      Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2) // tiền hàng được giảm
  shippingDiscount Decimal @default(0) @map("shipping_discount") @db.Decimal(12, 2) // phí ship được giảm

  discountVoucherId Int? @map("discount_voucher_id")
  shippingVoucherId Int? @map("shipping_voucher_id")

  customer        Customer    @relation(fields: [customerId], references: [id])
  discountVoucher Voucher?    @relation("OrderDiscountVoucher", fields: [discountVoucherId], references: [id])
  shippingVoucher Voucher?    @relation("OrderShippingVoucher", fields: [shippingVoucherId], references: [id])
   orderItems      OrderItem[]
  stockMovements  StockMovement[]

  @@index([customerId])
  @@index([discountVoucherId])
  @@index([shippingVoucherId])
  @@map("orders")
}

// ------------------------------------------------------------
// OrderItem
// ------------------------------------------------------------
model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int     @map("order_id")
  productId    Int     @map("product_id")
  quantity     Int
  priceAtOrder Decimal @map("price_at_order") @db.Decimal(12, 2) // giá "đóng băng" tại thời điểm đặt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ------------------------------------------------------------
// Review
// Chỉ tạo được nếu Customer có Order chứa product_id đó với
// status = completed — điều kiện này check ở tầng API,
// UNIQUE(productId, customerId) chặn trùng ở tầng DB.
// ------------------------------------------------------------

enum ReviewStatus {
  pending
  approved
  hidden
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  customerId Int      @map("customer_id")
  rating     Int      // 1-5, validate ở tầng API/zod
  comment    String?  @db.Text
  status     ReviewStatus @default(approved)
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([productId, customerId]) // 1 khách chỉ review 1 sản phẩm đúng 1 lần
  @@index([status])
  @@map("reviews")
}

// ------------------------------------------------------------
// Admin
// Seed sẵn 1 tài khoản (admin / Admin@123, bcryptjs cost 10)
// vì không có tính năng đăng ký cho Admin.
// ------------------------------------------------------------
model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique @db.VarChar(100)
  passwordHash String @map("password_hash") @db.VarChar(255)
    failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  auditLogs AuditLog[]

  @@map("admins")
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64) // SHA-256 của mã trong link, không lưu mã gốc
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at") // có giá trị = link đã dùng

  createdAt DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("password_reset_tokens")
}

// ------------------------------------------------------------
// StockMovement (lịch sử biến động tồn kho)
// change > 0: kho tăng (nhập hàng, hoàn kho), change < 0: kho giảm (bán ra)
// stockAfter = tồn kho của sản phẩm ngay sau lần thay đổi này
// orderId chỉ có khi lý do là sale hoặc cancel_restore
// ------------------------------------------------------------
enum StockMovementReason {
  import
  sale
  cancel_restore
  adjustment
}

model StockMovement {
  id         Int                 @id @default(autoincrement())
  productId  Int                 @map("product_id")
  orderId    Int?                @map("order_id")
  change     Int
  stockAfter Int                 @map("stock_after")
  reason     StockMovementReason
  note       String?             @db.VarChar(255)
  createdAt  DateTime            @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

// ------------------------------------------------------------
// AuditLog (nhật ký thao tác của Admin)
// action: mã hành động, ví dụ order.cancel, product.update, review.hide,
//         customer.lock, voucher.create...
// entityType + entityId: đối tượng bị tác động (order, product, customer, voucher, review)
// adminUsername lưu bản sao tên đăng nhập tại lúc thao tác
// summary: mô tả ngắn bằng tiếng Việt để hiển thị thẳng trên trang nhật ký
// ------------------------------------------------------------
model AuditLog {
  id            Int      @id @default(autoincrement())
  adminId       Int      @map("admin_id")
  adminUsername String   @map("admin_username") @db.VarChar(100)
  action        String   @db.VarChar(50)
  entityType    String   @map("entity_type") @db.VarChar(30)
  entityId      Int?     @map("entity_id")
  summary       String   @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ------------------------------------------------------------
// Wishlist (sản phẩm yêu thích của khách)
// Mỗi khách chỉ thích 1 sản phẩm đúng 1 lần (UNIQUE customerId + productId)
// Xóa khách thì xóa luôn danh sách yêu thích của khách đó
// ------------------------------------------------------------
model Wishlist {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  productId  Int      @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
  @@map("wishlists")
}

enum CustomRequestStatus {
  pending      // khách mới gửi, chờ Admin báo giá
  quoted       // Admin đã báo giá, chờ khách trả lời
  accepted     // khách đồng ý báo giá
  rejected     // Admin từ chối hoặc khách từ chối báo giá
  in_progress  // đang làm
  completed    // hoàn thành
  cancelled    // khách hủy
}

model CustomRequest {
  id                Int                 @id @default(autoincrement())
  customerId        Int                 @map("customer_id")
  title             String              @db.VarChar(255)
  description       String              @db.Text
  quantity          Int                 @default(1)
  budget            Decimal?            @db.Decimal(12, 2) // ngân sách dự kiến của khách (VND)
  referenceImageUrl String?             @map("reference_image_url") @db.VarChar(500)
  quotedPrice       Decimal?            @map("quoted_price") @db.Decimal(12, 2) // giá Admin báo (VND)
  adminNote         String?             @map("admin_note") @db.Text
  status            CustomRequestStatus @default(pending)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@map("custom_requests")
}